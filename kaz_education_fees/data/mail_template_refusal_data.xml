<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="email_template_refusal_notification_education_fees" model="mail.template">
        <field name="name">Refusal: Education Fees Request</field>
        <field name="model_id" ref="kaz_education_fees.model_education_fees"/>
        <field name="subject">Your request "{{ object.seq }}" has been refused</field>
        <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted or '') }}</field>
        <field name="partner_to">{{ object.employee_id.user_partner_id.id }}</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear<t t-out="object.employee_id.name or ''"/>,
        <br/>
        <br/>
        Your education fees request
        <strong>
            <t t-out="object.display_name or ''"/>
        </strong>
        has been <span style="color:red;">refused</span>.
        <br/>
        <br/>
        <strong>Reason:</strong>
        <blockquote>
            <t t-set="last_reason" t-value="object.refuse_reason_ids[-1:]"/>
            <t t-out="last_reason.reason or 'No reason provided.'"/>
            <t t-if="last_reason.refused_by_user_id">(by
                <t t-out="last_reason.refused_by_user_id.name"/>
                )
            </t>
        </blockquote>
        <br/>
        You can view your request <a t-att-href="object.get_record_url()">here</a>.
        <br/>
        <br/>
        Regards,
        <br/>
        <t t-out="user.name or 'Administrator'"/>
    </p>
</div>
        </field>
        <field name="auto_delete" eval="True"/>
    </record>
</odoo>
