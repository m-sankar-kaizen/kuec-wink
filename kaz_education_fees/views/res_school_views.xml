<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ===============================
         Form View: School Master
         Fields: Name, Country, City
         =============================== -->
    <record id="res_school_form_view" model="ir.ui.view">
        <field name="name">kaz.res_school.form</field>
        <field name="model">res.school</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <!-- School Name -->
                        <field name="name"/>
                        <!-- Country Selection -->
                        <field name="country_id"/>
                        <!-- State filtered by selected Country -->
                        <field name="state_id" domain="[('country_id', '=', country_id)]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===============================
         Tree View: School List
         Displays school name and country
         =============================== -->
    <record id="res_school_tree_view" model="ir.ui.view">
        <field name="name">kaz.res_school.list</field>
        <field name="model">res.school</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>

    <!-- ===============================
         Search View: School Filter
         Filters by school name
         =============================== -->
    <record id="res_school_search_view" model="ir.ui.view">
        <field name="name">kaz.res_school.search</field>
        <field name="model">res.school</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
            </search>
        </field>
    </record>

    <!-- ===============================
         Action Window: Open School View
         Launches form/list views of res.school
         =============================== -->
    <record id="res_school_act_window" model="ir.actions.act_window">
        <field name="name">School</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.school</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
