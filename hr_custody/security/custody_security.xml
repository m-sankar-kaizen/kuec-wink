<?xml version="1.0" ?>
<odoo>
<!-- Rules of Custody Management-->

    <record id="module_category_custody_parent" model="ir.module.category">
        <field name="name">KUEC Custody</field>
        <field name="sequence" eval="100"/>
        <field name="parent_id" eval="False"/>
    </record>

    <record id="module_category_custody" model="ir.module.category">
        <field name="name">KUEC Custody</field>
        <field name="sequence" eval="100"/>
        <field name="parent_id" eval="module_category_custody_parent"/>
    </record>

    <record id="group_kuec_custody_manager" model="res.groups">
        <field name="name">Custody Manager</field>
        <field name="category_id" ref="module_category_custody"/>
        <field name="comment">KUEC Group: Custody Management Manager can see all Custody Requests</field>
    </record>

    <record id="property_rule_custody" model="ir.rule">
        <field name="name">Custody Multi Company</field>
        <field name="model_id" ref="model_custody_property"/>
        <field eval="True" name="global"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>
    </record>
    <record id="property_rule_custody_req" model="ir.rule">
        <field name="name">Custody Request Multi Company</field>
        <field name="model_id" ref="model_hr_custody"/>
        <field eval="True" name="global"/>
        <field name="domain_force">['|',('company_id','=',False),('company_id','child_of',[user.company_id.id])]</field>
    </record>
    <record id="property_rule_custody_req_manager" model="ir.rule">
        <field name="name">Custody Request Manager</field>
        <field name="model_id" ref="hr_custody.model_hr_custody"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr_custody.group_kuec_custody_manager'))]"/>
    </record>
    <record id="property_rule_custody_req_user" model="ir.rule">
        <field name="name">Custody Request User</field>
        <field name="model_id" ref="hr_custody.model_hr_custody"/>
        <field name="domain_force">[('employee_id.user_id.id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
