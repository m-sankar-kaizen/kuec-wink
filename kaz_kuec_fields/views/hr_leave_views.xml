<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_leave_view_form" model="ir.ui.view">
        <field name="name">view_hr_leave_type_form_inherit_kuec</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='request_unit_half']" position="attributes">
                <attribute name="invisible">company_code == 'KUEC'</attribute>
            </xpath>
            <xpath expr="//group[@name='col_left']/label[@for='request_unit_half']" position="attributes">
                <attribute name="invisible">company_code == 'KUEC'</attribute>
            </xpath>
            <xpath expr="//group[@name='col_left']/div/label[@for='request_unit_half']" position="attributes">
                <attribute name="invisible">company_code == 'KUEC'</attribute>
            </xpath>
            <xpath expr="//field[@name='request_unit_half']" position="after">
                <field name="company_code" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>