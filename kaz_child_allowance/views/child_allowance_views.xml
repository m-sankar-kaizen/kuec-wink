<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ============================================================================
         FORM VIEW: Child Allowance Request
         This form view allows employees to create and track child allowance requests.
         The form supports a state-based workflow and conditional buttons depending
         on user group (employee, HR team, HR manager) and request state.
         ============================================================================ -->
    <record id="child_allowance_view_form" model="ir.ui.view">
        <field name="name">child.allowance.view.form</field>
        <field name="model">child.allowance</field>
        <field name="arch" type="xml">
            <form string="Child Allowance">

                <!-- ================= HEADER BUTTONS & STATUS ================== -->
                <header>
                    <!-- Employee can send request to HR Team -->
                    <button name="action_send_for_line_manager_approval"
                            string="Send To HR Team" type="object"
                            invisible="state != 'draft'"
                            class="btn-primary"/>

                    <!-- HR Team (Line Manager) can forward to HR Manager -->
                    <button name="action_send_for_hr_approval"
                            string="Send to Hr Manager" type="object"
                            invisible="state != 'line_manager_approval'"
                            class="btn-primary"
                            groups="kaz_child_allowance.group_line_manager"/>

                    <!-- HR Manager final approval -->
                    <button name="action_approve" string="Approve" type="object"
                            invisible="state != 'hr_approval'"
                            class="btn-primary"
                            groups="kaz_child_allowance.group_hr_person"/>

                    <!-- Rejection options for Line Manager & HR Manager -->
                    <button name="action_reject_line_manager" string="Reject"
                            type="object"
                            invisible="state != 'line_manager_approval'"
                            groups="kaz_child_allowance.group_line_manager"
                            class="btn-secondary"/>
                    <button name="action_reject_hr" string="Reject"
                            type="object"
                            invisible="state != 'hr_approval'"
                            groups="kaz_child_allowance.group_hr_person"
                            confirm="Are you sure you want to Reject?"
                            class="btn-secondary"/>

                    <!-- Cancel & Reset Options -->
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state == 'canceled'"
                            class="btn-secondary"/>
                    <button name="reset_draft" type="object"
                            string="Reset to Draft"
                            invisible="state != 'canceled'"/>

                    <!-- Visual State Bar -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,line_manager_approval,hr_approval,approved,rejected"/>
                </header>

                <!-- ================= FORM BODY ================== -->
                <sheet>
                    <!-- Ribbon shows 'Paid' when paid -->
                    <widget name="web_ribbon" title="Paid" invisible="not paid"/>
                    <field name="paid" invisible="1"/>

                    <div class="oe_title">
                        <h1>
                            <!-- Editable for HR users -->
                            <field name="employee_id"
                                   groups="kaz_acting_allowance.group_line_manager,kaz_child_allowance.group_hr_person"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   readonly="state != 'draft'"/>
                            <!-- Readonly for base users -->
                            <field name="employee_id"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   groups="kaz_child_allowance.group_base_user,!kaz_child_allowance.group_line_manager,!kaz_child_allowance.group_hr_person"
                                   readonly="1"/>
                        </h1>
                    </div>

                    <!-- ================= BASIC INFO FIELDS ================== -->
                    <group>
                        <group>
                            <field name="company_id" options="{'no_open': True}"/>
                            <field name="grade_id" options="{'no_open': True}"/>
                            <field name="kaz_employee_type"/>
                            <field name="country_id" readonly="state != 'draft'"
                                   options="{'no_open': True}"/>
                            <field name="date" readonly="1"/>
                        </group>
                    </group>

                    <!-- ================= NOTEBOOK: CHILDREN & DOCUMENTS ================== -->
                    <notebook>
                        <!-- Children Tab -->
                        <page string="Children">
                            <field name="kid_ids" required="1"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="kids_id" required="1" string="Child"
                                           readonly="state != 'draft'"
                                           context="{'default_parent_id': employee_id}"
                                           options="{'no_open': True}"/>
                                    <field name="age" string="Birth Date" required="1"
                                           readonly="state != 'draft'"/>
                                    <field name="country_id" string="Birth Country" required="1"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                           readonly="state != 'draft'"/>
                                    <field name="employee_id" invisible="1"/>
                                    <field name="child_allowance_id" invisible="1"/>
                                    <field name="state" invisible="1"/>
                                    <field name="is_eligible" optional="hide" readonly="1"/>
                                </list>
                            </field>
                        </page>

                        <!-- Supporting Documents Tab -->
                        <page string="Supporting Documents">
                            <field name="supporting_document_ids"
                                   readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="name" required="1"/>
                                    <field name="kid_id" required="1" string="Child"
                                           options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                                    <field name="employee_id" invisible="1"/>
                                    <field name="attachment" widget="attachment" required="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <!-- ================= CHATTER ================== -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================================================
         TREE VIEW: List of Child Allowance Records
         Shows key information with dynamic state badge coloring
         ============================================================================ -->
    <record id="child_allowance_view_tree" model="ir.ui.view">
        <field name="name">child.allowance.view.list</field>
        <field name="model">child.allowance</field>
        <field name="arch" type="xml">
            <list>
                <field name="employee_id"/>
                <field name="grade_id"/>
                <field name="country_id"/>
                <field name="date"/>
                <field name="state" widget="badge"
                       decoration-muted="state == 'draft' or state == 'canceled'"
                       decoration-info="state == 'line_manager_approval' or state == 'hr_approval'"
                       decoration-danger="state == 'rejected'"
                       decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <!-- ============================================================================
         SEARCH VIEW: Search Filter for Child Allowance
         Supports basic filters and grouping (state, employee)
         ============================================================================ -->
    <record id="child_allowance_view_search" model="ir.ui.view">
        <field name="name">child.allowance.view.search</field>
        <field name="model">child.allowance</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="state"/>
                <group expand="1" string="Group By">
                    <filter string="State" name="state" context="{'group_by': 'state'}"/>
                    <filter string="Employee" name="employee_id" context="{'group_by': 'employee_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ============================================================================
         ACTION WINDOW: Opens Tree/Form View for Child Allowance
         Connected to menu item.
         ============================================================================ -->
    <record id="action_child_allowance" model="ir.actions.act_window">
        <field name="name">Child Allowance</field>
        <field name="res_model">child.allowance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_no content_create">
                No Child Allowance Requests.
            </p>
        </field>
    </record>

    <!-- ============================================================================
         MENU ITEM: Access to Child Allowance Feature
         Appears under an existing HR or Housing menu (ent_ohrms_loan)
         Visible only to users with Base User group access
         ============================================================================ -->
    <menuitem name="Child Allowance"
              id="menu_child_allowance"
              action="action_child_allowance"
              parent="ent_ohrms_loan.menu_hr_housing_advance"
              groups="kaz_child_allowance.group_base_user"
              sequence="20"/>
</odoo>
