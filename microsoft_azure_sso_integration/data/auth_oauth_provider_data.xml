<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        OAuth Provider Configuration: Microsoft

        This record defines an OAuth provider for Microsoft Azure Active Directory login.
        It enables users to authenticate in Odoo using their Microsoft accounts via the OAuth 2.0 protocol.

        Model: auth.oauth.provider
    -->

    <record id="provider_microsoft" model="auth.oauth.provider">
        <field name="name">Microsoft</field>
        <field name="auth_endpoint">https://login.microsoftonline.com/common/oauth2/v2.0/authorize</field>
        <field name="scope">openid email profile</field>
        <field name="validation_endpoint">https://login.microsoftonline.com/common/oauth2/v2.0/token</field>
        <field name="css_class">fa fa-fw fa-windows</field>
        <field name="body">Log in with Microsoft</field>
        <field name="response_type">code</field>
        <field name="data_endpoint">https://graph.microsoft.com</field>
    </record>
</odoo>
