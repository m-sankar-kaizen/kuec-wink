<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit Employee Public Form View: Add Arabic fields for public-facing model -->
    <record id="view_employee_public_form" model="ir.ui.view">
        <field name="name">hr.employee.public</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_form"/>
        <field name="arch" type="xml">

            <!-- Insert Arabic fields before department field in public profile view -->
            <xpath expr="//field[@name='department_id']" position="before">
                <field name="employee_arabic_name"/>
                <field name="employee_arabic_job_position"/>
                <field name="employee_arabic_department"/>
            </xpath>

        </field>
    </record>

</odoo>