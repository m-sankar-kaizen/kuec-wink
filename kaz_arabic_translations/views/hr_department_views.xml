<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit Department Form View: Add Arabic translation for department name -->
    <record id="view_department_form" model="ir.ui.view">
        <field name="name">hr.department.view.form.inherit.translation</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <!-- Insert Arabic department name after the original name field -->
            <xpath expr="//field[@name='manager_id']" position="before">
                <field name="employee_arabic_department"/>
            </xpath>
        </field>
    </record>
</odoo>
