<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Inherit Employee Form View: Add Arabic fields for name, job position, department, and nationality -->
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <!-- Insert Arabic name, job position, and department before the original department field -->
            <xpath expr="//field[@name='department_id']" position="before">
                <field name="employee_arabic_name"/>
            </xpath>

            <field name="job_id" position="after">
                <field name="employee_arabic_job_position" readonly="1"/>
            </field>

            <field name="department_id" position="after">
                <field name="employee_arabic_department" readonly="1"/>
            </field>

            <!-- Insert Arabic nationality after the country field -->
            <xpath expr="//field[@name='country_id']" position="after">
                <field name="employee_arabic_nationality"/>
            </xpath>

        </field>
    </record>
</odoo>