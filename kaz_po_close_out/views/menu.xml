<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="action_generate_incomplete_po_pdf" model="ir.actions.report">
        <field name="name">Incomplete PO</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">kaz_po_close_out.incomplete_po_report</field>
        <field name="report_file">kaz_po_close_out.incomplete_po_report</field>
        <field name="print_report_name">'Incomplete Po Report - %s' % (context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d'))</field>
    </record>

    <record id="purchase_incomplete" model="ir.actions.act_window">
            <field name="name">Incomplete PO</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">purchase.order</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('state', 'not in', ['done', 'purchase', 'cancel'])]</field>
            <field name="context">{'create': False, 'edit': False, 'delete': False}</field>
        </record>

    <menuitem id="menu_purchase_incomplete_pdf_report"
              name="Incomplete PO Report (PDF)"
              parent="purchase.purchase_report_main"
              action="action_generate_incomplete_po_pdf"
              sequence="100"/>

    <menuitem id="menu_incomplete_purchase_orders"
              name="Incomplete PO"
              parent="purchase.menu_procurement_management"
              action="purchase_incomplete"
              sequence="10"/>
</odoo>