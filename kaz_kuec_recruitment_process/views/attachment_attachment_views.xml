<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_attachment_list" model="ir.ui.view">
        <field name="name">view.attachment.list.inherit.recruitment</field>
        <field name="model">attachment.attachment</field>
        <field name="inherit_id" ref="kaz_contact_approval.view_attachment_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_customer']" position="after">
                <field name="is_external_recruiter"
                       widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

    <record id="view_attachment_form" model="ir.ui.view">
        <field name="name">view.attachment.form.inherit.recruitment</field>
        <field name="model">attachment.attachment</field>
        <field name="inherit_id" ref="kaz_contact_approval.view_attachment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='is_customer']" position="after">
                <field name="is_external_recruiter"
                       widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>

</odoo>