<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.kaz.leave.entitlement.kuec</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="gender" position="after">
                <field name="religion_id" widget="selection" invisible="company_code not in ['KUEC']"/>
                <field name="sub_religion_id" widget="selection" invisible="company_code not in ['KUEC']"/>
                <field name="company_code" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>
