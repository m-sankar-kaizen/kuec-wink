<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_religion_list" model="ir.ui.view">
        <field name="name">hr.religion.list</field>
        <field name="model">hr.religion</field>
        <field name="arch" type="xml">
            <list string="Religions">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_hr_religion_form" model="ir.ui.view">
        <field name="name">hr.religion.form</field>
        <field name="model">hr.religion</field>
        <field name="arch" type="xml">
            <form string="Religion">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page name="sub_religion" string="Sects">
                            <field name="sub_religion_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name" required="1"/>
                                    <field name="company_id" optional="hide" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hr_religion" model="ir.actions.act_window">
        <field name="name">Religions</field>
        <field name="res_model">hr.religion</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Religion records for your company.
            </p>
        </field>
    </record>

    <menuitem id="menu_hr_religion_root" name="Religions" parent="hr_holidays.menu_hr_holidays_configuration"
              action="action_hr_religion"/>

</odoo>