<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
        Inherit the HR Contract Form view to:
        1. Add a new field "other_allowances" inside the salary group.
        2. Add a new group before the notebook for 'ku_hire_date'.
        3. Add a new tab called "Housing Advance" for loan-related info.
    -->
    <record id="contract_form_inherit" model="ir.ui.view">
        <field name="name">hr.contract.form.inherit.wps</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">

            <!-- Insert other_allowances field inside the salary group -->
            <xpath expr="//group[@name='salary']" position="inside">
                <field name="other_allowances"/>
            </xpath>

            <!-- Add ku_hire_date field before the notebook section -->
            <xpath expr="//notebook" position="before">
                <group>
                    <group>
                        <field name="ku_hire_date"/>
                    </group>
                </group>
            </xpath>

            <!-- Add a new page/tab inside the notebook for Housing Advance info -->
            <xpath expr="//notebook" position="inside">
                <page string="Housing Advance" name="housing_advance">
                    <group>
                        <group>
                            <field name="person_extra_info"/>
                            <field name="assignment_category_id"/>
                            <field name="reference"/>
                        </group>
                        <group>
                            <field name="loan_amount"/>
                            <field name="installment"/>
                            <field name="creation_date"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
