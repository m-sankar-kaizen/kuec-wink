<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="petty_cash_pdf_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h3 class="text-center">
                        <strong>
                        Petty Cash Report
                        </strong>
                    </h3>

                    <p>
                        <strong>Date From:</strong>
                        <span t-esc="date_from or '-'"/>
                        <strong>Date To:</strong>
                        <span t-esc="date_to or '-'"/>
                    </p>

                    <table class="table table-sm table-bordered o_main_table mt16">
                        <thead>
                            <tr>
                                <th>Requester</th>
                                <th>Total Cash Transferred In</th>
                                <th>Total Cash Transferred Out</th>
                                <th>Cash on Hand</th>
                                <th>Total Unsettled Spend</th>
                                <th>Total Spend (Settled)</th>
                                <th>Annual Limit</th>
                                <th>Annual Remaining Allowance</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="data" t-as="line">
                                <tr>
                                    <td t-esc="line['employee']"/>
                                    <td t-esc="line['total_cash_in']"/>
                                    <td t-esc="line['transferred_out']"/>
                                    <td t-esc="line['cash_in_hand']"/>
                                    <td t-esc="line['total_spend_settled']"/>
                                    <td t-esc="line['total_unsettled_spend']"/>
                                    <td t-esc="line['annual_limit']"/>
                                    <td t-esc="line['remaining_balance']"/>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_petty_cash_pdf_report" model="ir.actions.report">
        <field name="name">Petty Cash Report</field>
        <field name="model">petty.cash.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">kaz_kuec_petty_cash_reports.petty_cash_pdf_template</field>
        <field name="report_file">kaz_kuec_petty_cash_reports.petty_cash_pdf_template</field>
        <field name="print_report_name">'Petty Cash Report - %s' % (context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d'))</field>
    </record>

</odoo>