<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Financial Award Sequence -->
    <record id="seq_financial_award" model="ir.sequence">
        <field name="name">Financial Award Sequence</field>
        <field name="code">financial.award</field>
        <field name="prefix">AWARD/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <!-- Annual Bonus Sequence -->
    <record id="seq_annual_bonus" model="ir.sequence">
        <field name="name">Annual Bonus Sequence</field>
        <field name="code">annual.bonus</field>
        <field name="prefix">BONUS/%(year)s/</field>
        <field name="padding">5</field>
    </record>

    <!-- Annual Bonus Payment Sequence -->
    <record id="seq_annual_bonus_payment" model="ir.sequence">
        <field name="name">Annual Bonus Payment Sequence</field>
        <field name="code">annual.bonus.payment</field>
        <field name="prefix">BONUS-PAY/%(year)s/</field>
        <field name="padding">5</field>
    </record>
</odoo>
