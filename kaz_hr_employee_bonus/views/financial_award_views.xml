<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Financial Award Actions -->
        <record id="action_financial_award" model="ir.actions.act_window">
            <field name="name">Financial Awards</field>
            <field name="res_model">financial.award</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p>Create and manage one-time financial awards for exceptional performance.</p>
            </field>
        </record>

        <!-- Financial Award List View -->
        <record id="view_financial_award_list" model="ir.ui.view">
            <field name="name">financial.award.list</field>
            <field name="model">financial.award</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="award_type" widget="badge"/>
                    <field name="basic_salary"/>
                    <field name="award_amount"/>
                    <field name="award_year"/>
                    <field name="currency_id" optional="hide"/>
                    <field name="state" widget="badge"/>
                </list>
            </field>
        </record>

        <!-- Financial Award Form View -->
        <record id="view_financial_award_form" model="ir.ui.view">
            <field name="name">financial.award.form</field>
            <field name="model">financial.award</field>
            <field name="arch" type="xml">
                <form string="Financial Award">
                    <header>
                        <button name="action_submit_for_hr_approval" type="object" string="Submit for HR Approval"
                                class="btn-primary" invisible="state != 'draft'"/>

                        <button name="action_hr_manager_approve" groups="kaz_kuec_overall_doa_approval.group_kuec_employee_hohr"
                                type="object"
                                string="HR Manager Approve" class="btn-primary" invisible="state != 'pending'"/>
                        <button name="action_reject_request"
                                invisible="state != 'pending'"
                                groups="kaz_kuec_overall_doa_approval.group_kuec_employee_hohr"
                                class="btn btn-danger" string="Reject" type="object"/>
                        <button name="action_rfc_request"
                                invisible="state != 'pending'"
                                groups="kaz_kuec_overall_doa_approval.group_kuec_employee_hohr"
                                class="btn" string="Return for Correction" type="object"/>

                        <button name="action_ccoe_approve" groups="kaz_procurement_doa_kuec.group_kuec_ccoe"
                                type="object" string="CCOE Approve" class="btn-primary"
                                invisible="state != 'hr_approved'"/>
                        <button name="action_reject_request"
                                invisible="state != 'hr_approved'"
                                groups="kaz_procurement_doa_kuec.group_kuec_ccoe"
                                class="btn btn-danger" string="Reject" type="object"/>
                        <button name="action_rfc_request"
                                invisible="state != 'hr_approved'"
                                groups="kaz_procurement_doa_kuec.group_kuec_ccoe"
                                class="btn" string="Return for Correction" type="object"/>

                        <button name="action_ceo_approve" groups="kaz_procurement_doa_kuec.group_kuec_ceo" type="object"
                                string="CEO Approve" class="btn-primary" invisible="state != 'ccoe_approved'"/>
                        <button name="action_reject_request"
                                invisible="state != 'ccoe_approved'"
                                groups="kaz_procurement_doa_kuec.group_kuec_ceo"
                                class="btn btn-danger" string="Reject" type="object"/>
                        <button name="action_rfc_request"
                                invisible="state != 'ccoe_approved'"
                                groups="kaz_procurement_doa_kuec.group_kuec_ceo"
                                class="btn" string="Return for Correction" type="object"/>

                        <button name="action_mark_as_paid" type="object" string="Mark as Paid" class="btn-success"
                                invisible="state != 'ceo_approved'"/>

                        <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                                invisible="state != 'rejected'"
                                groups="kaz_kuec_overall_doa_approval.group_kuec_employee_hohr"/>

                        <field name="state" widget="statusbar"
                               statusbar_visible="draft,pending,hr_approved,ccoe_approved,ceo_approved,paid"/>
                    </header>
                    <sheet>
                        <widget name="web_ribbon" title="Paid" bg_color="text-bg-success" invisible="state != 'paid'"/>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group string="Employee Information">
                                <field name="employee_id" readonly="state != 'draft'"/>
                                <field name="department_id" readonly="1"/>
                                <field name="job_id" readonly="1"/>
                            </group>
                            <group string="Financial Details">
                                <field name="company_id" readonly="1"/>
                                <field name="currency_id" readonly="1"/>
                                <field name="award_year" readonly="state != 'draft'"/>
                                <field name="basic_salary" readonly="1"/>
                                <field name="max_award_amount" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <group string="Award Details">
                                <field name="award_type" readonly="state != 'draft'"/>
                                <field name="award_amount" readonly="state != 'draft'"/>
                                <field name="reason" readonly="state != 'draft'"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="award_approval" string="Signed Approval History"
                                  invisible="not award_approval_ids">
                                <field name="award_approval_ids">
                                    <list editable="bottom" create="0" edit="0" delete="0">
                                        <field name="current_display_name" column_invisible="1"/>
                                        <field name="sequence"/>
                                        <field name="parent_state_at_request" optional="show"/>
                                        <field name="request_type"/>
                                        <field name="create_uid" string="Signed By"/>
                                        <field name="create_date" string="Signed At" optional="hide"/>
                                        <field name="signature" widget="signature"
                                               options="{'full_name': 'current_display_name','size': [150, 50]}"/>
                                        <field name="reason"/>
                                        <field name="company_id" optional="hide"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <!-- Financial Award Search View -->
        <record id="view_financial_award_search" model="ir.ui.view">
            <field name="name">financial.award.search</field>
            <field name="model">financial.award</field>
            <field name="arch" type="xml">
                <search string="Financial Awards">
                    <field name="name" string="Reference"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <separator/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="HR Approved" name="hr_approved" domain="[('state', '=', 'hr_approved')]"/>
                    <filter string="CEO Approved" name="ceo_approved" domain="[('state', '=', 'ceo_approved')]"/>
                    <filter string="Paid" name="paid" domain="[('state', '=', 'paid')]"/>
                    <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                    <separator/>
                    <filter string="Performance" name="performance" domain="[('award_type', '=', 'performance')]"/>
                    <filter string="Loyalty" name="loyalty" domain="[('award_type', '=', 'loyalty')]"/>
                    <filter string="Special Recognition" name="special" domain="[('award_type', '=', 'special')]"/>
                    <group expand="1" string="Group By">
                        <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                        <filter name="group_award_type" string="Award Type" context="{'group_by': 'award_type'}"/>
                        <filter name="group_year" string="Award Year" context="{'group_by': 'award_year'}"/>
                    </group>
                </search>
            </field>
        </record>

    </data>
</odoo>
