<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_evaluation_category_form" model="ir.ui.view">
        <field name="name">evaluation.category.form</field>
        <field name="model">evaluation.category</field>
        <field name="arch" type="xml">
            <form string="Evaluation Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_evaluation_category_list" model="ir.ui.view">
        <field name="name">evaluation.category.list</field>
        <field name="model">evaluation.category</field>
        <field name="arch" type="xml">
            <list string="Evaluation Categories">
                <field name="name"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_evaluation_category_search" model="ir.ui.view">
        <field name="name">evaluation.category.search</field>
        <field name="model">evaluation.category</field>
        <field name="arch" type="xml">
            <search string="Evaluation Categories">
                <field name="name"/>
                <field name="company_id"/>
            </search>
        </field>
    </record>

    <record id="action_evaluation_category" model="ir.actions.act_window">
        <field name="name">Evaluation Categories</field>
        <field name="res_model">evaluation.category</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_evaluation_category_search"/>
    </record>

    <menuitem id="menu_evaluation_category"
              name="Evaluation Categories"
              parent="kaz_employee_performance_kuec.menu_performance_evaluation_conf"
              action="action_evaluation_category"
              sequence="2"/>


</odoo>