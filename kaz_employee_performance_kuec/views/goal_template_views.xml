<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_goal_template_form" model="ir.ui.view">
        <field name="name">goal.template.form</field>
        <field name="model">goal.template</field>
        <field name="arch" type="xml">
            <form string="Goal Template">
                <header>
                    <button name="action_activate"
                            groups="!kaz_employee_performance_kuec.group_kuec_performance_eval_user"
                            invisible="state != 'draft'"
                            class="btn btn-primary" string="Activate" type="object"/>
                    <button name="action_reset"
                            groups="!kaz_employee_performance_kuec.group_kuec_performance_eval_user"
                            invisible="state != 'active'"
                            class="btn" string="Reset to Draft" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_weight"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Goal Lines">
                            <field name="goal_template_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="evaluation_category_id" required="1"/>
                                    <field name="description" required="1"/>
                                    <field name="weight" required="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_goal_template_list" model="ir.ui.view">
        <field name="name">goal.template.list</field>
        <field name="model">goal.template</field>
        <field name="arch" type="xml">
            <list string="Goal Templates">
                <field name="name"/>
                <field name="company_id"/>
                <field name="state"/>
                <field name="total_weight"/>
            </list>
        </field>
    </record>

    <!-- ========================= Goal Template Search View ========================= -->
    <record id="view_goal_template_search" model="ir.ui.view">
        <field name="name">goal.template.search</field>
        <field name="model">goal.template</field>
        <field name="arch" type="xml">
            <search string="Goal Templates">
                <field name="name"/>
                <field name="company_id"/>
                <field name="state"/>
                <field name="total_weight"/>
            </search>
        </field>
    </record>

    <record id="action_goal_template" model="ir.actions.act_window">
        <field name="name">Goal Templates</field>
        <field name="res_model">goal.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_goal_template_search"/>
    </record>

    <menuitem id="menu_goal_template"
              name="Goal Templates"
              parent="kaz_employee_performance_kuec.menu_performance_evaluation_conf"
              action="action_goal_template"
              sequence="4"/>

</odoo>