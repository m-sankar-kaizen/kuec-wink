<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_evaluation_method_form" model="ir.ui.view">
        <field name="name">evaluation.method.form</field>
        <field name="model">evaluation.method</field>
        <field name="arch" type="xml">
            <form string="Evaluation Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_evaluation_method_list" model="ir.ui.view">
        <field name="name">evaluation.method.list</field>
        <field name="model">evaluation.method</field>
        <field name="arch" type="xml">
            <list string="Evaluation Methods">
                <field name="name"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_evaluation_method_search" model="ir.ui.view">
        <field name="name">evaluation.method.search</field>
        <field name="model">evaluation.method</field>
        <field name="arch" type="xml">
            <search string="Evaluation Methods">
                <field name="name"/>
                <field name="company_id"/>
            </search>
        </field>
    </record>

    <record id="action_evaluation_method" model="ir.actions.act_window">
        <field name="name">Evaluation Methods</field>
        <field name="res_model">evaluation.method</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_evaluation_method_search"/>
    </record>

    <menuitem id="menu_evaluation_method"
              name="Evaluation Methods"
              parent="kaz_employee_performance_kuec.menu_performance_evaluation_conf"
              action="action_evaluation_method"
              sequence="3"/>


</odoo>