<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        Inherit the existing hr.leave.type form view to add the custom
        field 'day_calculation_type' after the standard 'leave_validation_type' field.

        This allows users to select how leave days are calculated:
        either as working days or calendar days.

        Record:
            id: view_hr_leave_type_form_inherit
            model: ir.ui.view
            inherits: hr_holidays.edit_holiday_status_form (the original hr.leave.type form)

        XPath:
            Insert <field name="day_calculation_type"/> immediately after
            the <field name="leave_validation_type"/> field in the form.
    -->
    <record id="view_hr_leave_type_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.type.form.inherit</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='leave_validation_type']" position="after">
                <field name="day_calculation_type"/>
            </xpath>
        </field>
    </record>
</odoo>
