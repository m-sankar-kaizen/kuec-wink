<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_form_kuec_plan_change" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.kuec.plan.change</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <!-- Depending on Odoo 18 subscription module status, we place custom actions here. -->
                <!-- Upgrade -->
                <button name="%(action_kuec_plan_change_wizard)d"
                        string="Upgrade Plan"
                        type="action"
                        context="{'default_change_type': 'upgrade'}"
                        groups="kuec_portal_foundation.group_kuec_coordinator,base.group_system"
                        invisible="not is_subscription or state not in ['sale', 'done']"/>

                <!-- Downgrade -->
                <button name="%(action_kuec_plan_change_wizard)d"
                        string="Downgrade Plan"
                        type="action"
                        context="{'default_change_type': 'downgrade'}"
                        groups="kuec_portal_foundation.group_kuec_coordinator,base.group_system"
                        invisible="not is_subscription or state not in ['sale', 'done']"/>

                <!-- Cancel with Refund -->
                <button name="%(action_kuec_plan_change_wizard)d"
                        string="Cancel &amp; Refund"
                        type="action"
                        context="{'default_change_type': 'cancel'}"
                        groups="kuec_portal_foundation.group_kuec_coordinator,base.group_system"
                        class="btn-danger"
                        invisible="not is_subscription or state not in ['sale', 'done']"/>
                <button name="action_kuec_finalize_price" 
                        string="Finalize &amp; Unlock Payment" 
                        type="object" 
                        class="btn-primary" 
                        groups="kuec_portal_foundation.group_kuec_coordinator,base.group_system"
                        invisible="state not in ['draft', 'sent'] or wink_price_confirmed"/>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="wink_price_confirmed" readonly="1" invisible="not wink_price_confirmed"/>
                <field name="wink_is_portal_request" invisible="1"/>
                <field name="wink_source_product_id" readonly="1" invisible="not wink_is_portal_request"/>
                <field name="wink_requested_start_date" readonly="1" invisible="not wink_is_portal_request"/>
                <field name="wink_selected_employee_ids" widget="many2many_tags" readonly="1" invisible="not wink_is_portal_request"/>
                <field name="wink_request_notes" readonly="1" invisible="not wink_is_portal_request"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Compliance Documents" name="compliance_docs"
                      invisible="not wink_is_portal_request">
                    <field name="document_submission_ids">
                        <list string="Documents" editable="bottom">
                            <field name="requirement_name" readonly="1"/>
                            <field name="attachment_id" column_invisible="True"/>
                            <field name="filename" readonly="1"/>
                            <field name="state" readonly="1"
                                   decoration-success="state == 'approved'"
                                   decoration-info="state == 'under_review'"
                                   decoration-warning="state == 'change_required'"
                                   decoration-danger="state == 'rejected'"/>
                            <field name="submitted_date" readonly="1"/>
                            <field name="reviewed_by" readonly="1"/>
                            <field name="coordinator_notes"/>
                            <button name="action_view_attachment" string="View" type="object"
                                    icon="fa-eye" invisible="not attachment_id" class="btn-secondary"/>
                            <button name="action_download_attachment" string="Download" type="object"
                                    icon="fa-download" invisible="not attachment_id" class="btn-primary"/>
                            <button name="action_approve" string="Approve" type="object"
                                    icon="fa-check" invisible="state != 'under_review'" class="btn-success"/>
                            <button name="action_request_change" string="Change" type="object"
                                    icon="fa-refresh" invisible="state != 'under_review'" class="btn-warning"/>
                            <button name="action_reject" string="Reject" type="object"
                                    icon="fa-times" invisible="state != 'under_review'" class="btn-danger"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
