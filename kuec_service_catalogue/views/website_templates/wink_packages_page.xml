<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="wink_packages_page" name="WINK Packages Listing">
        <t t-call="website.layout">
            <div class="container mt-5 mb-5">

                <!-- Breadcrumbs -->
                <nav aria-label="breadcrumb" class="mb-4">
                    <ol class="breadcrumb bg-transparent p-0">
                        <li class="breadcrumb-item"><a href="/services">Service Catalogue</a></li>
                        <li class="breadcrumb-item active" aria-current="page">Packages</li>
                    </ol>
                </nav>

                <!-- Header -->
                <div class="mb-5">
                    <h2 class="fw-bold mb-1" style="color:var(--wink-primary);">
                        <i class="fa fa-th-large me-2"/>Service Packages
                    </h2>
                    <p class="text-muted">
                        Choose the package that fits your business needs. Each package includes a set of services bundled at a fixed monthly rate.
                    </p>
                </div>

                <!-- Packages list -->
                <t t-if="bundles">
                    <t t-foreach="bundles" t-as="bundle">
                        <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">

                            <!-- Bundle header bar -->
                            <div class="card-header border-0 py-3 px-4 d-flex align-items-center justify-content-between flex-wrap gap-2"
                                 style="background:var(--wink-primary);color:#fff;">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                                         style="width:40px;height:40px;background:rgba(255,255,255,0.15);">
                                        <i class="fa fa-th-large"/>
                                    </div>
                                    <div>
                                        <div class="fw-bold fs-5"><t t-esc="bundle.name"/></div>
                                        <t t-if="bundle.department_ids">
                                            <div class="opacity-75 small">
                                                <t t-foreach="bundle.department_ids" t-as="dept">
                                                    <span><t t-esc="dept.name"/><t t-if="not dept_last"> · </t></span>
                                                </t>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                                <a t-attf-href="/my/requests/new?product_id=#{bundle.id}"
                                   class="btn btn-light fw-semibold rounded-pill px-4">
                                    Select Package <i class="fa fa-arrow-right ms-1"/>
                                </a>
                            </div>

                            <div class="card-body p-4">

                                <!-- Description -->
                                <t t-if="bundle.wink_description">
                                    <p class="text-muted mb-4" style="font-size:0.92rem;">
                                        <t t-esc="bundle.wink_description"/>
                                    </p>
                                </t>

                                <!-- Tiers -->
                                <t t-if="bundle.wink_bundle_id and bundle.wink_bundle_id.tier_ids">
                                    <p class="text-muted fw-semibold mb-3"
                                       style="font-size:0.75rem;text-transform:uppercase;letter-spacing:0.6px;">
                                        Available Tiers
                                    </p>
                                    <div class="row g-3">
                                        <t t-foreach="bundle.wink_bundle_id.tier_ids.sorted('sequence')" t-as="tier">
                                            <div class="col-12 col-sm-6 col-md-4">
                                                <div t-attf-class="h-100 p-3 rounded-3 border #{'border-primary shadow-sm' if tier.is_most_popular else ''}"
                                                     style="background:#f8f9fa;position:relative;">
                                                    <!-- Most Popular badge -->
                                                    <t t-if="tier.is_most_popular">
                                                        <span class="badge rounded-pill px-2 py-1 mb-2 d-inline-block"
                                                              style="background:var(--wink-primary);font-size:0.65rem;">
                                                            <i class="fa fa-star me-1"/>Most Popular
                                                        </span>
                                                    </t>
                                                    <div class="fw-bold mb-1" style="font-size:0.95rem;">
                                                        <t t-esc="tier.name"/>
                                                    </div>
                                                    <t t-if="tier.price_monthly">
                                                        <div class="fw-bold" style="color:var(--wink-primary);font-size:1.1rem;">
                                                            <t t-esc="'%.0f' % tier.price_monthly"/> AED
                                                            <span class="text-muted fw-normal" style="font-size:0.75rem;">/ month</span>
                                                        </div>
                                                    </t>
                                                    <t t-else="">
                                                        <div class="text-muted fst-italic" style="font-size:0.82rem;">Contact us for pricing</div>
                                                    </t>
                                                    <t t-if="tier.item_count">
                                                        <div class="text-muted mt-1" style="font-size:0.78rem;">
                                                            <i class="fa fa-check-circle text-success me-1"/>
                                                            <t t-esc="tier.item_count"/> service<t t-if="tier.item_count != 1">s</t> included
                                                        </div>
                                                    </t>
                                                </div>
                                            </div>
                                        </t>
                                    </div>
                                </t>

                            </div><!-- /card-body -->
                        </div><!-- /card -->
                    </t>
                </t>

                <!-- Empty state -->
                <t t-else="">
                    <div class="text-center py-5 text-muted">
                        <i class="fa fa-th-large fa-3x mb-3 opacity-25"/>
                        <p class="fw-semibold">No packages are currently available.</p>
                        <a href="/services" class="btn btn-outline-primary rounded-pill px-4 mt-2">
                            <i class="fa fa-arrow-left me-1"/>Browse All Services
                        </a>
                    </div>
                </t>

            </div>
        </t>
    </template>
</odoo>
