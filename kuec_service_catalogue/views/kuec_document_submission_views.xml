<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="kuec_document_submission_view_form" model="ir.ui.view">
        <field name="name">kuec.document.submission.view.form</field>
        <field name="model">kuec.document.submission</field>
        <field name="arch" type="xml">
            <form string="Document Submission">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="draft,under_review,approved"/>
                    <button name="action_view_attachment" string="View File" type="object"
                            icon="fa-eye" invisible="not attachment_id" class="btn-secondary"/>
                    <button name="action_download_attachment" string="Download File" type="object"
                            icon="fa-download" invisible="not attachment_id" class="btn-primary"/>
                    <button name="action_approve"
                            string="✓ Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'under_review'"
                            groups="kuec_portal_foundation.group_kuec_coordinator"/>
                    <button name="action_request_change"
                            string="↩ Request Change"
                            type="object"
                            class="btn-warning"
                            invisible="state != 'under_review'"
                            groups="kuec_portal_foundation.group_kuec_coordinator"/>
                    <button name="action_reject"
                            string="✗ Reject"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'under_review'"
                            groups="kuec_portal_foundation.group_kuec_coordinator"/>
                </header>
                <sheet>
                    <group>
                        <group string="Document Info">
                            <field name="requirement_name" readonly="1"/>
                            <field name="requirement_id" readonly="1"/>
                            <field name="is_required" readonly="1"/>
                            <field name="order_id" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group string="File &amp; Status">
                            <field name="attachment_id" readonly="1"/>
                            <field name="filename" readonly="1"/>
                            <field name="submitted_date" readonly="1"/>
                            <field name="reviewed_date" readonly="1"/>
                            <field name="reviewed_by" readonly="1"/>
                        </group>
                    </group>
                    <group string="Coordinator Notes">
                        <field name="coordinator_notes" nolabel="1"
                               placeholder="Add notes for the customer (required for Change Required / Reject)..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="kuec_document_submission_view_list" model="ir.ui.view">
        <field name="name">kuec.document.submission.view.list</field>
        <field name="model">kuec.document.submission</field>
        <field name="arch" type="xml">
            <list string="Document Submissions"
                  decoration-success="state == 'approved'"
                  decoration-info="state == 'under_review'"
                  decoration-warning="state == 'change_required'"
                  decoration-danger="state == 'rejected'"
                  decoration-muted="state == 'draft'">
                <field name="requirement_name"/>
                <field name="order_id"/>
                <field name="partner_id"/>
                <field name="state"/>
                <field name="submitted_date"/>
                <field name="reviewed_by"/>
                <field name="filename"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_kuec_document_submissions" model="ir.actions.act_window">
        <field name="name">Document Submissions</field>
        <field name="res_model">kuec.document.submission</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No document submissions yet.
            </p>
            <p>Customers upload compliance documents via the WINK portal.</p>
        </field>
    </record>

    <!-- Menu (under Wink Configuration in Sales) -->
    <menuitem id="menu_kuec_document_submissions"
              name="Document Submissions"
              parent="menu_kuec_wink_config_root"
              action="action_kuec_document_submissions"
              sequence="50"/>
</odoo>
