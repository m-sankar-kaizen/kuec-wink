<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- UI-LOV-003 Reusable portal components (Lovable parity) -->

        <!-- Breadcrumbs: pass items as list of dicts [{name, url}], last item url=None -->
        <template id="wink_portal_breadcrumbs" name="Portal Breadcrumbs">
            <nav aria-label="breadcrumb" class="wink-breadcrumb mb-3">
                <ol class="breadcrumb bg-transparent p-0 mb-0 flex-wrap">
                    <t t-foreach="breadcrumb_items" t-as="item">
                        <li class="breadcrumb-item" t-att-class="'active' if not item.get('url') else ''" t-att-aria-current="'page' if not item.get('url') else None">
                            <a t-if="item.get('url')" t-att-href="item['url']"><t t-esc="item['name']"/></a>
                            <t t-if="not item.get('url')" t-esc="item['name']"/>
                        </li>
                    </t>
                </ol>
            </nav>
        </template>

        <!-- StatusBadge: label, variant (quotation|salesorder|cancel|locked|due|paid|onetime|retainer|required|optional), show_dot -->
        <template id="wink_portal_status_badge" name="Portal Status Badge">
            <span t-att-class="'badge rounded-pill ' + (badge_class or 'bg-secondary')" t-att-style="badge_style">
                <t t-if="show_dot"><i class="fa fa-fw fa-circle small me-1"/></t>
                <t t-esc="label"/>
            </span>
        </template>

        <!-- AlertBanner: variant (locked|info|success|warning), message, icon (optional) -->
        <template id="wink_portal_alert_banner" name="Portal Alert Banner">
            <div t-att-class="'alert alert-dismissible fade show ' + (alert_class or 'alert-info')" role="alert">
                <t t-if="icon"><i t-att-class="'fa ' + (icon or 'fa-info-circle') + ' me-2'"/></t>
                <span t-esc="message"/>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/>
            </div>
        </template>

        <!-- ProgressTimeline / Stepper: steps = [(name, num)], delivery_stage = current step number -->
        <template id="wink_portal_progress_timeline" name="Portal Progress Timeline">
            <div class="wink-stepper-row">
                <t t-foreach="steps" t-as="step">
                    <t t-set="step_num" t-value="step[1]"/>
                    <t t-set="step_done" t-value="delivery_stage > step_num"/>
                    <t t-set="step_current" t-value="delivery_stage == step_num"/>
                    <div class="wink-stage-node" t-att-class="'wink-done' if step_done else ('wink-current' if step_current else '')">
                        <div class="wink-node-dot">
                            <t t-if="step_done"><i class="fa fa-check"/></t>
                            <t t-elif="step_current"><i class="fa fa-circle" style="font-size:10px;"/></t>
                        </div>
                        <span class="wink-node-label" t-esc="step[0]"/>
                        <span t-if="step_done or step_current" class="wink-node-date" t-esc="step_date"/>
                    </div>
                    <div t-if="step_num != steps[-1][1]" class="wink-stage-connector flex-grow-1" t-att-class="'wink-done' if step_done else 'wink-pending'"/>
                </t>
            </div>
        </template>

        <!-- ActivityTimeline: items = [{text, date, icon, type}] -->
        <template id="wink_portal_activity_timeline" name="Portal Activity Timeline">
            <t t-foreach="activity_items" t-as="act">
                <div class="wink-timeline-item">
                    <span t-att-class="'wink-timeline-icon' + (' wink-icon-system' if act.get('type') == 'system' else '')">
                        <i t-att-class="'fa ' + (act.get('icon') or ('fa-cog' if act.get('type') == 'system' else 'fa-paper-plane'))"/>
                    </span>
                    <div class="wink-timeline-body">
                        <div class="wink-timeline-text"><t t-esc="act.get('text', '')"/></div>
                        <span class="wink-timeline-time" t-if="act.get('date')">
                            <t t-esc="act.get('date')" t-options="{'widget': 'datetime'}"/>
                        </span>
                    </div>
                </div>
            </t>
        </template>

        <!-- EmptyState: message, cta_text, cta_url, icon (optional) -->
        <template id="wink_portal_empty_state" name="Portal Empty State">
            <div class="wink-empty-state text-center py-5 px-3">
                <t t-if="icon">
                    <div class="mb-3"><i t-att-class="'fa ' + icon + ' fa-3x text-muted'"/></div>
                </t>
                <p class="text-muted mb-3" t-esc="message"/>
                <a t-if="cta_url" t-att-href="cta_url" class="btn btn-wink-primary" t-esc="cta_text"/>
            </div>
        </template>

        <!-- Premium card wrapper: optional gradient header (title, subtitle), body slot -->
        <template id="wink_portal_card_premium" name="Portal Card Premium">
            <div class="card card-premium shadow-sm border-0 rounded-2xl overflow-hidden">
                <t t-if="card_header_title">
                    <div class="card-header kuec-gradient text-white py-3 px-4 d-flex justify-content-between align-items-center">
                        <span class="fw-bold" t-esc="card_header_title"/>
                        <t t-if="card_header_badge"><span t-att-class="'badge ' + (card_header_badge_class or 'bg-light text-dark')" t-esc="card_header_badge"/></t>
                    </div>
                </t>
                <div class="card-body" t-att-style="card_body_style or ''">
                    <t t-raw="0"/>
                </div>
            </div>
        </template>
    </data>
</odoo>
