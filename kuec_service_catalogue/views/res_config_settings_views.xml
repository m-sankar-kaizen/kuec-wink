<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_kuec_service" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.kuec.service</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="10"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Wink" string="Wink" name="kuec_service_catalogue" groups="base.group_user">
                    <!-- ISSUE-006: Company reminder days + global default. -->
                    <block title="Subscription Settings" name="kuec_wink_subscription_setting_container">
                        <setting id="kuec_reminder_days" string="Expiry Reminder Intervals" help="Define default comma-separated days to send expiry reminders before a Wink subscription ends.">
                            <field name="kuec_default_reminder_days"/>
                            <field name="wink_company_reminder_days"/>
                        </setting>
                    </block>

                    <!-- Government Charges global product -->
                    <block title="Government Charges" name="kuec_wink_gov_charge_setting_container">
                        <setting id="kuec_gov_charge_product" string="Government Charges Product"
                                 help="Select the product to use on all government charge sale order lines. If not set, the service product is used as fallback.">
                            <field name="wink_gov_charge_product_id"
                                   options="{'no_create': True}"
                                   placeholder="Select a product…"/>
                        </setting>
                    </block>

                    <!-- Terms & Conditions editor -->
                    <block title="Portal Terms &amp; Conditions" name="kuec_wink_terms_setting_container">
                        <setting id="kuec_terms_html" string="Terms &amp; Conditions Content"
                                 help="HTML content displayed at /terms-and-conditions on the customer portal. Shown to customers before bundle payment.">
                            <div class="col-12 mt-2">
                                <field name="wink_terms_html" widget="html" style="min-height:300px;"/>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
