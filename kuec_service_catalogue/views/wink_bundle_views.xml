<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- wink.bundle Form View — F-2: Smart Buttons, B-4: Comparison Matrix -->
    <record id="wink_bundle_view_form" model="ir.ui.view">
        <field name="name">wink.bundle.view.form</field>
        <field name="model">wink.bundle</field>
        <field name="arch" type="xml">
            <form string="Bundle Package">
                <sheet>
                    <!-- F-2: Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button name="action_view_active_subscriptions"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-refresh">
                            <field name="active_subscription_count" widget="statinfo" string="Active"/>
                        </button>
                        <button name="action_view_tier_comparison"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-th">
                            <field name="total_services" widget="statinfo" string="Services"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="E.g. Business Setup Package"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                            <field name="tier_count" string="Tiers" readonly="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Optional bundle description..."/>
                    <notebook>
                        <page string="Tiers" name="tiers">
                            <field name="tier_ids">
                                <!-- F-4: Drag-and-drop via sequence handle widget -->
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="is_most_popular" widget="boolean_toggle" optional="show"/>
                                    <field name="product_variant_id" optional="hide"/>
                                    <field name="price" column_invisible="True"/>
                                    <field name="item_count" string="Services"/>
                                    <button name="action_open_tier_services" type="object" string="Add / edit services" class="btn-link" icon="fa-arrow-right"/>
                                </list>
                            </field>
                        </page>
                        <page string="Lifecycle Policy" name="lifecycle_policy">
                            <group string="Self-Service Permissions">
                                <field name="allow_self_service_upgrade"/>
                                <field name="allow_self_service_downgrade"/>
                                <field name="allow_self_service_cancel"/>
                            </group>
                            <group string="Refund / Credit Policy">
                                <field name="cancel_refund_policy"/>
                                <field name="downgrade_credit_policy"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- wink.bundle.tier Form View — U-4: Most Popular flag -->
    <record id="wink_bundle_tier_view_form" model="ir.ui.view">
        <field name="name">wink.bundle.tier.view.form</field>
        <field name="model">wink.bundle.tier</field>
        <field name="arch" type="xml">
            <form string="Bundle Tier">
                <sheet>
                    <group>
                        <group>
                            <field name="bundle_id" readonly="1"/>
                            <field name="name"/>
                            <field name="is_most_popular"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="product_variant_id"/>
                            <field name="price" invisible="1"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Describe this tier's benefits..."/>
                    <notebook>
                        <page string="Included Services" name="items">
                            <!-- Issue 3: Quick multi-select button -->
                            <div class="mb-2">
                                <button name="action_open_add_services_wizard"
                                        type="object"
                                        string="Add Multiple Services"
                                        class="btn btn-secondary btn-sm"
                                        icon="fa-plus-circle"
                                        help="Search and select multiple services at once to add to this tier."/>
                            </div>
                            <field name="item_ids">
                                <!-- F-4: Drag-and-drop via sequence handle -->
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="service_product_id"
                                           widget="many2one"
                                           options="{'no_create': True, 'no_open': True}" />
                                    <field name="qty"/>
                                    <field name="description"/>
                                </list>
                            </field>
                        </page>
                        <page string="Upgrade / Downgrade" name="tier_changes">
                            <group>
                                <group string="Pricing">
                                    <field name="price" string="Annual / Full Price"/>
                                    <field name="price_monthly" string="Standard Monthly Price"/>
                                </group>
                            </group>
                            <group string="Allowed Changes">
                                <field name="upgrade_to_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"
                                       string="Customers Can Upgrade To"/>
                                <field name="downgrade_to_ids"
                                       widget="many2many_tags"
                                       options="{'no_create': True}"
                                       string="Customers Can Downgrade To"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- wink.bundle List View -->
    <record id="wink_bundle_view_list" model="ir.ui.view">
        <field name="name">wink.bundle.view.list</field>
        <field name="model">wink.bundle</field>
        <field name="arch" type="xml">
            <list string="Bundle Packages">
                <field name="name"/>
                <field name="tier_count" string="Tiers"/>
                <field name="total_services" string="Services" optional="show"/>
                <field name="order_count" string="Orders" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- B-4: Tier Comparison Matrix — dedicated list view for wink.bundle.tier.item grouped by tier -->
    <record id="wink_bundle_tier_item_comparison_list" model="ir.ui.view">
        <field name="name">wink.bundle.tier.item.comparison.list</field>
        <field name="model">wink.bundle.tier.item</field>
        <field name="arch" type="xml">
            <list string="Tier Comparison Matrix" default_group_by="tier_id" expand="1">
                <field name="tier_id" column_invisible="True"/>
                <field name="tier_name" string="Tier"/>
                <field name="service_product_id" string="Service"/>
                <field name="qty" string="Qty"/>
                <field name="description" string="Notes"/>
                <field name="sequence" widget="handle"/>
            </list>
        </field>
    </record>

    <!-- B-4: Search view for tier items with group-by tier -->
    <record id="wink_bundle_tier_item_search" model="ir.ui.view">
        <field name="name">wink.bundle.tier.item.search</field>
        <field name="model">wink.bundle.tier.item</field>
        <field name="arch" type="xml">
            <search string="Bundle Tier Items">
                <field name="service_product_id"/>
                <field name="tier_id"/>
                <field name="bundle_id"/>
                <group expand="0" string="Group By">
                    <filter string="Tier" name="group_by_tier" context="{'group_by': 'tier_id'}"/>
                    <filter string="Service" name="group_by_service" context="{'group_by': 'service_product_id'}"/>
                    <filter string="Bundle" name="group_by_bundle" context="{'group_by': 'bundle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_wink_bundle" model="ir.actions.act_window">
        <field name="name">Bundle Packages</field>
        <field name="res_model">wink.bundle</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Bundle Package!
            </p>
        </field>
    </record>

    <!-- Import button on bundle list via server action -->
    <record id="action_wink_bundle_import_server" model="ir.actions.server">
        <field name="name">Import Bundles from Excel</field>
        <field name="model_id" ref="kuec_service_catalogue.model_wink_bundle"/>
        <field name="binding_model_id" ref="kuec_service_catalogue.model_wink_bundle"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">
wizard = env['wink.bundle.import.wizard'].create({})
action = {
    'type': 'ir.actions.act_window',
    'res_model': 'wink.bundle.import.wizard',
    'res_id': wizard.id,
    'view_mode': 'form',
    'target': 'new',
}
        </field>
    </record>

    <!-- Menu item under Wink Configuration -->
    <menuitem id="menu_wink_bundle"
              name="Bundle Packages"
              parent="menu_kuec_wink_config_root"
              action="action_wink_bundle"
              sequence="30"/>
</odoo>
