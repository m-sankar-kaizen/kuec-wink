<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_form_kuec_wink" model="ir.ui.view">
        <field name="name">res.partner.form.kuec.wink</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <!-- WINK Partner fields inside the Sales &amp; Purchase tab -->
            <xpath expr="//page[@name='sales_purchases']/group[@name='container_row_2']" position="inside">
                <group string="WINK Details" name="kuec_wink_details">
                    <field name="legal_entity_type" invisible="not is_company" required="is_company"/>
                    <field name="trade_license_number"/>
                    <field name="tax_license_number"/>
                </group>
            </xpath>
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="employee_directory_enabled" widget="boolean_toggle"/>
            </xpath>
        </field>
    </record>
</odoo>
