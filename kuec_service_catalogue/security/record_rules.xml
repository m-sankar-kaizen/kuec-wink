<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="rule_portal_own_employees" model="ir.rule">
            <field name="name">Portal: own employees only</field>
            <field name="model_id" ref="model_kuec_employee_directory"/>
            <field name="domain_force">[('partner_id', 'child_of', user.partner_id.commercial_partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="wink_entitlement_portal_rule" model="ir.rule">
            <field name="name">Bundle Entitlement: Portal Isolation</field>
            <field name="model_id" ref="model_wink_bundle_entitlement"/>
            <field name="domain_force">[('order_id.partner_id', 'child_of', [user.partner_id.commercial_partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Multi-company isolation: internal users see only records belonging
             to their active companies. Uses OR with company_id=False so records
             without a company (older data) are never silently hidden. -->
        <record id="rule_company_bundle_entitlement" model="ir.rule">
            <field name="name">Bundle Entitlement: Multi-Company</field>
            <field name="model_id" ref="model_wink_bundle_entitlement"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_company_bundle_change_log" model="ir.rule">
            <field name="name">Bundle Change Log: Multi-Company</field>
            <field name="model_id" ref="model_wink_bundle_change_log"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_company_document_submission" model="ir.rule">
            <field name="name">Document Submission: Multi-Company</field>
            <field name="model_id" ref="model_kuec_document_submission"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_company_wink_bundle" model="ir.rule">
            <field name="name">Bundle Package: Multi-Company</field>
            <field name="model_id" ref="model_wink_bundle"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_company_wink_bundle_tier" model="ir.rule">
            <field name="name">Bundle Tier: Multi-Company</field>
            <field name="model_id" ref="model_wink_bundle_tier"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="rule_company_wink_bundle_tier_item" model="ir.rule">
            <field name="name">Bundle Tier Item: Multi-Company</field>
            <field name="model_id" ref="model_wink_bundle_tier_item"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
