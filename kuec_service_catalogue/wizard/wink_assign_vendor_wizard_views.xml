<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="wink_assign_vendor_wizard_view_form" model="ir.ui.view">
        <field name="name">wink.assign.vendor.wizard.form</field>
        <field name="model">wink.assign.vendor.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Vendor">
                <group>
                    <field name="task_id" invisible="1"/>
                    <field name="vendor_id"
                           options="{'no_create': True}"
                           placeholder="Search vendor…"/>
                </group>
                <footer>
                    <button name="action_assign"
                            string="Assign &amp; Create RFQ"
                            type="object"
                            class="btn-primary"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
