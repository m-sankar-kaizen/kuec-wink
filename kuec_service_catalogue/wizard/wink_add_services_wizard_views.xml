<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Issue 3: Multi-select services wizard for bundle tier -->
    <record id="wink_add_services_wizard_form" model="ir.ui.view">
        <field name="name">wink.add.services.wizard.form</field>
        <field name="model">wink.add.services.wizard</field>
        <field name="arch" type="xml">
            <form string="Add Services to Tier">
                <sheet>
                    <div class="oe_title">
                        <h2>Add Services — <field name="tier_id" readonly="1"/></h2>
                        <small class="text-muted">Bundle: <field name="bundle_name" readonly="1"/></small>
                    </div>
                    <group>
                        <field name="service_product_ids"
                               widget="many2many_tags"
                               options="{'no_create': True, 'no_open': True}"
                               string="Services"
                               help="Search and select multiple services. Services already in this tier will be skipped automatically."/>
                    </group>
                    <group string="Browse by Department">
                        <!-- Many2many list with search and group-by department -->
                        <field name="service_product_ids"
                               nolabel="1"
                               widget="many2many"
                               options="{'no_create': True}">
                            <list string="Available Services">
                                <field name="name" string="Service"/>
                                <field name="department_ids" widget="many2many_tags" string="Departments"/>
                                <field name="nature_id" string="Nature"/>
                                <field name="commercial_structure" string="Structure"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" type="object" string="Add Selected Services" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
