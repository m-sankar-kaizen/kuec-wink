                            <img t-attf-src="{{ base_url }}/kuec_service_catalogue/static/src/img/wink_star_on.svg" width="14" height="14" alt="*"/>
                            <img t-attf-src="{{ base_url }}/kuec_service_catalogue/static/src/img/wink_star_on.svg" width="14" height="14" alt="*"/>
                            <img t-attf-src="{{ base_url }}/kuec_service_catalogue/static/src/img/wink_star_on.svg" width="14" height="14" alt="*"/>
                            <img t-attf-src="{{ base_url }}/kuec_service_catalogue/static/src/img/wink_star_on.svg" width="14" height="14" alt="*"/>
                            <div style="font-size:11px;color:#555;margin-top:4px;">Excellent</div>
                        </a>
                    </td>
                </tr>
            </table>
        </td></tr>
        <tr><td valign="top" style="font-size:13px;padding-top:20px;color:#444;">
            We appreciate your feedback. It helps us improve continuously.<br/>
            <span style="font-size:11px;color:#aaa;">This survey was sent because your support ticket has been resolved.</span>
        </td></tr>
        <tr><td style="padding-top:16px;font-size:13px;">Best regards,<br/><strong><t t-out="object.company_id.name or ''">KUEC</t></strong></td></tr>
    </tbody>
    </table>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>

    <data noupdate="1">
        <record id="mail_template_kuec_subscription_expiry" model="mail.template">
            <field name="name">Subscription: Expiry Reminder</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Notice: Your {{ object.company_id.name }} Subscription expires soon!</field>
            <field name="email_from">{{ object.company_id.email_formatted }}</field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="description">Sent to customers when their subscription is nearing expiry.</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Hello <t t-out="object.partner_id.name or ''">Customer</t>,<br/><br/>
                        This is a reminder that your subscription (Ref: <t t-out="object.name or ''">SO001</t>) is scheduled to expire on <strong t-out="format_date(object.next_invoice_date) or ''">01/01/2026</strong>. <br/><br/>
                        Please review your account or contact our sales team if you wish to renew or change your plan.<br/>
                        <br/>
                        Thank you,<br/>
                        <t t-out="object.company_id.name or ''">Company</t>
                    </p>
                </div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

