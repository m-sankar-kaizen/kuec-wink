<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Full Payment -->
        <record id="kuec_payment_term_full" model="account.payment.term">
            <field name="name">WINK — Full Payment</field>
            <field name="note">Full payment due at time of order.</field>
            <field name="line_ids" eval="[
                (0, 0, {
                    'value': 'balance',
                    'delay_type': 'days_after',
                    'nb_days': 0
                })
            ]"/>
        </record>

        <!-- 50% Deposit / 50% Delivery -->
        <record id="kuec_payment_term_50_50" model="account.payment.term">
            <field name="name">WINK — 50% Deposit, 50% on Delivery</field>
            <field name="note">50% deposit at order, balance on delivery.</field>
            <field name="line_ids" eval="[
                (0, 0, {
                    'value': 'percent',
                    'value_amount': 50.0,
                    'delay_type': 'days_after',
                    'nb_days': 0
                }),
                (0, 0, {
                    'value': 'balance',
                    'delay_type': 'days_after',
                    'nb_days': 30
                })
            ]"/>
        </record>

        <!-- 30% Deposit / 70% Delivery -->
        <record id="kuec_payment_term_30_70" model="account.payment.term">
            <field name="name">WINK — 30% Deposit, 70% on Delivery</field>
            <field name="note">30% due at order, 70% due on delivery.</field>
            <field name="line_ids" eval="[
                (0, 0, {
                    'value': 'percent',
                    'value_amount': 30.0,
                    'delay_type': 'days_after',
                    'nb_days': 0
                }),
                (0, 0, {
                    'value': 'balance',
                    'delay_type': 'days_after',
                    'nb_days': 30
                })
            ]"/>
        </record>

    </data>
</odoo>
