<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- 50% Deposit / 50% Delivery -->
        <record id="kuec_payment_term_50_50" model="account.payment.term">
            <field name="name">50% Deposit / 50% Upon Delivery</field>
            <field name="note">Payment terms: 50% deposit, balance upon delivery.</field>
            <!-- In Odoo 18, line representation can be complex, often using One2many lines or sequence arrays -->
            <field name="line_ids" eval="[
                (0, 0, {
                    'value': 'percent',
                    'value_amount': 50,
                    'delay_type': 'days_after',
                    'nb_days': 0
                }),
                (0, 0, {
                    'value': 'balance',
                    'delay_type': 'days_after',
                    'nb_days': 0
                })
            ]"/>
        </record>

        <record id="kuec_payment_term_100_upfront" model="account.payment.term">
            <field name="name">100% Upfront</field>
            <field name="note">Payment term: 100% upfront.</field>
            <field name="line_ids" eval="[
                (0, 0, {
                    'value': 'balance',
                    'delay_type': 'days_after',
                    'nb_days': 0
                })
            ]"/>
        </record>
    </data>
</odoo>
