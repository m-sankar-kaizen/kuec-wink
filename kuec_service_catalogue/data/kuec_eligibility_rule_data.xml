<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Eligibility Rules -->
        
        <record id="kuec_eligibility_all" model="kuec.eligibility.rule">
            <field name="name">All</field>
            <field name="code">all</field>
        </record>
        
        <record id="kuec_eligibility_uae" model="kuec.eligibility.rule">
            <field name="name">UAE Companies Only</field>
            <field name="code">uae</field>
        </record>
        
        <record id="kuec_eligibility_abroad" model="kuec.eligibility.rule">
            <field name="name">Abroad Companies</field>
            <field name="code">abroad</field>
        </record>
        
        <!-- Base KU/KUEC structural setup (Includes relation will be set below) -->
        <record id="kuec_eligibility_kuec" model="kuec.eligibility.rule">
            <field name="name">KUEC Only</field>
            <field name="code">kuec</field>
        </record>

        <record id="kuec_eligibility_ku" model="kuec.eligibility.rule">
            <field name="name">KU Only</field>
            <field name="code">ku</field>
            <field name="includes_ids" eval="[(6, 0, [ref('kuec_eligibility_kuec')])]"/>
        </record>

    </data>
</odoo>
