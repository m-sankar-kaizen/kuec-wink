<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Welcome Email Template -->
        <record id="kuec_portal_welcome_email_v5" model="mail.template">
            <field name="name">WINK Portal: Welcome Email</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">Welcome to WINK — Set Your Password</field>
            <field name="email_to">{{ object.email_formatted }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Welcome to WINK, {{ object.name }}!<br/><br/>
                        Your WINK portal account has been created.<br/>
                        Click the button below to set your password and access your dashboard.<br/><br/>
                    </p>
                    <div style="text-align: center; margin: 16px 0px 16px 0px;">
                        <a href="{{ ctx.get('reset_url', '#') }}" style="background-color: #1F4E79; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                            Set My Password
                        </a>
                    </div>
                    <br/><br/>
                    <span style="color: #666666; font-size: 11px;">
                        This link expires in 24 hours.<br/>
                        If you did not request this account, please ignore this email.
                    </span>
                    <br/><br/>
                    The WINK Team — KUEC
                </div>
            </field>
        </record>

        <!-- Coordinator Notification Template -->
        <record id="kuec_coordinator_notification_email_v5" model="mail.template">
            <field name="name">WINK Portal: New Service Request</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">New Service Request — {{ object.name }}</field>
            <field name="email_to">{{ ','.join(object.env.ref('kuec_portal_foundation.group_kuec_coordinator').users.mapped('email')) }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        A new service request has been submitted.<br/><br/>
                        <b>Customer:</b> {{ object.partner_id.name }}<br/>
                        <b>Service:</b> {{ object.order_line[0].product_id.name if object.order_line else 'N/A' }}<br/>
                        <b>Date:</b> {{ object.date_order }}<br/><br/>
                        <div style="text-align: center; margin: 16px 0px 16px 0px;">
                            <a t-attf-href="/web#id={{ object.id }}&amp;model=sale.order&amp;view_type=form" style="background-color: #1F4E79; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;">
                                View in Odoo
                            </a>
                        </div>
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>
