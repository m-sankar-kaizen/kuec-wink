<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="kuec_grade_list_view" model="ir.ui.view">
        <field name="name">kuec.grade.list</field>
        <field name="model">kuec.grade</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" string="Level" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="kuec_grade_form_view" model="ir.ui.view">
        <field name="name">kuec.grade.form</field>
        <field name="model">kuec.grade</field>
        <field name="arch" type="xml">
            <form>
                <header>

                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="kuec_grade_structure_ids"
                                   widget="many2many_tags"/>
                        </group>
                        <group>
                            <field name="min_basic_kuec"/>
                            <field name="mid_basic_kuec"/>
                            <field name="max_basic_kuec"/>
                        </group>
                        <group string="Allowance">
                            <field name="company_id" readonly="1"/>
                            <field name="currency_id"/>
                            <field name="living_allowance"/>
                            <field name="vacation_allowance"/>
                            <field name="connectivity_allowance"/>
                            <field name="personal_allowance"/>
                            <field name="premium_allowance"/>
                            <field name="child_allowance"/>
                        </group>
                    </group>
                    <group>
                        <group string="Leave Travel Allowance">
                            <field name="ticket_type_id"/>
                        </group>
                        <group string="Child Education Allowance">
                        <field name="is_education_allowance"/>
                            <label for="per_child_allowance"
                               invisible="not is_education_allowance"/>
                        <div class="o_row mw-50"
                             name="per_child_allowance"
                             invisible="not is_education_allowance">
                            <field name="per_child_allowance"
                                   class="oe_inline o_hr_narrow_field"
                                   nolabel="1"/>
                            <div class="mb-3">/ Annum</div>
                        </div>

                        <label for="reimbursement_limit"
                               invisible="not is_education_allowance"/>
                        <div class="o_row mw-50" name="reimbursement_limit" invisible="not is_education_allowance">
                            <field name="reimbursement_limit"
                                   class="oe_inline o_hr_narrow_field"
                                   nolabel="1"/>
                            <div class="mb-3">/ Annum</div>
                        </div>
                    </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="action_kuec_grade" model="ir.actions.act_window">
        <field name="name">KUEC Grade</field>
        <field name="res_model">kuec.grade</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Grade
            </p>
        </field>
    </record>
    <menuitem id="kuec_grade_menu"
              name="KUEC Grade"
              parent="hr.menu_human_resources_configuration"
              action="kaz_kuec_grade_structure.action_kuec_grade"/>
</odoo>