<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================================================
         QWeb Template Definition: purchase_requisition
         - This template renders the content of the PDF document.
         - It uses the internal_layout for header/footer consistency.
         - Loops over docs (one or more records).
    ======================================================== -->
    <template id="purchase_requisition">
        <!-- Container defined by the web.html_container layout -->
        <t t-call="web.html_container">

            <!-- Iterate over each Purchase Requisition (usually only one) -->
            <t t-foreach="docs" t-as="doc">

                <!-- Use Odoo's built-in internal layout (includes header, company info, etc.) -->
                <t t-call="web.internal_layout">
                    <div class="page">

                        <!-- ===============================
                             Header Section with Title & State
                        ================================ -->
                        <div class="text-center">
                            <h2>
                                <strong>
                                    <p>
                                        Purchase Requisition
                                        <span t-field="doc.name"/>
                                        -
                                        <span t-field="doc.state"/>
                                    </p>
                                </strong>
                            </h2>
                        </div>

                        <!-- ===============================
                             Table: Basic Requisition Details
                        ================================ -->
                        <table class="table table-responsive">
                            <tr>
                                <td>
                                    <strong>Employee</strong>
                                </td>
                                <td>
                                    <span t-field="doc.employee_id"/>
                                </td>

                                <td>
                                    <strong>Requisition Date</strong>
                                </td>
                                <td>
                                    <span t-field="doc.request_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Department</strong>
                                </td>
                                <td>
                                    <span t-field="doc.department_id.name"/>
                                </td>

                                <td>
                                    <strong>Received Date</strong>
                                </td>
                                <td>
                                    <span t-field="doc.receive_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Requisition Responsible</strong>
                                </td>
                                <td>
                                    <span t-field="doc.requisiton_responsible_id.sudo().name"/>
                                </td>

                                <td>
                                    <strong>Requisition Deadline</strong>
                                </td>
                                <td>
                                    <span t-field="doc.date_end"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Company</strong>
                                </td>
                                <td>
                                    <span t-field="doc.company_id.name"/>
                                </td>

                                <td>
                                    <strong>Analytic Account</strong>
                                </td>
                                <td>
                                    <span t-field="doc.analytic_account_id.name"/>
                                </td>
                            </tr>
                        </table>

                        <!-- ===============================
                             Table: Approval & Signatory Details
                        ================================ -->
                        <strong>
                            <h3>Other Information</h3>
                        </strong>
                        <table class="table table-responsive">
                            <tr>
                                <td>
                                    <strong>Confirmed By</strong>
                                </td>
                                <td>
                                    <span t-field="doc.employee_confirm_id"/>
                                </td>

                                <td>
                                    <strong>Confirmed Date</strong>
                                </td>
                                <td>
                                    <span t-field="doc.confirm_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Department Manager</strong>
                                </td>
                                <td>
                                    <span t-field="doc.approve_manager_id"/>
                                </td>

                                <td>
                                    <strong>Department Approval Date</strong>
                                </td>
                                <td>
                                    <span t-field="doc.managerapp_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Approved By</strong>
                                </td>
                                <td>
                                    <span t-field="doc.approve_employee_id"/>
                                </td>

                                <td>
                                    <strong>Approved Date</strong>
                                </td>
                                <td>
                                    <span t-field="doc.userrapp_date"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Rejected By</strong>
                                </td>
                                <td>
                                    <span t-field="doc.reject_employee_id"/>
                                </td>

                                <td>
                                    <strong>Rejected Date</strong>
                                </td>
                                <td>
                                    <span t-field="doc.userreject_date"/>
                                </td>
                            </tr>
                        </table>

                        <!-- ===============================
                             Table: Picking and Stock Locations
                        ================================ -->
                        <strong>
                            <h3>Picking Details</h3>
                        </strong>
                        <table class="table table-responsive">
                            <tr>
                                <td>
                                    <strong>Source Location</strong>
                                </td>
                                <td>
                                    <span t-field="doc.location_id.name"/>
                                </td>

                                <td>
                                    <strong>Destination Location</strong>
                                </td>
                                <td>
                                    <span t-field="doc.dest_location_id.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Internal Picking</strong>
                                </td>
                                <td>
                                    <span t-field="doc.delivery_picking_id.name"/>
                                </td>

                                <td></td>
                                <td></td>
                            </tr>
                        </table>

                        <!-- ===============================
                             Section: Optional Requisition Reason
                        ================================ -->
                        <t t-if="doc.reason">
                            <strong>
                                <h3>Reason for Requisition</h3>
                            </strong>
                            <table class="table table-responsive">
                                <tr>
                                    <td>
                                        <span t-field="doc.reason"/>
                                    </td>
                                </tr>
                            </table>
                        </t>

                        <!-- ===============================
                             Table: Requisition Line Items
                        ================================ -->
                        <strong>
                            <h3>Requisition Lines</h3>
                        </strong>
                        <table class="table table-responsive">
                            <tr>
                                <td>
                                    <strong>Requisition Action</strong>
                                </td>
                                <td>
                                    <strong>Product</strong>
                                </td>
                                <td>
                                    <strong>Description</strong>
                                </td>
                                <td>
                                    <strong>Quantity</strong>
                                </td>
                                <td>
                                    <strong>Unit of Measure</strong>
                                </td>
                                <td>
                                    <strong>Vendors</strong>
                                </td>
                            </tr>

                            <!-- Loop through each line item in the requisition -->
                            <t t-foreach="doc.requisition_line_ids" t-as="line">
                                <tr>
                                    <td>
                                        <span t-field="line.requisition_type"/>
                                    </td>
                                    <td>
                                        <span t-field="line.product_id.display_name"/>
                                    </td>
                                    <td>
                                        <span t-field="line.description"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="line.qty"/>
                                    </td>
                                    <td class="text-right">
                                        <span t-esc="line.uom.name"/>
                                    </td>
                                    <td>
                                        <!-- Loop through all vendors for this line -->
                                        <span t-esc="', '.join(line.partner_id.mapped('name'))"/>
                                    </td>
                                </tr>
                            </t>
                        </table>

                        <!-- ===============================
                             Signature Section
                        ================================ -->
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Employee Signature: ____________________</strong>
                            </div>
                            <div class="col-6">
                                <strong>Date: ____________________</strong>
                            </div>
                        </div>
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Department Manager Signature: ____________________</strong>
                            </div>
                            <div class="col-6">
                                <strong>Date: ____________________</strong>
                            </div>
                        </div>
                        <div class="row mt32 mb32">
                            <div class="col-6">
                                <strong>Approver Signature: ____________________</strong>
                            </div>
                            <div class="col-6">
                                <strong>Date: ____________________</strong>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
    <!-- ========================================================
             QWeb PDF Report Registration: Purchase Requisition
             - This record registers a new QWeb PDF report for the
               model: material.purchase.requisition.
             - It defines the template, file name, and binding model.
        ======================================================== -->
    <record id="report_purchase_requisition" model="ir.actions.report">
        <field name="name">Purchase Requisition</field>
        <field name="model">material.purchase.requisition</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">material_purchase_requisitions.purchase_requisition</field>
        <field name="report_file">material_purchase_requisitions.purchase_requisition</field>
        <field name="binding_model_id" ref="model_material_purchase_requisition"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
