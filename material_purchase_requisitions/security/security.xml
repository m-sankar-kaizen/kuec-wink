<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- ===============================
         Security Groups
    =============================== -->

    <!-- Basic User: Can create and manage their own requisitions -->
    <record id="group_purchase_requisition_user" model="res.groups">
        <field name="name">Material Purchase Requisition User</field>
        <field name="implied_ids" eval="[Command.link(ref('stock.group_stock_user'))]"/>
    </record>

    <!-- Manager: Has all user permissions and extended management rights -->
    <record id="group_purchase_requisition_manager" model="res.groups">
        <field name="name">Material Purchase Requisition Manager</field>
        <field name="implied_ids" eval="[Command.link(ref('group_purchase_requisition_user'))]"/>
    </record>

    <!-- Department Manager: Typically used for first-level approvals -->
    <record id="group_purchase_requisition_department" model="res.groups">
        <field name="name">Material Purchase Requisition Department Manager</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <!-- ===============================
         Record Rules for Ownership
         (Restrict users to their own requisitions)
    =============================== -->

    <record id="purchase_requisition_own_rule" model="ir.rule">
        <field name="name">Employee Material Purchase Requisition - Own Only</field>
        <field name="model_id" ref="model_material_purchase_requisition"/>
        <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <record id="purchase_requisition_line_employee_rule" model="ir.rule">
        <field name="name">Employee Material Purchase Requisition Lines - Own Only</field>
        <field name="model_id" ref="model_material_purchase_requisition_line"/>
        <field name="domain_force">[('requisition_id.employee_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[Command.link(ref('base.group_user'))]"/>
    </record>

    <!-- ===============================
         Full Access Rules
         (Used by Managers / Purchasers / Approvers)
    =============================== -->

    <record id="purchase_requisition_all_rule" model="ir.rule">
        <field name="name">Material Purchase Requisitions - All Records</field>
        <field name="model_id" ref="model_material_purchase_requisition"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[
                Command.link(ref('material_purchase_requisitions.group_purchase_requisition_user')),
                Command.link(ref('purchase.group_purchase_user')),
                Command.link(ref('material_purchase_requisitions.group_purchase_requisition_department'))
            ]"/>
    </record>

    <record id="purchase_requisition_line_all_rule" model="ir.rule">
        <field name="name">Material Purchase Requisition Lines - All Records</field>
        <field name="model_id" ref="model_material_purchase_requisition_line"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[
                Command.link(ref('material_purchase_requisitions.group_purchase_requisition_user')),
                Command.link(ref('purchase.group_purchase_user')),
                Command.link(ref('material_purchase_requisitions.group_purchase_requisition_department'))
            ]"/>
    </record>
</odoo>
