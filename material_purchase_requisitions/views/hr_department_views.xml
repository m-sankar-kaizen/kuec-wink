<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ==========================================
         Inherit hr.department Form View
         Add: Destination Location field
         Purpose: Allows each department to define a default destination stock location,
         which can be used in purchase requisitions, internal transfers, etc.
    ========================================== -->
    <record id="purchase_requisition_department_form_view" model="ir.ui.view">
        <field name="name">hr.department.form.inherit.dest.location</field>
        <field name="model">hr.department</field>
        <field name="inherit_id" ref="hr.view_department_form"/>
        <field name="arch" type="xml">
            <!-- Insert custom destination location field after 'parent_id' field -->
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="dest_location_id"/>
            </xpath>

        </field>
    </record>

</odoo>
