<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_purchase_requisition_form_wink_doa" model="ir.ui.view">
        <field name="name">purchase.requisition.form.inherit.kaz.wink.doa.approval</field>
        <field name="model">purchase.requisition</field>
        <field name="inherit_id" ref="kaz_vendor_contact_company_restriction.view_purchase_requisition_form"/>
        <field name="arch" type="xml">

            <!-- Show the Extend Agreement button for WINK as well as KUEC -->
            <button name="action_extend_agreement" position="attributes">
                <attribute name="invisible">company_code not in ['KUEC', 'WINK']</attribute>
            </button>

            <!-- Make the Extension Requests tab visible for WINK as well -->
            <page name="extension_request" position="attributes">
                <attribute name="invisible">company_code not in ['KUEC', 'WINK']</attribute>
            </page>

            <!--
                Add an Open button after the existing KUEC Reject button.
                Visible only for WINK — opens the full extend.agreement form
                where all WINK approval actions live.
            -->
            <xpath expr="//page[@name='extension_request']//list//button[@name='action_reject']"
                   position="after">
                <field name="company_code" column_invisible="1"/>
                <button name="action_open_extend_form"
                        string="Open" type="object"
                        icon="fa-external-link"
                        invisible="company_code not in ['WINK']"/>
            </xpath>

        </field>
    </record>
</odoo>
