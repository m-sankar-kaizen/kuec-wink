<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="form_kaz_cash_forecast_categories" model="ir.ui.view">
            <field name="name">kaz.cash.forecast.categories.form</field>
            <field name="model">kaz.cash.forecast.categories</field>
            <field name="arch" type="xml">
                <form string="Cash Forecast Categories">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" required="1"/>
                                <field name="is_group_for_opening"/>
                            </group>
                            <group>
                                <field name="sequence" readonly="1"/>
                                <field name="type" required="1"/>
                            </group>
                        </group>
                        <footer>
                            <button string="Save" class="btn-primary" type="object" name="document_layout_save"
                                    data-hotkey="q"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="kaz_cash_forecast_categories_list" model="ir.ui.view">
            <field name="name">kaz.cash.forecast.categories.list</field>
            <field name="model">kaz.cash.forecast.categories</field>
            <field name="arch" type="xml">
                <list>
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="type"/>
                </list>
            </field>
        </record>

        <record id="kanban_kaz_cash_forecast_categories" model="ir.ui.view">
            <field name="name">kaz.cash.forecast.categories.kanban</field>
            <field name="model">kaz.cash.forecast.categories</field>
            <field name="arch" type="xml">
                <kanban class="o_kaz_cash_forecast_categories_kanban">
                    <templates>
                        <t t-name="kanban-box">
                            <div class="">
                                <div class="oe_kanban_details">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <a type="object" class="h3 o_primary cursor-pointer" name="open_action"
                                               style="color: #017e84;">
                                                <field name="name"/>
                                            </a>
                                        </strong>
                                    </div>
                                    <div class="o_gauge_value o_dashboard_graph m-4">
                                        <field name="kanban_dashboard_graph" t-att-graph_type="'bar'"
                                               widget="dashboard_graph"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="kaz_cash_forecast_categories_search" model="ir.ui.view">
            <field name="name">kaz.cash.forecast.categories.search</field>
            <field name="model">kaz.cash.forecast.categories</field>
            <field name="arch" type="xml">
                <search string="Cash Forecast Categories">
                    <field name="name"/>
                    <field name="type"/>
                    <separator/>
                    <filter string="Cash IN" name="cash_in" domain="[('type','=','income')]"/>
                    <filter string="Cash OUT" name="cash_out" domain="[('type','=','expense')]"/>
                    <filter string="Opening Forecast" name="opening" domain="[('type','=','opening')]"/>
                    <filter string="Closing Forecast" name="closing" domain="[('type','=','closing')]"/>
                    <group expand="0" string="Group By">
                        <filter string="Group" name="type" context="{'group_by':'type'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="actions_kaz_cash_forecast_categories" model="ir.actions.act_window">
            <field name="name">Cash Forecast Categories</field>
            <field name="res_model">kaz.cash.forecast.categories</field>
            <field name="view_mode">kanban,list,form</field>
        </record>

        <menuitem id="menu_main_kaz_cash_forecast"
                  name="Cash Forecast" sequence="61"
                  web_icon="kaz_cash_flow_forecasting,static/description/icon.png"
                  groups="kaz_cash_flow_forecasting.group_kaz_cash_flow_forecasting_user,account.group_account_manager"/>

        <menuitem id="menu_sub_kaz_cash_forecast" name="Cash Forecast"
                  groups="kaz_cash_flow_forecasting.group_kaz_cash_flow_forecasting_manager,account.group_account_manager"
                  parent="kaz_cash_flow_forecasting.menu_main_kaz_cash_forecast" sequence="1"/>

        <menuitem id="menu_sub_kaz_cash_forecast_reporting" name="Reporting"
                  parent="kaz_cash_flow_forecasting.menu_main_kaz_cash_forecast" sequence="2"/>

        <menuitem id="menu_sub_kaz_cash_forecast_configuration" name="Configuration"
                  groups="kaz_cash_flow_forecasting.group_kaz_cash_flow_forecasting_manager"
                  parent="kaz_cash_flow_forecasting.menu_main_kaz_cash_forecast" sequence="4"/>

        <menuitem id="menu_kaz_cash_forecast_group" name="Cash Forecast Categories"
                  parent="kaz_cash_flow_forecasting.menu_sub_kaz_cash_forecast" sequence="1"
                  action="kaz_cash_flow_forecasting.actions_kaz_cash_forecast_categories"/>
    </data>
</odoo>
