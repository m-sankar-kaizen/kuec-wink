<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cash_forecast_categories_pending" model="kaz.cash.forecast.categories">
            <field name="name">Pending</field>
            <field name="type">pending</field>
            <field name="is_group_for_opening">False</field>
            <field name="sequence">0</field>
        </record>
        <record id="cash_forecast_categories_opening" model="kaz.cash.forecast.categories">
            <field name="name">Opening</field>
            <field name="type">opening</field>
            <field name="is_group_for_opening">True</field>
            <field name="sequence">1</field>
        </record>
        <record id="cash_forecast_categories_income" model="kaz.cash.forecast.categories">
            <field name="name">Total Cash IN</field>
            <field name="type">income</field>
            <field name="is_group_for_opening">False</field>
            <field name="sequence">2</field>
        </record>
        <record id="cash_forecast_categories_expense" model="kaz.cash.forecast.categories">
            <field name="name">Total Cash OUT</field>
            <field name="type">expense</field>
            <field name="is_group_for_opening">False</field>
            <field name="sequence">3</field>
        </record>
        <record id="cash_forecast_categories_net_forecasting" model="kaz.cash.forecast.categories">
            <field name="name">Net Forecast</field>
            <field name="type">net_forecast</field>
            <field name="is_group_for_opening">False</field>
            <field name="sequence">99</field>
        </record>
        <record id="cash_forecast_categories_closing" model="kaz.cash.forecast.categories">
            <field name="name">Closing</field>
            <field name="type">closing</field>
            <field name="is_group_for_opening">False</field>
            <field name="sequence">100</field>
        </record>
        <record id="budget_forecast_settings" model="kaz.budget.forecast.settings">
            <field name="include_budget_forecast" eval="False"/>
        </record>
    </data>
</odoo>
