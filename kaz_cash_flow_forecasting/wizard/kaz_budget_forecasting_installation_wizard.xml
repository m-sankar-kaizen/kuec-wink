<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="kaz_budget_forecasting_installation_wizard" model="ir.ui.view">
            <field name="name">kaz.budget.forecasting.installation.wizard</field>
            <field name="model">kaz.budget.forecasting.installation.wizard</field>
            <field name="arch" type="xml">
                <form string="kaz Budget Forecast Configuration">
                    <sheet>
                            <div>
                                <strong>Just click on "Extract" button which will add the "Budget Forecast"
                                        functionality, after that please follow below steps,
                                </strong>
                            </div>
                        <footer>
                            <button name="execute" string="Extract" type="object"
                                    class="oe_highlight"/>
                            <button string="Cancel" class="oe_link" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="actions_kaz_budget_forecasting_installation_wizard" model="ir.actions.act_window">
            <field name="name">Include Budget Forecast</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">kaz.budget.forecasting.installation.wizard</field>
            <field name="binding_view_types">form</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
