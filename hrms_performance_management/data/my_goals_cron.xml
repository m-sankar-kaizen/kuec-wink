<odoo>
    <data noupdate="1">
        <record id="ir_cron_check_deadline_goals" model="ir.cron">
            <field name="name">Check Goals Deadline</field>
            <field name="model_id" ref="model_my_goals"/>
            <field name="state">code</field>
            <field name="code">model.check_and_update_deadline()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- <field name="numbercall">-1</field> -->
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_check_expired_goals" model="ir.cron">
            <field name="name">Check Goals Expiry</field>
            <field name="model_id" ref="model_my_goals"/>
            <field name="state">code</field>
            <field name="code">model.check_and_update_expiry()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <!-- <field name="numbercall">-1</field> -->
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
