<odoo>
    <data>
        <record id="view_kpi_list" model="ir.ui.view">
            <field name="name">kpi.list</field>
            <field name="model">kra.kpi</field>
            <field name="arch" type="xml">
                <list string="KPI">
                    <field name="name"/>
                    <!-- <field name="department_id"/>
                    <field name="job_id"/> -->
                </list>
            </field>
        </record>

        <record id="view_kpi_form" model="ir.ui.view">
            <field name="name">kpi.form</field>
            <field name="model">kra.kpi</field>
            <field name="arch" type="xml">
                <form string="KPI">
                    <sheet>
                        <group>
                            <!-- <field name="is_department_wise" invisible="is_jobposition_wise"/>
                            <field name="is_jobposition_wise" invisible="is_department_wise"/> -->
                            <field name="name"/>
                            <!-- <field name="department_id" invisible="is_jobposition_wise"/>
                            <field name="job_id" invisible="is_department_wise"/> -->
                            <field name="description"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_kpi" model="ir.actions.act_window">
            <field name="name">KPI</field>
            <field name="res_model">kra.kpi</field>
            <field name="view_mode">list,form</field>
        </record>

       
        <menuitem id="kpi_menu"
						name="KPI"
						action="action_kpi"
						parent="configuration_main_menu"
						sequence="2"/>
    </data>
</odoo>
