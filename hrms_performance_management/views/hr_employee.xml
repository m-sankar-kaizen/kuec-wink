<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Inherit Employee Form View -->
    <record id="view_goals_assignment_form_popup" model="ir.ui.view">
        <field name="name">employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div class="oe_button_box" name="button_box" position="inside">
                <button name="action_goals_assignment"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-cube"
                        string="Assign Goals">
                </button>
                <button
                    name="action_show_employee_warning"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-exclamation-triangle"
                    groups="hrms_performance_management.group_performance_hr"
                    invisible="warning_count == 0">
                    <field name="warning_count" widget="statinfo" string="Warning(s)"/>
                </button>
            </div>
        </field>
    </record>
</odoo>