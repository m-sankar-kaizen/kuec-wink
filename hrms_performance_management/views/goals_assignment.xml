<odoo>
    <data>
        <record id="view_goals_assignment_list" model="ir.ui.view">
            <field name="name">goals.assignment.list</field>
            <field name="model">goals.assignment</field>
            <field name="arch" type="xml">
                <list string="Goals Assignment">
                    <field name="name"/>
                    <field name="employee_id"/>
                    <field name="department_id"/>
                    <field name="job_id"/>
                    <field name="weightage"/>
                    <field name="target"/>
                    <field name="timeline_start"/>
                    <field name="timeline_end"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record id="view_goals_assignment_form_main" model="ir.ui.view">
            <field name="name">goals.assignment.form</field>
            <field name="model">goals.assignment</field>
            <field name="arch" type="xml">
                <form string="Goals Assignment">
                    <header>
                        <button name="action_active_goal" type="object" string="Set to active" class="oe_highlight" invisible="context.get('from_employee_form', False) or state in ('active', 'in_progress', 'completed', 'not_finished', 'expired')"/>
                        <button name="action_reset_to_draft" type="object" string="Reset to draft" class="oe_highlight" invisible="context.get('from_employee_form', False) or state in ('draft', 'completed', 'not_finished')"/>
                        <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,in_progress,completed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="employee_id" placeholder="Select an Employee" readonly="state != 'draft'"/>
                            </h1>
                        </div>
                        <group>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="is_department_wise" invisible="is_jobposition_wise" readonly="state != 'draft'"/>
                            <field name="is_jobposition_wise" invisible="is_department_wise" readonly="state != 'draft'"/>
                            <field name="kra_department_id" required="is_department_wise" invisible="is_jobposition_wise or not is_department_wise" readonly="state != 'draft'"/>
                            <field name="kra_job_id" required="is_jobposition_wise" invisible="is_department_wise or not is_jobposition_wise" readonly="state != 'draft'"/>

                            <field name="kra_normal_id" required="not (is_department_wise or is_jobposition_wise)" invisible="is_department_wise or is_jobposition_wise" readonly="state != 'draft'"/>
                            
                            <field name="kpi_id" widget="many2many_tags" readonly="state != 'draft'"/>
                            <field name="weightage" readonly="state != 'draft'"/>
                            <field name="target" readonly="state != 'draft'"/>
                            <field name="timeline_start" readonly="state != 'draft'"/>
                            <field name="timeline_end" readonly="state != 'draft'"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_goals_assignment" model="ir.actions.act_window">
            <field name="name">Goals Assignment</field>
            <field name="res_model">goals.assignment</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="goals_assignment_menu"
						name="Goals Assignment"
						action="action_goals_assignment"
						parent="performance_management_main_menu"
						sequence="2"
                        groups="hrms_performance_management.group_performance_hr,hrms_performance_management.group_performance_manager"/>
    </data>
</odoo>
