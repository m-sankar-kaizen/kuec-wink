<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_applicant_view_form" model="ir.ui.view">
        <field name="name">hr.applicant.view.form.kaizen</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='interviewer_ids']" position="after">
                <field name="used_hiring_request_ids" invisible="1"/>
                <field name="approved_hiring_request_id"
                       invisible="company_code != 'KUEC'"
                       options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
        </field>
    </record>
</odoo>