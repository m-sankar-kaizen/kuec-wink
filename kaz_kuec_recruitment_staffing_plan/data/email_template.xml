<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="email_template_department_manager_notify" model="mail.template">
            <field name="name">Department Manager Notify: Email Template</field>
            <field name="email_to">{{object.partner_id.email}}</field>
            <field name="subject">Department Staffing Plan: {{ctx.get('department')}}</field>
            <field name="model_id" ref="base.model_res_users"/>
            <field name="body_html" type="html">
<div class="page">
    <div style="font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34); background-color: #FFF; ">
        <p> Greetings!!<br/>
        Please be informed that today is the day to create staffing plan for your department <t t-esc="ctx.get('department')"/>.<br/>
        </p>
    </div>
</div>
            </field>
        </record>
</odoo>