<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ===========================================================================
        Tree View: service.receipt.list
        Purpose:
            Displays a list of Service Receipts in a summarized tabular view.
            Enables multi-record edit, color-coded states, and priority flags.

        Key Customizations:
            - Uses priority widget and badge widget for 'state'.
            - State decorations for better UX (colors for each status).
            - Shows partner, scheduled and effective dates, and origin.
    ============================================================================ -->
    <record id="service_receipt_tree_view" model="ir.ui.view">
        <field name="name">service.receipt.list</field>
        <field name="model">service.receipt</field>
        <field name="arch" type="xml">
            <list string="Service list" multi_edit="1" sample="1">
                <field name="company_id" invisible="1"/>
                <field name="po_order_id" invisible="1"/>
                <field name="priority" optional="show" widget="priority" nolabel="1"/>
                <field name="name" decoration-bf="1"/>
                <field name="partner_id" optional="show" readonly="state in ['done', 'cancel']"/>
                <field name="user_id" readonly="state in ['done', 'cancel']" optional="hide"
                       widget="many2one_avatar_user"/>
                <field name="scheduled_date" optional="show" widget="remaining_days"
                       invisible="state in  ['done','cancel']"/>
                <field name="date_deadline" optional="hide" widget="remaining_days"
                       invisible="state in  ['done','cancel']"/>
                <field name="date_done" string="Effective Date" optional="hide"/>

                <!-- Source doc (PO, backorder, etc.) -->
                <field name="origin" optional="show" readonly="state in ['done', 'cancel']"/>
                <field name="backorder_id" optional="hide"/>

                <!-- Only visible in multi-company setups -->
                <field name="company_id" groups="base.group_multi_company" optional="show"/>

                <!-- Status indicator with badges and decorations -->
                <field name="state" optional="show" widget="badge"
                       decoration-danger="state=='cancel'"
                       decoration-info="state== 'assigned'"
                       decoration-muted="state == 'draft'"
                       decoration-success="state == 'done'"
                       decoration-warning="state not in ('draft','cancel','done','assigned')"/>
            </list>
        </field>
    </record>

    <!-- ===========================================================================
        Form View: service.receipt.view.form
        Purpose:
            Full editable form for creating and validating a Service Receipt Note (SRN).
            Includes buttons, notebook pages for lines & signatures, chatter integration.

        Key Sections:
            - Header Buttons: Validate, Cancel, Mark As Todo, Print Completion Report.
            - Metadata & Statusbar: Name, Priority, Dates, Partner.
            - Notebook:
                - Operations (editable one2many service lines)
                - Signature pad for multi-stage approvals.
    ============================================================================ -->
    <record id="service_receipt_view_form" model="ir.ui.view">
        <field name="name">service_receipt_form</field>
        <field name="model">service.receipt</field>
        <field name="arch" type="xml">
            <form string="Transfer">
                <!-- ========= Buttons in header ========= -->
                <header>
                    <!-- Confirmed stage: validate button -->
                    <button name="service_button_validate"
                            invisible="state in  ['done', 'cancel', 'draft']"
                            string="Validate" type="object" class="oe_highlight" data-hotkey="v"/>

                    <!-- Cancel operation -->
                    <button name="service_action_cancel"
                            invisible="state in  ['done','cancel']"
                            string="Cancel" type="object" data-hotkey="z"
                            style="margin-right:800px;"/>

                    <!-- Mark back to draft -->
                    <button name="service_action_mark_as_todo"
                            invisible="state != 'draft'"
                            string="Mark As Todo" type="object" class="oe_highlight" data-hotkey="k"
                            style="margin-left:-783px;"/>

                    <!-- Print service completion PDF -->
                    <button name="service_completion_report"
                            invisible="state != 'done'"
                            string="Service Completion Report" type="object"
                            style="margin-left:-783px;"/>

                    <!-- Status bar state widget -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,assigned,done" default="assigned"/>
                </header>

                <!-- ========= Body / Sheet ========= -->
                <sheet>
                    <div class="oe_title">
                        <h1 class="d-flex">
                            <field name="priority" widget="priority" class="me-3"
                                   invisible="name == '/'"/>
                            <field name="name" invisible="name == '/'"/>
                        </h1>
                    </div>

                    <!-- General Info -->
                    <group>
                        <group>
                            <!-- Partner selection -->
                            <div class="o_td_label">
                                <label for="partner_id" string="Receive From" style="font-weight:bold;"/>
                            </div>
                            <field name="partner_id" nolabel="1" readonly="state in ['done', 'cancel']"/>

                            <!-- Internal/hidden fields -->
                            <field name="company_id" invisible="1"/>
                            <field name="is_locked" invisible="1"/>
                            <field name="state" invisible="1" readonly="0"/>

                            <!-- Deadlines -->
                            <field name="date_deadline"
                                   invisible="state in ['done','cancel'] or not date_deadline"
                                   decoration-danger="date_deadline and date_deadline &lt; current_date"
                                   decoration-bf="date_deadline and date_deadline &lt; current_date"/>
                            <field name="date_done" string="Effective Date" invisible="state != 'done'"/>
                            <field name="backorder_id" invisible="not backorder_id"/>
                        </group>
                        <group>
                            <label for="scheduled_date"/>
                            <div class="o_row">
                                <field name="scheduled_date" required="True"
                                       readonly="state in ['done', 'cancel']"
                                       decoration-warning="state not in ('done', 'cancel') and scheduled_date &lt; now"
                                       decoration-danger="state not in ('done', 'cancel') and scheduled_date &lt; current_date"
                                       decoration-bf="state not in ('done', 'cancel') and (scheduled_date &lt; current_date or scheduled_date &lt; now)"/>
                            </div>
                            <label for="origin" string="Source Document" style="font-weight:bold;"/>
                            <div class="o_row">
                                <field name="origin" placeholder="e.g. PO0032" readonly="state in ['done', 'cancel']"/>
                            </div>
                        </group>

                        <!-- ========= Tabs / Notebook ========= -->
                        <notebook>
                            <!-- ======================= Operations Tab ======================= -->
                            <page string="Operations" name="operations">
                                <!-- One2many for service lines -->
                                <field name="service_receipt_line_ids" mode="list,kanban"
                                       widget="stock_move_one2many"
                                       readonly="state == 'done' and is_locked"
                                       context="{
                                            'default_company_id': company_id,
                                            'default_date': scheduled_date,
                                            'form_view_ref': 'skit_srn_receipt.service_receipt_line_view',
                                            'default_date_deadline': date_deadline,
                                            'default_partner_id': partner_id
                                       }"
                                       add-label="Add a Product">
                                    <list string="Service Moves" editable="bottom">
                                        <field name="product_id" force_save="1"/>
                                        <field name="description" string="Description" optional="hide"/>
                                        <field name="date" optional="hide"/>
                                        <field name="date_deadline" optional="hide"/>
                                        <field name="service_lines_count" invisible="1"/>
                                        <field name="backorder_id" invisible="1"/>
                                        <field name="product_uom_qty" string="Demand"
                                               readonly="state != 'draft' or backorder_id"/>
                                        <field name="quantity_done" required="1" string="Quantity"
                                               column_invisible="parent.state == 'draft'"
                                               readonly="not product_id"/>
                                        <field name="additional" invisible="1"/>
                                        <field name="state" invisible="1" readonly="0"/>
                                        <field name="company_id" invisible="1"/>
                                        <field name="product_uom_category_id" invisible="1"/>
                                        <field name="product_qty" invisible="1" readonly="1"/>
                                    </list>
                                </field>
                            </page>

                            <!-- ======================= Signature Tab ======================= -->
                            <page name="signature" string="Signature">
                                <!-- Hidden user tracking fields -->
                                <field name="end_user_id" invisible="1"/>
                                <field name="procurement_department_user_id" invisible="1"/>
                                <field name="department_head_user_id" invisible="1"/>
                                <field name="current_display_name" invisible="1"/>

                                <!-- Signature Pad Section -->
                                <group col="1" class="o_signature_group">

                                    <!-- End User -->
                                    <div class="o_signature_block">
                                        <label for="end_user_signature" string="End User Signature"/>
                                        <button id="clear_end_user" name="clear_signature" type="object"
                                                string="Clear Signature"
                                                context="{'field_name': 'end_user_signature'}"
                                                class="oe_highlight" style="margin-bottom:4px"/>
                                        <field name="end_user_signature" widget="signature"
                                               options="{'full_name': 'current_display_name','size': [0, 150]}"
                                               readonly="state in ['done', 'cancel']"/>
                                    </div>

                                    <!-- Procurement -->
                                    <div class="o_signature_block">
                                        <label for="procurement_department_signature"
                                               string="Procurement Signature"/>
                                        <button id="clear_proc" name="clear_signature" type="object"
                                                string="Clear Signature"
                                                context="{'field_name': 'procurement_department_signature'}"
                                                class="oe_highlight" style="margin:2px"/>
                                        <field name="procurement_department_signature" widget="signature"
                                               options="{'full_name': 'current_display_name','size': [0, 150]}"
                                               readonly="state in ['done', 'cancel']"/>
                                    </div>

                                    <!-- Department Head -->
                                    <div class="o_signature_block">
                                        <label for="department_head_signature" string="Department Head Signature"/>
                                        <button id="clear_dep_head" name="clear_signature" type="object"
                                                string="Clear Signature"
                                                context="{'field_name': 'department_head_signature'}"
                                                class="oe_highlight" style="margin:2px"/>
                                        <field name="department_head_signature" widget="signature"
                                               options="{'full_name': 'current_display_name','size': [0, 150]}"
                                               readonly="state in ['done', 'cancel']"/>
                                    </div>
                                </group>
                            </page>
                        </notebook>
                    </group>
                </sheet>

                <!-- ========= Chatter ========= -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ===========================================================================
        Action Window: action_service_receipt_all
        Purpose:
            Smart button or menu action to open SRN list + form views.
            Displays all service receipts in the system with multi-company context.
    ============================================================================ -->
    <record id="action_service_receipt_all" model="ir.actions.act_window">
        <field name="name">SRN Transfers</field>
        <field name="res_model">service.receipt</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'contact_display': 'partner_address', 'default_company_id': allowed_company_ids[0]}
        </field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No transfer found. Let's create one!
            </p>
            <p>
                Transfers allow you to move products from one location to another.
            </p>
        </field>
    </record>

    <menuitem
            id="menu_purchase_srn_receipt"
            name="SRN Receipt"
            action="action_service_receipt_all"
            web_icon="skit_srn_receipt,static/description/icon.png"
            groups="skit_srn_receipt.srn_end_user"
    />
</odoo>
