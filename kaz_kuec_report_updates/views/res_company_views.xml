<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_company_view_form_inherit" model="ir.ui.view">
        <field name="name">res.company.view.form.inherit.kuec.report.updates</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="bank_details" string="Bank Info">
                    <group>
                        <field name="kuec_bank_id"/>
                        <field name="iban_num"/>
                        <field name="branch_name"/>
                        <field name="kuec_account_no"/>
                        <field name="beneficiary"/>
                        <field name="swift_code"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>

</odoo>