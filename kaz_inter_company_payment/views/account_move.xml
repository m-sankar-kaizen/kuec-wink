<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_move_form_inter_company_payment" model="ir.ui.view">
        <field name="name">account.move.form.inter.company.payment</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="after">
                <div class="badge rounded-pill text-bg-info fs-6 border-0 my-2"
                     invisible="not is_intercompany_payment">
                    Inter-Company Payment
                </div>
            </xpath>
            <xpath expr="//field[@name='posted_before']" position="after">
                <field name="is_intercompany_payment" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='amount_residual']" position="after">
                <field name="intercompany_paid_amount" readonly="1" invisible="not is_intercompany_payment"/>
            </xpath>
            <xpath expr="//field[@name='ref']" position="after">
                <field name="other_intercompany_move" invisible="1"/>
                <field name="cheque_due_date"  readonly="1" invisible="not other_intercompany_move"/>
                <field name="cheque_number"  readonly="1" invisible="not other_intercompany_move"/>
            </xpath>
        </field>
    </record>

</odoo>