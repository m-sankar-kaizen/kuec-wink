<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_employee_settlements_view_primary" model="ir.ui.view">
        <field name="name">exit_clearance_form_view_primary</field>
        <field name="model">hr.employee.settlements</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="kaz_end_of_service.hr_employee_settlements_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button"
                            name="action_view_resignation_form"
                            string="Resignation Form"
                            type="object"
                            icon="fa-edit" invisible="not resignation_form_id">
                    </button>
                    <button class="oe_stat_button"
                            name="action_view_exit_clearance"
                            string="Exit Clearance"
                            type="object"
                            icon="fa-edit" invisible="not exit_clearance_id">
                    </button>
                    <button class="oe_stat_button"
                            name="action_view_exit_interview"
                            string="Exit Interview"
                            type="object"
                            icon="fa-edit" invisible="not exit_interview_id">
                    </button>
                </div>
            </xpath>
            <xpath expr="//group[@name='earnings_and_deductions']" position="after">
                <group string="KUEC Settlements" name="kuec_settlement_amount">
                    <field name="kuec_settlement_amount" widget="monetary"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_settlements" model="ir.actions.act_window">
        <field name="name">Employee Settlement Form</field>
        <field name="res_model">hr.employee.settlements</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="kaz_kuec_offboarding.hr_employee_settlements_view_primary"/>
        <field name="view_ids" eval="[Command.clear(),
                          (0,0,{'view_mode':'form', 'view_id': ref('hr_employee_settlements_view_primary')})]"/>
    </record>
</odoo>