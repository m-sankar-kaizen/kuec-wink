<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="register_form_tree_view" model="ir.ui.view">
        <field name="name">register form list</field>
        <field name="model">register.form</field>
        <field name="inherit_id" ref="kaz_employee_reports.register_form_tree_view"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="employee_department_id"/>
            </xpath>
        </field>
    </record>

    <record id="register_form_form_view" model="ir.ui.view">
        <field name="name">register.form.view.form</field>
        <field name="model">register.form</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="kaz_employee_reports.register_form_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="employee_department_id"/>
            </xpath>
            <xpath expr="//button[@name='rejected']" position="before">
                <button name="proceed_to_exit_interview"
                        type="object"
                        string="Proceed to Exit Interview"
                        invisible="state != 'approved' or exit_interview_id"
                        class="oe_highlight"/>
            </xpath>
            <xpath expr="//button[@name='rejected']" position="attributes">
                <attribute name="invisible" add="exit_interview_id" separator="or"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button"
                            name="action_view_exit_interview"
                            string="Exit Interview"
                            type="object"
                            icon="fa-edit" invisible="not exit_interview_id">
                    </button>
                    <button class="oe_stat_button"
                            name="action_view_exit_clearance"
                            string="Exit Clearance"
                            type="object"
                            icon="fa-edit" invisible="not exit_clearance_id">
                    </button>
                    <button class="oe_stat_button"
                            name="action_view_employee_settlement"
                            groups="kaz_end_of_service.group_hr"
                            string="Employee Settlement"
                            type="object"
                            icon="fa-edit" invisible="not employee_settlement_id">
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <record id="action_ank_register_form" model="ir.actions.act_window">
        <field name="name">Resignation Form</field>
        <field name="res_model">register.form</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="kaz_kuec_offboarding.register_form_tree_view"/>
        <field name="context">{
                'create': True,
                'edit': True,
                'delete': True,
            }</field>
        <field name="view_ids" eval="[Command.clear(),
                          (0,0,{'view_mode':'list', 'view_id': ref('register_form_tree_view')}),
                          (0,0,{'view_mode':'form', 'view_id': ref('register_form_form_view')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new resignation form
            </p>
        </field>
    </record>

    <menuitem id="menu_kaz_kuec_offboarding_root"
              parent="hr.menu_hr_root"
              action="action_ank_register_form"
              name="KUEC Off-boarding" sequence="21"/>
</odoo>