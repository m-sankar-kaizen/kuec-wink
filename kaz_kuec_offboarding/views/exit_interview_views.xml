<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="exit_interview_form_view" model="ir.ui.view">
        <field name="name">exit_interview_form_view</field>
        <field name="model">exit.interview</field>
        <field name="inherit_id" ref="kaz_employee_reports.exit_interview_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="after">
                <chatter/>
            </xpath>
        </field>
    </record>

    <record id="exit_interview_form_view_primary" model="ir.ui.view">
        <field name="name">exit_interview_form_view_primary</field>
        <field name="model">exit.interview</field>
        <field name="mode">primary</field>
        <field name="inherit_id" ref="kaz_employee_reports.exit_interview_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='rejected']" position="before">
                <button name="proceed_to_exit_clearance"
                        type="object"
                        string="Proceed to Exit Clearance"
                        invisible="state != 'approved' or exit_clearance_id"
                        class="oe_highlight"/>
            </xpath>
            <xpath expr="//button[@name='rejected']" position="attributes">
                <attribute name="invisible" add="exit_clearance_id" separator="or"/>
            </xpath>
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button"
                            name="action_view_resignation_form"
                            string="Resignation Form"
                            type="object"
                            icon="fa-edit" invisible="not resignation_form_id">
                    </button>
                    <button class="oe_stat_button"
                            name="action_view_exit_clearance"
                            string="Exit Clearance"
                            type="object"
                            icon="fa-edit" invisible="not exit_clearance_id">
                    </button>
                    <button class="oe_stat_button"
                            name="action_view_employee_settlement"
                            groups="kaz_end_of_service.group_hr"
                            string="Employee Settlement"
                            type="object"
                            icon="fa-edit" invisible="not employee_settlement_id">
                    </button>
                </div>
            </xpath>
        </field>
    </record>

    <record id="exit_interview_form" model="ir.actions.act_window">
        <field name="name">Exit Interview Form</field>
        <field name="res_model">exit.interview</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="kaz_kuec_offboarding.exit_interview_form_view_primary"/>
        <field name="view_ids" eval="[Command.clear(),
                          (0,0,{'view_mode':'form', 'view_id': ref('exit_interview_form_view_primary')})]"/>
    </record>
</odoo>