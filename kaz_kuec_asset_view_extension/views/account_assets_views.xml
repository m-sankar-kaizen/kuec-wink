<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_account_asset_form" model="ir.ui.view">
        <field name="name">account.asset.form.inherit.kuec.extension</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='original_value']" position="after">
                <field name="company_code" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='original_value']" position="replace">
                <!-- For ANK -->
                <field name="original_value"
                       string="Recoverable or Current Cost"
                       invisible="company_code != 'ANK'"/>

                <!-- For Others -->
                <field name="original_value"
                       invisible="company_code == 'ANK'"/>

            </xpath>
        </field>
    </record>

</odoo>