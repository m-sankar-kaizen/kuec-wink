<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="batch_monetization_form" model="ir.ui.view">
        <field name="name">batch.monetization.form</field>
        <field name="model">batch.monetization</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id" readonly="0"/>
                        </group>
                        <group>
                            <field name="amount" required="1"/>
                        </group>

                    </group>
                </sheet>
                <footer>
                    <button name="create_payment" type="object" string="Create Payment" class="oe_highlight" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <act_window id="batch_monetization_action"
                name="Batch Monetization"
                res_model="batch.monetization"
                view_mode="form"
                target="new"

    />

</odoo>
