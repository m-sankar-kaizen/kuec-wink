<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Scheduled Action for Cheque Due Date Reminders -->
        <record id="ir_cron_cheque_due_date_reminder" model="ir.cron">
            <field name="name">(KUEC) - Cheque Due Date Reminders</field>
            <field name="model_id" ref="model_cheque_management"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_cheque_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
            <!-- Run daily at 9:00 AM -->
            <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).replace(hour=9, minute=0, second=0)"/>
        </record>
    </data>
</odoo>
