<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cheque_book_form" model="ir.ui.view">
        <field name="name">cheque.book.form</field>
        <field name="model">cheque.book</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="next_page" readonly="0"/>
                        </group>
                        <group>
                            <field name="start" required="1"/>
                            <field name="end" required="1"/>
                            <field name="is_finished" invisible="1"/>
                        </group>
                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="cheque_book_action" model="ir.actions.act_window">
        <field name="name">Cheque Book</field>
        <field name="res_model">cheque.book</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Cheque Book
            </p>
        </field>
    </record>
    <menuitem id="cheque_book_menu"
              name="Cheque Book"
              action="cheque_book_action"
              parent="main_menu_incoming_cheque_management"
              sequence="5"/>

</odoo>
