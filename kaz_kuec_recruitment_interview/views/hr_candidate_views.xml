<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_candidate_view_form_inherit_interview_feedback" model="ir.ui.view">
        <field name="name">hr.candidate.view.form.inherit.interview.feedback</field>
        <field name="model">hr.candidate</field>
        <field name="inherit_id" ref="hr_recruitment.hr_candidate_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="feedbacks" string="Feedback">
                    <field name="interview_feedback_ids" widget="one2many_list" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="candidate_id"/>
                            <field name="interview_date"/>
                            <field name="rating" widget="priority" options="{'rating_values': [1, 2, 3, 4, 5]}" readonly="1"/>
                            <field name="user_id"/>
                            <field name="feedback"/>
                            <field name="job_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>