<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="hr_recruitment_stage_form_inherit_interview">
        <field name="name">hr.recruitment.stage.form.inherit.interview</field>
        <field name="model">hr.recruitment.stage</field>
        <field name="inherit_id" ref="hr_recruitment.hr_recruitment_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hired_stage']" position="after">
                <field name="allow_interview" invisible="company_code != 'KUEC'"/>
            </xpath>
        </field>
    </record>
</odoo>