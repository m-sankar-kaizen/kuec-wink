<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_config_settings_view_form_inherit_probation_period" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.probation.period</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='employees_setting_container']"
                   position="after">
                <block title="Probation (KUEC)" invisible="company_code != 'KUEC'">
                    <setting id="period_x_days_kuec"
                             help="X number of days to be probation period of any new comers in KUEC.">
                        <field name="probation_period_days"/>
                        <div class="text-muted">
                            Number of days to be probation period of any new comers in KUEC
                        </div>
                    </setting>
                    <setting id="remind_for_x_days_before_probation_end"
                             help="Number of days before the probation end date to send a reminder in KUEC.">
                        <field name="remind_for_x_days_before_probation_end"/>
                        <div class="text-muted">
                            Number of days before the probation end date to send a reminder in KUEC
                        </div>
                    </setting>
                    <setting id="maximum_probation_extension_period"
                             help="'Maximum number of days to which the probation period can be extended.">
                        <field name="maximum_probation_extension_period"/>
                        <div class="text-muted">
                            Maximum Probation Extension Period (Days) (KUEC)
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>