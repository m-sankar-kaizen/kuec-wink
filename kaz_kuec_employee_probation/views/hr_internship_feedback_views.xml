<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_hr_internship_feedback_form" model="ir.ui.view">
        <field name="name">hr.internship.feedback.form</field>
        <field name="model">hr.internship.feedback</field>
        <field name="inherit_id" ref="hr_internship.view_hr_internship_feedback_form"/>
        <field name="arch" type="xml">
            <field name="internship_id" position="attributes">
                <attribute name="required">not probation_employee_id</attribute>
            </field>
            <field name="feedback_text" position="replace">
                <group>
                    <field name="feedback_text"/>
                </group>
            </field>
        </field>
    </record>

    <record id="view_hr_internship_feedback_list_primary" model="ir.ui.view">
        <field name="name">hr.internship.feedback.list</field>
        <field name="model">hr.internship.feedback</field>
        <field name="mode">primary</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="hr_internship.view_hr_internship_feedback_list"/>
        <field name="arch" type="xml">
            <field name="internship_id" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="internship_id" position="after">
                <field name="probation_employee_id"/>
            </field>

        </field>
    </record>

    <record id="view_hr_internship_feedback_form_primary" model="ir.ui.view">
        <field name="name">hr.internship.feedback.form</field>
        <field name="model">hr.internship.feedback</field>
        <field name="mode">primary</field>
        <field name="priority">50</field>
        <field name="inherit_id" ref="hr_internship.view_hr_internship_feedback_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='internship_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <field name="internship_id" position="after">
                <field name="probation_employee_id" readonly="1"/>
            </field>
        </field>
    </record>

    <record id="action_view_feedback" model="ir.actions.act_window">
        <field name="name">Feedback Records</field>
        <field name="res_model">hr.internship.feedback</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="kaz_kuec_employee_probation.view_hr_internship_feedback_form_primary"/>
        <field name="view_ids" eval="[Command.clear(),
                          (0,0,{'view_mode':'list', 'view_id': ref('view_hr_internship_feedback_list_primary')}),
                          (0,0,{'view_mode':'form', 'view_id': ref('view_hr_internship_feedback_form_primary')})]"/>
    </record>

</odoo>
