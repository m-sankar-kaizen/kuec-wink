<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_extend_probation_wizard_form" model="ir.ui.view">
        <field name="name">extend.probation.wizard.form</field>
        <field name="model">extend.probation</field>
        <field name="arch" type="xml">
            <form string="Extend Probation">
                <group>
                    <field name="employee_id"
                           invisible="1"/>
                    <field name="new_date"/>
                </group>

                <footer>
                    <button name="action_confirm"
                            string="Confirm"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>