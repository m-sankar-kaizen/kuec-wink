<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
        View Inheritance: OAuth Provider Form
        Purpose:
            Similar to the SAML provider, this adds a logo field to the
            `auth.oauth.provider` form view. It allows uploading and displaying
            a provider-specific image (e.g., Google, Microsoft logos).

        Technical Details:
            - Uses the 'image' widget for file upload and preview
            - Positioned before the first <group> for better visibility
    -->
    <record id="kaz_oauth_provider_form_view_inherit" model="ir.ui.view">
        <field name="name">kaz.oauth.provider.form.view.inherit</field>
        <field name="model">auth.oauth.provider</field>
        <field name="inherit_id" ref="auth_oauth.view_oauth_provider_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[1]" position="before">
                <field name="logo"
                       widget="image"
                       class="oe_avatar"
                       options="{'preview_image': 'image_128'}"/>
            </xpath>
        </field>
    </record>
</odoo>
