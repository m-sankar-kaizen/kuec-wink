<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="payment_provider_form" model="ir.ui.view">
        <field name="name">N-Genius Payment Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'ngenius'">
                    <field
                        name="ngenius_api_key"
                        string="API Key"
                        password="True"
                        required="code == 'ngenius' and state != 'disabled'"
                    />
                    <field
                        name="ngenius_outlet_id"
                        string="Outlet Reference ID"
                        required="code == 'ngenius' and state != 'disabled'"
                    />
                    <field
                        name="ngenius_webhook_secret"
                        string="Webhook Signing Secret"
                        password="True"
                    />
                </group>
            </group>
        </field>
    </record>

</odoo>
