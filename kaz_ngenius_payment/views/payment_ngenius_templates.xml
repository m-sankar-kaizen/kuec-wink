<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Redirect form for N-Genius Hosted Payment Page.

        N-Genius returns a URL like: https://paypage.sandbox.ngenius-payments.com/?code=<token>
        A plain GET form drops the query string, so we split the URL into base + params
        and inject each param as a hidden input to preserve the `code` on submission.
    -->
    <template id="redirect_form">
        <form t-att-action="api_url" method="get">
            <t t-foreach="url_params" t-as="param">
                <input type="hidden" t-att-name="param" t-att-value="url_params[param]"/>
            </t>
        </form>
    </template>

</odoo>
