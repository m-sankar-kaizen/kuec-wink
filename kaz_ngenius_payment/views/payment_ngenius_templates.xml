<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Redirect form for N-Genius Hosted Payment Page.

        The payment.transaction._get_specific_rendering_values() method returns
        a single 'api_url' key containing the full N-Genius HPP URL.
        We perform a simple GET redirect to that URL — no hidden fields needed
        because all payment parameters are already encoded server-side by N-Genius.
    -->
    <template id="redirect_form">
        <form t-att-action="api_url" method="get">
            <!-- No additional hidden inputs required; the HPP URL is self-contained. -->
        </form>
    </template>

</odoo>
