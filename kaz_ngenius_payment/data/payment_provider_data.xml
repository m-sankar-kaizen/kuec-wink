<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Seed record for the N-Genius payment provider.
        Links the provider code to the redirect form template.
        Created by post_init_hook via setup_provider(); noupdate="1" prevents
        accidental overwrite after installation.
    -->
    <record id="payment_provider_ngenius" model="payment.provider">
        <field name="name">N-Genius</field>
        <field name="code">ngenius</field>
        <field name="redirect_form_view_id" ref="redirect_form"/>
        <field name="image_128" type="base64" file="kaz_ngenius_payment/static/description/icon.png"/>
        <field name="module_id" ref="base.module_kaz_ngenius_payment"/>
        <field name="payment_method_ids" eval="[
            Command.link(ref('payment.payment_method_card')),
            Command.link(ref('payment.payment_method_visa')),
            Command.link(ref('payment.payment_method_mastercard')),
            Command.link(ref('payment.payment_method_amex')),
        ]"/>
    </record>

</odoo>
