<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.kaz.vendor.contact.company.restriction</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="kaz_vendor_management.res_partner_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='misc']/field[@name='company_id'][1]" position="after">
                <field name="company_code" invisible="1"/>
            </xpath>

            <xpath expr="//group[@name='misc']/field[@name='company_id'][1]" position="attributes">
<!--                <attribute name="required">1</attribute>-->
                <attribute name="readonly">1</attribute>
            </xpath>


            <header name="kuec_approval_buttons" position="attributes">
                <attribute name="invisible">company_code not in ['KUEC']</attribute>
            </header>

            <group name="commercial_partner_type" position="attributes">
                <attribute name="invisible">company_code not in ['KUEC']</attribute>
            </group>

            <page name="vendor_management" position="attributes">
                <attribute name="invisible">company_code not in ['KUEC']</attribute>
            </page>

            <xpath expr="//group[@name='vendor_exp_detail']/field[@name='partner_category_ids']" position="attributes">
                <attribute name="required">company_code in ['KUEC'] and show_partner_category_required</attribute>
            </xpath>

            <page name="attachment_checklist" position="attributes">
                <attribute name="invisible" add="company_code not in ['KUEC']" separator="or"/>
            </page>

        </field>
    </record>

    <menuitem id="menu_res_partner_kuec_parent"
              name="Contacts"
              parent="contacts.menu_contacts"
              sequence="1"/>
    <!-- ========================= -->
    <!-- 1. Window Action: PENDING -->
    <!-- ========================= -->
    <record id="action_res_partner_pending" model="ir.actions.act_window">
        <field name="name">Pending Partners</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form,map,activity</field>
        <field name="domain">[('state', '!=', 'approved')]</field>
        <field name="context">{'group_by': 'state'}</field>
    </record>

    <!-- Menuitem for Pending Partners -->
    <menuitem id="menu_res_partner_pending"
              name="Pending Partners"
              parent="menu_res_partner_kuec_parent"
              action="action_res_partner_pending"
              sequence="10"/>


    <!-- ========================= -->
    <!-- 2. Window Action: APPROVED -->
    <!-- ========================= -->
    <record id="action_res_partner_approved" model="ir.actions.act_window">
        <field name="name">Approved Partners</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,list,form,map,activity</field>
        <field name="domain">[('state', '=', 'approved')]</field>
    </record>

    <!-- Menuitem for Approved Partners -->
    <menuitem id="menu_res_partner_approved"
              name="Approved Partners"
              parent="menu_res_partner_kuec_parent"
              action="action_res_partner_approved"
              sequence="20"/>

</odoo>