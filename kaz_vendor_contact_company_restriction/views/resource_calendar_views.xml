<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="resource_calendar_form" model="ir.ui.view">
        <field name="name">resource.calendar.view.form.inherit.kaz.vendor.contact.company.restriction</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="kaz_flexible_working_hours.resource_calendar_form"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="company_code" invisible="1"/>
            </field>
            <field name="flexible_check_in" position="attributes">
                <attribute name="invisible">flexible_hours and company_code in ['KUEC']</attribute>
            </field>
        </field>
    </record>
</odoo>
