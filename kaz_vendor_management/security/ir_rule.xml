<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="company_size_comp_rule" model="ir.rule">
        <field name="name">Company Size multi-company</field>
        <field name="model_id" ref="model_company_size"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="iso_certification_comp_rule" model="ir.rule">
        <field name="name">Certification multi-company</field>
        <field name="model_id" ref="model_iso_certification"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="worked_company_comp_rule" model="ir.rule">
        <field name="name">Worked Company multi-company</field>
        <field name="model_id" ref="model_worked_company"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rq_type_attachment_line_comp_rule" model="ir.rule">
        <field name="name">Requisition Type Attachment Line multi-company</field>
        <field name="model_id" ref="model_rq_type_attachment_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="purchase_requisition_type_comp_rule" model="ir.rule">
        <field name="name">Purchase Requisition Type multi-company</field>
        <field name="model_id" ref="model_purchase_requisition_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="purchase_requisition_type_user_rule" model="ir.rule">
        <field name="name">Purchase Requisition Type User Record Rule</field>
        <field name="model_id" ref="model_purchase_requisition_type"/>
        <field name="domain_force">['|', ('allowed_user_ids', 'in', user.ids), ('create_uid', '=', user.id)]</field>
    </record>

    <record id="purchase_requisition_type_admin" model="ir.rule">
        <field name="name">Purchase Requisition Type Admin Record Rule</field>
        <field name="model_id" ref="model_purchase_requisition_type"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[Command.link(ref('material_purchase_requisitions.group_purchase_requisition_manager'))]"/>
    </record>

    <record id="tender_rfq_comp_rule" model="ir.rule">
        <field name="name">Tender RFQ multi-company</field>
        <field name="model_id" ref="model_tender_rfq"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="tender_checklist_conf_comp_rule" model="ir.rule">
        <field name="name">Tender Checklist Configuration multi-company</field>
        <field name="model_id" ref="model_tender_checklist_conf"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="evaluation_checklist_conf_comp_rule" model="ir.rule">
        <field name="name">Evaluation Checklist Configuration multi-company</field>
        <field name="model_id" ref="model_evaluation_checklist_conf"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="tender_bid_comp_rule" model="ir.rule">
        <field name="name">Tender Bidding multi-company</field>
        <field name="model_id" ref="model_tender_bid"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="vendor_evaluation_conf_comp_rule" model="ir.rule">
        <field name="name">Vendor Evaluation multi-company</field>
        <field name="model_id" ref="model_vendor_evaluation_conf"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

        <record id="purchase_contract_agreement_line_comp_rule" model="ir.rule">
        <field name="name">Purchase Contract Agreement multi-company</field>
        <field name="model_id" ref="model_purchase_contract_agreement_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>