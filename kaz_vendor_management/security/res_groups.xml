<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="module_category_tender" model="ir.module.category">
        <field name="name">Tender (KUEC)</field>
        <field name="description">Tender Management</field>
        <field name="sequence">40</field>
    </record>

    <record id="group_tender_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_tender"/>
        <field name="comment">Can access and work on tender documents.</field>
        <field name="implied_ids" eval="[Command.link(ref('purchase.group_purchase_user'))]"/>
    </record>

    <record id="group_tender_admin" model="res.groups">
        <field name="name">Admin</field>
        <field name="category_id" ref="module_category_tender"/>
        <field name="comment">Full access to tender records and tender configuration.</field>
        <field name="implied_ids" eval="[Command.link(ref('group_tender_user')), Command.link(ref('purchase.group_purchase_manager'))]"/>
    </record>

</odoo>