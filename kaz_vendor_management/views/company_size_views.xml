<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Business Size Form View -->
    <record id="view_company_size_form" model="ir.ui.view">
        <field name="name">company.size.form</field>
        <field name="model">company.size</field>
        <field name="arch" type="xml">
            <form string="Business Size">
                <sheet>
                    <group>
                        <field name="sequence" readonly="1"/>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Business Size List View -->
    <record id="view_company_size_list" model="ir.ui.view">
        <field name="name">company.size.list</field>
        <field name="model">company.size</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_company_size" model="ir.actions.act_window">
        <field name="name">Company Size</field>
        <field name="res_model">company.size</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_company_size_items" name="Company Size"
              parent="kaz_contact_approval.menu_contact_checklist_root"
              action="action_company_size"
              sequence="4"/>

    <menuitem id="menu_purchase_company_size_items" name="Company Size"
              parent="kaz_contact_approval.menu_purchase_vendor_root"
              action="action_company_size"
              sequence="2"/>
</odoo>
