<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- List View -->
    <record id="view_evaluation_checklist_conf_list" model="ir.ui.view">
        <field name="name">evaluation.checklist.conf.list</field>
        <field name="model">evaluation.checklist.conf</field>
        <field name="arch" type="xml">
            <list string="Evaluation Checklist Configurations">
                <field name="name"/>
                <field name="evaluation_type"/>
                <field name="total_weight"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_evaluation_checklist_conf_form" model="ir.ui.view">
        <field name="name">evaluation.checklist.conf.form</field>
        <field name="model">evaluation.checklist.conf</field>
        <field name="arch" type="xml">
            <form string="Evaluation Checklist Configuration">
                <header>
                    <button name="action_activate" invisible="state != 'draft'"
                            class="btn btn-primary" string="Activate" type="object"/>
                    <button name="action_reset_to_draft" invisible="state != 'active'"
                            class="btn btn-secondary" string="Reset to Draft" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="state != 'draft'"/>
                            <field name="evaluation_type" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                            <field name="total_weight" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Checklist Lines">
                            <field name="checklist_conf_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="weight"/>
                                    <field name="company_id" groups="base.group_multi_company" readonly="1"
                                           optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_evaluation_checklist_conf" model="ir.actions.act_window">
        <field name="name">Evaluation Checklist Configurations</field>
        <field name="res_model">evaluation.checklist.conf</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Evaluation Checklist Configuration</p>
        </field>
    </record>

    <menuitem id="menu_evaluation_checklist_conf"
              name="Evaluation Checklist"
              parent="kaz_vendor_management.menu_tender_rfq_conf_root"
              groups="kaz_vendor_management.group_tender_admin"
              action="action_evaluation_checklist_conf"
              sequence="2"/>

</odoo>
