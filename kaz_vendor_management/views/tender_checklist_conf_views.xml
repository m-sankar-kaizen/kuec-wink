<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tender Checklist Configuration Form View -->
    <record id="view_tender_checklist_conf_form" model="ir.ui.view">
        <field name="name">tender.checklist.conf.form</field>
        <field name="model">tender.checklist.conf</field>
        <field name="arch" type="xml">
            <form string="Tender Checklist Configuration">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                        <field name="partner_category_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tender Checklist Configuration List View -->
    <record id="view_tender_checklist_conf_list" model="ir.ui.view">
        <field name="name">tender.checklist.conf.list</field>
        <field name="model">tender.checklist.conf</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="partner_category_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_tender_checklist_conf" model="ir.actions.act_window">
        <field name="name">Tender Checklist</field>
        <field name="res_model">tender.checklist.conf</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_purchase_tender_checklist_conf_items" name="Tender Checklist"
              parent="kaz_vendor_management.menu_tender_rfq_conf_root"
              groups="kaz_vendor_management.group_tender_admin"
              action="action_tender_checklist_conf"
              sequence="1"/>
</odoo>
