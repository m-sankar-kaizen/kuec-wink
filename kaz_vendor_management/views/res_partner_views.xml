<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_partner_view_form" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit.kaz.vendor.management</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="kaz_contact_approval.res_partner_view_form"/>
        <field name="arch" type="xml">

            <div name="button_box" position="inside">
                <button invisible="not vendor_evaluation_ids" class="oe_stat_button" type="object"
                        name="action_vendor_open_evaluation" icon="fa-pencil-square-o">
                    <field name="vendor_evaluation_ids" invisible="1"/>
                    <div class="o_stat_info">
                        <span class="o_stat_text">Vendor Evaluation</span>
                    </div>
                </button>
            </div>

            <field name="is_vendor" position="before">
                <field name="is_portal" invisible="1"/>
                <div class="badge rounded-pill text-bg-success float-end" invisible="not is_portal">Portal</div>
            </field>

            <field name="partner_category_ids" position="replace"/>

            <xpath expr="//page[@name='internal_notes']" position="after">
                <page name="vendor_management" string="Vendor Management">
                    <group string="Vendor Evaluation">
                        <field name="vendor_evaluation_conf_id" options="{'no_quick_create':True,'no_create_edit':True}"
                               domain="[('state', '=', 'active')]" required="is_vendor"
                               readonly="state != 'draft'"/>
                        <button invisible="not generate_evaluation" class="btn btn-secondary" type="object"
                                name="action_generate_evaluation" icon="fa-pencil-square-o">
                            Generate Evaluation
                        </button>
                        <field name="vendor_score"/>
                        <field name="evaluation_rating" widget="priority" readonly="1"/>
                        <field name="evaluated_date"/>
                        <field name="generate_evaluation" readonly="1" widget="boolean_toggle"/>
                    </group>
                    <group>
                        <group name="vendor_exp_detail" string="Vendor Experience &amp; Details">
                            <field name="partner_category_ids" widget="many2many_tags"
                                   required="show_partner_category_required"
                                   options="{'no_quick_create':True,'no_create_edit':True}"/>
                            <field name="other_partner_category" invisible="not other_partner_category" readonly="1"/>
                            <field name="iso_certification_ids" string="Certifications" widget="many2many_tags"
                                   options="{'no_quick_create':True,'no_create_edit':True}"/>
                            <field name="other_partner_certificates" invisible="not other_partner_certificates"
                                   readonly="state != 'draft'"/>
                            <field name="icv_score" readonly="state != 'draft'"/>
                            <field name="company_size_id" options="{'no_quick_create':True,'no_create_edit':True}"/>
                            <field name="offered_product_ids" widget="many2many_tags"
                                   domain="[('purchase_ok', '=', True)]"
                                   options="{'no_quick_create':True,'no_create_edit':True}"/>
                            <field name="other_offered_product" invisible="not other_offered_product" readonly="1"/>
                            <field name="years_of_experience"/>
                            <field name="has_worked_for_govt" widget="boolean_toggle" readonly="state != 'draft'"/>
                        </group>
                        <group name="additional_contact_detail" string="Contact Person Details"
                               invisible="company_type != 'company'">
                            <field name="contact_name"/>
                            <field name="contact_function"/>
                            <field name="contact_phone" widget="phone"/>
                            <field name="contact_email" widget="email"/>
                        </group>
                    </group>
                    <group>
                        <field name="worked_company_ids" invisible="not has_worked_for_govt">
                            <list editable="bottom">
                                <field name="sequence" readonly="1"/>
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>