<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- List View -->
    <record id="view_vendor_evaluation_conf_list" model="ir.ui.view">
        <field name="name">vendor.evaluation.conf.list</field>
        <field name="model">vendor.evaluation.conf</field>
        <field name="arch" type="xml">
            <list string="Vendor Evaluation Configuration">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="state"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_vendor_evaluation_conf_form" model="ir.ui.view">
        <field name="name">vendor.evaluation.conf.form</field>
        <field name="model">vendor.evaluation.conf</field>
        <field name="arch" type="xml">
            <form string="Vendor Evaluation Configuration">
                <header>
                    <button name="action_activate" invisible="state != 'draft'"
                            class="btn btn-primary" string="Activate" type="object"/>
                    <button name="action_reset_to_draft" invisible="state != 'active'"
                            class="btn btn-secondary" string="Reset to Draft" type="object"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="state != 'draft'"/>
                        <field name="company_id" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Evaluation Conf Lines">
                            <field name="evaluation_conf_line_ids" readonly="state != 'draft'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="weight"/>
                                    <field name="company_id" groups="base.group_multi_company" readonly="1"
                                           optional="hide"/>
                                </list>
                            </field>
                            <group>
                                <group>
                                </group>
                                <group class="oe_subtotal_footer">
                                    <field name="total_weight"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_vendor_evaluation_conf" model="ir.actions.act_window">
        <field name="name">Vendor Evaluation Template</field>
        <field name="res_model">vendor.evaluation.conf</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_vendor_evaluation_conf"
              name="Vendor Evaluation Template"
              parent="kaz_contact_approval.menu_purchase_vendor_root"
              action="action_vendor_evaluation_conf"
              sequence="5"/>

</odoo>
