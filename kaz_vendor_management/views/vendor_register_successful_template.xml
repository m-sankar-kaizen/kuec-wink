<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="vendor_register_successful" name="Register Successful">
        <t t-call="website.layout">
            <div class="container py-4">
                <div class="card shadow-sm border-0 mx-auto" style="max-width: 600px;">
                    <div class="card-body text-center py-5">
                        <i class="fa fa-check-circle text-success" style="font-size: 4rem;"/>
                        <h2 class="mt-3 text-success fw-bold">Registration Successful!</h2>
                        <p class="mt-3 text-muted">
                            Thank you for registering as a vendor with us.
                            Our team will review your submission and contact you soon.
                        </p>
                        <a href="/" class="btn btn-primary mt-4 px-4">
                            <i class="fa fa-home me-2"/>
                            Return to Homepage
                        </a>
                    </div>
                </div>
            </div>
        </t>
    </template>
</odoo>