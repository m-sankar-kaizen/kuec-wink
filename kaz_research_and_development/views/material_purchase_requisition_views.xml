<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="requisition_form_inherit" model="ir.ui.view">
        <field name="name">material.purchase.requisition.form.view.inherit.kaz.vendor.management</field>
        <field name="model">material.purchase.requisition</field>
        <field name="inherit_id" ref="kz_requisition_quintuple_approvals.requisition_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <field name="research_development_id" invisible="1"/>
                <button class="oe_stat_button" type="object" icon="fa-flask"
                        name="action_research_development" string="R&amp;D"
                        invisible="not research_development_id">
                </button>
            </xpath>
<!--            <field name="requisition_type_id" position="attributes">-->
<!--                <attribute name="readonly" add="research_development_id" separator="or"/>-->
<!--            </field>-->
            <field name="purchase_vendor_ids" position="attributes">
                <attribute name="readonly" add="research_development_id" separator="or"/>
            </field>
            <field name="employee_id" position="attributes">
                <attribute name="readonly" add="research_development_id" separator="or"/>
            </field>
        </field>
    </record>
</odoo>