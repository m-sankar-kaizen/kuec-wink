<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Multi-company restriction -->
    <record id="research_development_comp_rule" model="ir.rule">
        <field name="name">R&amp;D multi-company</field>
        <field name="model_id" ref="model_research_development"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <!-- Record Rule: R&D Employee sees only their own records -->
    <record id="rule_research_employee_own_records" model="ir.rule">
        <field name="name">R&amp;D Employee: Own Records (KUEC)</field>
        <field name="model_id" ref="model_research_development"/>
        <field name="domain_force">[('employee_id.user_id','=',user.id)]</field>
        <field name="groups" eval="[Command.link(ref('kaz_research_and_development.group_research_employee_kuec'))]"/>
    </record>

    <!-- Record Rule: Department Head sees their own and their team's records -->
    <record id="rule_research_dep_head_records" model="ir.rule">
        <field name="name">R&amp;D Department Head: Team Records (KUEC)</field>
        <field name="model_id" ref="model_research_development"/>
        <field name="domain_force">[
            '|',
            ('employee_id.user_id','=',user.id),
            ('employee_parent_id.user_id','=',user.id)
        ]</field>
        <field name="groups" eval="[Command.link(ref('kaz_research_and_development.group_research_dep_head_kuec'))]"/>
    </record>

    <!-- Record Rule: CIO sees all records -->
    <record id="rule_research_cio_all_records" model="ir.rule">
        <field name="name">R&amp;D CIO: All Records (KUEC)</field>
        <field name="model_id" ref="model_research_development"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[Command.link(ref('kaz_research_and_development.group_research_cio_kuec'))]"/>
    </record>

    <!-- Record Rule: CCO sees all records -->
    <record id="rule_research_cco_all_records" model="ir.rule">
        <field name="name">R&amp;D CCO: All Records (KUEC)</field>
        <field name="model_id" ref="model_research_development"/>
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[Command.link(ref('kaz_research_and_development.group_research_cco_kuec'))]"/>
    </record>

</odoo>
