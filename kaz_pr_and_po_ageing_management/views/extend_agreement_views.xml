<odoo>
    <record id="view_extend_agreement_form_wizard" model="ir.ui.view">
        <field name="name">extend.agreement.form.wizard</field>
        <field name="model">extend.agreement</field>
        <field name="arch" type="xml">
            <form string="Extend Agreement">
                <header>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,approved"/>
                </header>
                <sheet>
                    <group>
                        <field name="purchase_requisition_id" readonly="1"/>
                        <field name="new_date_end" required="1" readonly="state != 'draft'"/>
                        <field name="request_user_id" readonly="1"/>
                    </group>
                    <footer>
                        <button string="Request" type="object" name="action_notify" class="btn-primary"/>
                        <button string="Discard" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
