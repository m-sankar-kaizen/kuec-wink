<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- ========================================== -->
        <!-- SALE ORDER (Quotations)                    -->
        <!-- ISSUE-004: Conservative hardening — portal read-only; writes via controller sudo(). -->
        <!-- ========================================== -->
        <record id="rule_portal_sale_order_personal" model="ir.rule">
            <field name="name">Portal: own orders only</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[('message_partner_ids', 'in', [user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_vendor_sale_order_deny" model="ir.rule">
            <field name="name">Vendor: no sale orders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">[(0, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('kuec_portal_foundation.group_kuec_vendor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ========================================== -->
        <!-- PROJECTS                                   -->
        <!-- ========================================== -->
        <record id="rule_portal_project_personal" model="ir.rule">
            <field name="name">Portal: own projects only</field>
            <field name="model_id" ref="project.model_project_project"/>
            <field name="domain_force">[('message_partner_ids', 'in', [user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ========================================== -->
        <!-- TASKS                                      -->
        <!-- ========================================== -->
        <record id="rule_portal_task_personal" model="ir.rule">
            <field name="name">Portal: own tasks only</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="domain_force">['|', ('project_id.message_partner_ids', 'in', [user.partner_id.id]), ('message_partner_ids', 'in', [user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ========================================== -->
        <!-- HELPDESK TICKETS                           -->
        <!-- ========================================== -->
        <record id="rule_portal_helpdesk_ticket_personal" model="ir.rule">
            <field name="name">Portal: own tickets only</field>
            <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
            <field name="domain_force">[('message_partner_ids', 'in', [user.partner_id.id])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_vendor_helpdesk_ticket_assigned" model="ir.rule">
            <field name="name">Vendor: assigned tickets only</field>
            <field name="model_id" ref="helpdesk.model_helpdesk_ticket"/>
            <field name="domain_force">[('partner_id', '=', user.partner_id.id)]</field>
            <!-- NOTE: Domain might change based on UX answer re: vendor assignments -->
            <field name="groups" eval="[(4, ref('kuec_portal_foundation.group_kuec_vendor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ========================================== -->
        <!-- INVOICES                                   -->
        <!-- ========================================== -->
        <record id="rule_portal_invoice_personal" model="ir.rule">
            <field name="name">Portal: own invoices only</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[('message_partner_ids', 'in', [user.partner_id.id]), ('move_type', 'in', ['out_invoice', 'out_receipt', 'in_invoice', 'in_receipt'])]</field>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- ========================================== -->
        <!-- VENDOR RECORDS                             -->
        <!-- ========================================== -->
        <record id="rule_vendor_partner_personal" model="ir.rule">
            <field name="name">Vendor: own partner record only</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[('id', 'child_of', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('kuec_portal_foundation.group_kuec_vendor'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
