}

/* UI-TAG-001 (FB-001h): Diagonal folded-corner ribbon (like screenshot)
   Use a standard 75x75 clipped corner so ribbon is visible and inside the card */
.wink-service-card,
.wink-catalogue-page-detail {
  position: relative;
  overflow: hidden;
}

.wink-ribbon-wrapper {
  position: absolute;
  top: -5px;
  right: -5px;
  width: 75px;
  height: 75px;
  overflow: hidden;
  z-index: 10;
  pointer-events: none;
}

.wink-ribbon {
  position: relative;
  display: block;
  left: -20px;
  top: 18px;
  width: 140px;
  padding: 4px 0;
  font-size: 0.7rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  color: #fff !important;
  text-align: center;
  white-space: nowrap;
  transform: rotate(45deg);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  /* default if no inline background */
  background: var(--wink-primary);
}

