/* Billing toggle */
.wink-billing-toggle-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  margin-bottom: 1.75rem;
}

.wink-toggle-label {
  font-size: 0.95rem;
