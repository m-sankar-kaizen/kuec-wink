<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
    View Inheritance: resource.calendar.form

    Purpose:
    This view extends the default working schedule (resource calendar) form to include
    a new field: `flexible_check_in`, allowing administrators to define how many hours
    of check-in buffer time are allowed per schedule.

    Field:
    - flexible_check_in:
      A float field displayed using the float_time widget, representing buffer hours
      (e.g., 0.5 for 30 minutes).
      It is rendered inside an inner group for layout clarity.

    UI Placement:
    - Inserted inside the existing group named "resource_details" which contains
      general configuration options for the resource calendar.
    -->

    <record id="resource_calendar_form" model="ir.ui.view">
        <field name="name">resource.calendar.view.form.inherit.flexible.working.hours</field>
        <field name="model">resource.calendar</field>
        <field name="inherit_id" ref="resource.resource_calendar_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='resource_details']" position="inside">
                <group>
                    <group>
                        <field name="flexible_check_in" widget="float_time"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
