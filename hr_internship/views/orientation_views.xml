<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_internship_orientation_form" model="ir.ui.view">
        <field name="name">hr.internship.orientation.form</field>
        <field name="model">hr.internship.orientation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Orientation Details">
                            <field name="internship_id" readonly="1" help="The internship being oriented"/>
                            <field name="orientation_date" required="1" help="Scheduled date for orientation session"/>
                            <field name="is_completed" help="Check when orientation has been completed"/>
                            <field name="completion_date" invisible="not is_completed" help="Actual date orientation was completed"/>
                        </group>
                        <group string="Materials">
                            <field name="materials_provided" help="List of materials provided to the intern (handbooks, forms, login credentials, etc.)"/>
                        </group>
                    </group>
                    <field name="notes" help="Any additional notes about the orientation session"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hr_internship_orientation_list" model="ir.ui.view">
        <field name="name">hr.internship.orientation.list</field>
        <field name="model">hr.internship.orientation</field>
        <field name="arch" type="xml">
            <list>
                <field name="internship_id"/>
                <field name="orientation_date"/>
                <field name="is_completed" widget="boolean"/>
                <field name="completion_date"/>
            </list>
        </field>
    </record>

    <record id="action_hr_internship_orientation" model="ir.actions.act_window">
        <field name="name">Orientations</field>
        <field name="res_model">hr.internship.orientation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
