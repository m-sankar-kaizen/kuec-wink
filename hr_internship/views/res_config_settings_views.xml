<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_hr_internship" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.hr.internship</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class,'o_settings_container')][1]" position="inside">
                <div class="o_setting_box">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <label for="reward_max_amount" string="Maximum Internship Award Amount"/>
                        <div class="text-muted">Upper limit for internship reward amounts (AED)</div>
                        <div class="content-group">
                            <field name="reward_max_amount" class="o_light_label"/>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
