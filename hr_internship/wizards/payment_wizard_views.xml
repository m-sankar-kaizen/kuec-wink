<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Payment Wizard -->
    <record id="view_hr_internship_payment_wizard_form" model="ir.ui.view">
        <field name="name">hr.internship.payment.wizard.form</field>
        <field name="model">hr.internship.payment.wizard</field>
        <field name="arch" type="xml">
            <form string="Process Payment">
                <group>
                    <group>
                        <field name="internship_id" readonly="True"/>
                        <field name="payment_type" required="True"/>
                        <field name="amount" readonly="True"/>
                    </group>
                    <group>
                        <field name="payment_method" required="True"/>
                        <field name="memo"/>
                    </group>
                </group>

                <group string="Accounting Entries">
                    <group>
                        <field name="account_id" required="True" help="Expense account to charge"/>
                    </group>
                    <group>
                        <field name="bank_account_id" required="True" help="Bank or Cash account to deduct from"/>
                    </group>
                </group>

                <footer>
                    <button name="action_create_payment" string="Create Payment" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
