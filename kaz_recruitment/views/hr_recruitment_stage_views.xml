<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
        Inherit Recruitment Stage Form View
        Purpose:
            Add a field `approval_groups_id` to each recruitment stage, allowing
            configuration of which user group is responsible for approving candidates
            at that stage.

        Usage:
            Displayed after the `template_id` field.
            The field is defined in Python as a Many2one to `res.groups`.
    -->
    <record id="hr_recruitment_stage_form" model="ir.ui.view">
        <field name="name">hr.recruitment.simple.form</field>
        <field name="model">hr.recruitment.stage</field>
        <field name="inherit_id" ref="hr_recruitment.hr_recruitment_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='template_id']" position="after">
                <field name="approval_groups_id"/>
                <field name="company_id"/>
            </xpath>
        </field>
    </record>

    <!--
        Inherit Applicant Form View
        Purpose:
            1. Replace the `stage_id` field with a statusbar widget and custom visibility logic.
            2. Add a `Next Stage` button to manually trigger stage advancement.

        Logic:
            - The `stage_id` is hidden when the applicant is inactive or not linked to an employee.
            - The `Next Stage` button is only shown if the application is still open.

        Behavior:
            - Drag-and-drop kanban movement is disabled separately to prevent bypassing group restrictions.
            - Button `change_state` should be defined in the Python model to implement stage transition logic.
    -->
    <record id="hr_applicant_view_form" model="ir.ui.view">
        <field name="name">hr.applicant.view.form.kaizen</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='stage_id']" position="replace">
                <field name="active" invisible="1"/>
                <field name="company_code" invisible="1"/>
                <field name="stage_id"
                       widget="statusbar"
                       domain="[('company_id', 'in', [company_id, False])]"
                       options="{'fold_field': 'fold'}"
                       invisible="not active or company_code != 'KUEC'"/>
                <field name="stage_id"
                       domain="[('company_id', 'in', [company_id, False])]"
                       widget="statusbar_duration"
                       options="{'clickable': '1', 'fold_field': 'fold'}"
                       invisible="(not active and not employee_id) or company_code == 'KUEC'"/>

                <button name="change_state"
                        type="object"
                        string="Next Stage"
                        class="oe_highlight"
                        invisible="date_closed or company_code != 'KUEC'"/>
            </xpath>
        </field>
    </record>

    <!--
        Inherit Kanban View: hr.applicant
        Purpose:
            Disable drag-and-drop functionality on the applicant kanban view to enforce
            stage transitions only via the `Next Stage` button and group approval logic.

        Effect:
            Prevents users from accidentally or intentionally skipping approval rules by dragging applicants between stages.
    -->
    <record id="hr_kanban_view_applicant" model="ir.ui.view">
        <field name="name">hr.applicant.view.kanban.kaizen</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_kanban_view_applicant"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="attributes">
                <attribute name="records_draggable">false</attribute>
            </xpath>
        </field>
    </record>

</odoo>
