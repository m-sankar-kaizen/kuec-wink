<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
        Inherit Form View: hr.job.form
        Purpose:
            Extend the job position form to include:
            - hr_sequence_id (readonly): shows which HR sequence is linked to the job.
            - activity_ids: to display planned activities on the job for tracking (via mail.activity.mixin).

        Depends On:
            - 'kaz_employees.add_job_code_employee_form' as base form view.
    -->
    <record id="view_hr_job_form" model="ir.ui.view">
        <field name="name">hr.job.form.kaizen</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="kaz_employees.add_job_code_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='grade_id']" position="after">
                <field name="hr_sequence_id" readonly="1"/>
            </xpath>
            <xpath expr="//group[@name='recruitment']/field[@name='company_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
<!--            <xpath expr="//field[@name='message_follower_ids']" position="after">-->
<!--                <field name="activity_ids"/>-->
<!--            </xpath>-->
        </field>
    </record>

    <!--
        Inherit Simple Job Form View
        Purpose:
            Ensure that users must select a sequence (required=True)
            when creating a job via simplified interface.
    -->
    <record id="hr_job_simple_form" model="ir.ui.view">
        <field name="name">hr.job.simple.form.kaizen</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr_recruitment.hr_job_simple_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="hr_sequence_id" required="1"/>
            </xpath>
        </field>
    </record>

    <!--
        HR Sequence Form View
        Purpose:
            Define form layout for HR Sequences.
            Hidden field: jobs_ids – may be used internally to count or reference related jobs.
    -->
    <record id="hr_sequence_form" model="ir.ui.view">
        <field name="name">hr.sequence.form.kaizen</field>
        <field name="model">hr.sequence</field>
        <field name="arch" type="xml">
            <form string="Hr Sequence">
                <sheet string="Hr Sequence">
                    <group>
                        <field name="name"/>
                        <field name="jobs_ids" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--
        HR Sequence Tree View
        Purpose:
            Display list of available HR sequences (name only).
    -->
    <record id="hr_sequence_tree" model="ir.ui.view">
        <field name="name">hr.sequence.list.kaizen</field>
        <field name="model">hr.sequence</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!--
        HR Sequence Action Window
        Purpose:
            Allows navigation to HR Sequence configuration via list/form views.
    -->
    <record model="ir.actions.act_window" id="action_hr_sequence">
        <field name="name">HR Sequence</field>
        <field name="res_model">hr.sequence</field>
        <field name="view_mode">list,form</field>
    </record>

    <!--
        HR Sequence Menu Item
        Purpose:
            Add "Sequence" as a submenu under Recruitment → Configuration → Job Positions
            to manage HR sequence records.
    -->
    <menuitem id="sequence_menu"
        name="Sequence"
        parent="hr_recruitment.menu_hr_recruitment_config_jobs"
        sequence="0"
        action="action_hr_sequence"/>

</odoo>
