<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="acting_delegation_wizard_view" model="ir.ui.view">
        <field name="name">acting.delegation.wizard.form</field>
        <field name="model">acting.delegation.wizard</field>
        <field name="arch" type="xml">
            <form string="Acting Delegation">
                <group>
                    <field name="leave_id" readonly="1"/>
                    <field name="employee_id" readonly="1"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="delegate_choice"/>
                    <field name="acting_employee_id" invisible="delegate_choice == 'no'"/>
                    <field name="group_ids" widget="many2many_tags" invisible="delegate_choice == 'no'"/>
                </group>
                <footer>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="acting_delegation_wizard_action" model="ir.actions.act_window">
        <field name="name">Acting Delegation</field>
        <field name="res_model">acting.delegation.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
