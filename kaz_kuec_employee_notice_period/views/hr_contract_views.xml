<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- This view extends the 'hr.contract' form view to include the 'notice_days' field -->
    <record id="hr_contract_view_form" model="ir.ui.view">
        <field name="name">hr.contract.view.form.inherit.hr.employee.updation</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_end']" position="after">

            <field name="notice_period"/>

            </xpath>
            <xpath expr="//field[@name='hr_responsible_id']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>
</odoo>
