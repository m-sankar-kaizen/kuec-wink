<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="res_config_settings_view_form_inherit_employee_probation" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.probation.period</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='employees_setting_container']"
                   position="after">
                <block title="Notice Period (KUEC)"
                       name="kuec_employee_notice_period"
                       invisible="company_code != 'KUEC'">
                    <setting id="employee_notice_period"
                             help="X number of days to be notice period for any employees in KUEC.">
                        <field name="employee_notice_period"/>
                        <div class="text-muted">
                            Number of days to be notice period of any employees in KUEC
                        </div>
                    </setting>
                    <setting id="remind_for_x_days_before_notice_end"
                             help="Number of days before the contract end date to send a reminder in KUEC.">
                        <field name="remind_for_x_days_before_notice_end"/>
                        <div class="text-muted">
                            Number of days before the Contract end date to send a reminder in KUEC
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>