  "sheets": [
    {
      "id": "Data",
      "name": "Data",
      "colNumber": 30,
      "rowNumber": 300,
      "isVisible": false,
      "cells": {
        "A1": { "content": "Gender" },
        "B1": { "content": "Count" },

        "A2": { "content": "Male" },
        "B2": { "content": "=IFERROR(PIVOT.VALUE(1,\"__count\"),0)" },

        "A3": { "content": "Female" },
        "B3": { "content": "=IFERROR(PIVOT.VALUE(2,\"__count\"),0)" },

        "A4": { "content": "Other" },
        "B4": { "content": "=IFERROR(PIVOT.VALUE(3,\"__count\"),0)" },

        "A5": { "content": "Not Mentioned" },
        "B5": { "content": "=IFERROR(PIVOT.VALUE(4,\"__count\"),0)" },

        "A6": { "content": "Total" },
        "B6": { "content": "=B2+B3+B4+B5" },

        "C2": { "content": "=IFERROR(TEXT(B2/(B6), \"0%\"), \"0%\")" },
        "C3": { "content": "=IFERROR(TEXT(B3/(B6), \"0%\"), \"0%\")"  },
        "C4": { "content": "=IFERROR(TEXT(B4/(B6), \"0%\"), \"0%\")" },
        "C5": { "content": "=IFERROR(TEXT(B5/(B6), \"0%\"), \"0%\")" },


        "A8": { "content": "Nationality" },
        "A9": { "content": "Expat" },
        "B9": { "content": "=IFERROR(PIVOT.VALUE(5,\"__count\"),0)" },

        "A10": { "content": "Local" },
        "B10": { "content": "=IFERROR(PIVOT.VALUE(6,\"__count\"),0)" },

        "A11": { "content": "Not Selected" },
        "B11": { "content": "=IFERROR(PIVOT.VALUE(7,\"__count\"),0)" },

        "A12": { "content": "Total" },
        "B12": { "content": "=B9+B10+B11" },

        "C9": { "content": "=IFERROR(TEXT(B9/(B12), \"0%\"), \"0%\")" },
        "C10": { "content": "=IFERROR(TEXT(B10/(B12), \"0%\"), \"0%\")"  },
        "C11": { "content": "=IFERROR(TEXT(B11/(B12), \"0%\"), \"0%\")" },

        "A14": { "content": "Average Age" },
        "B14": {
          "content": "=IFERROR(\n  ROUND(\n    PIVOT.VALUE(8,\"__sum_age\") / PIVOT.VALUE(8,\"__count\"),\n    1\n  ),\n  0\n)\n"
        },
          "A20": {
            "content": "[Age of Employees by Department (Top 10)](odoo://view/{\"viewType\":\"graph\",\"action\":{\"domain\":[[\"birthday\",\"!=\",false]],\"context\":{\"graph_groupbys\":[\"department_id\"],\"graph_measure\":\"age\",\"graph_mode\":\"bar\"},\"modelName\":\"hr.employee\",\"views\":[[false,\"pivot\"],[false,\"graph\"],[false,\"search\"]]},\"threshold\":0,\"name\":\"Employees Analysis\"})"
          },
          "A25": {
            "content": "=PIVOT(12, 10, FALSE())"
          },
          "D25": {
            "content": "=PIVOT(13, 10, FALSE())"
          }
        }

