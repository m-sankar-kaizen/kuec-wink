<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!--
        Record Rule: Loan Forms Modification by Accounting Users

        Kaizen Principle: Empowerment of Employees, Quality Control at Source

        This access control rule grants full CRUD (Create, Read, Update, Delete)
        permissions on the `hr.loan` model to users in the `account.group_account_user` group
        (typically Accounting users).

        Purpose:
        - Allow accountants to manage loan records directly for financial validation, approval,
          adjustment, and finalization.
        - Ensures accountability and avoids dependency on HR for accounting-specific actions.

        Attributes:
        - perm_read: Allows reading/viewing loan forms.
        - perm_write: Allows updating existing loan records.
        - perm_create: Allows creation of new loan entries.
        - perm_unlink: Allows deletion of loan entries.

        Group:
        - `account.group_account_user`: Core Odoo accounting users.

        Best Practices:
        - Do not assign this rule to `base.group_user` unless business logic requires open access.
        - Combine with model access rights (`ir.model.access.csv`) for tighter control.
    -->

    <record id="hr_loan_manager_account_rule" model="ir.rule">
        <field name="name">Loan Forms Modification Accounts</field>
        <field name="model_id" ref="model_hr_loan"/>
        <field name="groups" eval="[Command.link(ref('account.group_account_user'))]"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_read" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>

</odoo>
