<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Cron Job for Invoice Reminders -->
        <record id="ir_cron_lease_invoice_reminder" model="ir.cron">
            <field name="name">Lease: Send Invoice Reminders</field>
            <field name="model_id" ref="model_lease_lessee_contract"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_invoice_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
        
    </data>
</odoo>
