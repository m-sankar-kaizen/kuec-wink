<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Add Leasing Settings to Accounting Configuration -->
    <record id="view_account_config_settings_inherit_lease" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.lease</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']" position="inside">
                <block title="Leasing Management">
                    <setting id="lease_invoice_reminder_setting" help="Configure reminder days for lease invoice notifications">
                        <field name="lease_invoice_reminder_days"/>
                        <span> days before invoice due date</span>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
