<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Scheduled Action: Automatically finalize Acting Allowance records daily -->
    <record id="ir_cron_auto_finalise" model="ir.cron">
        <field name="name">Acting Allowance: Auto Finalise</field>
        <field name="model_id" ref="model_employee_acting_allowance"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_finalise()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
    </record>
</odoo>
