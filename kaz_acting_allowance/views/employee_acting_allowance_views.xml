<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- ==================== Tree View ==================== -->
    <record id="employee_acting_allowance_view_tree" model="ir.ui.view">
        <field name="name">employee.acting.allowance.view.list</field>
        <field name="model">employee.acting.allowance</field>
        <field name="arch" type="xml">
            <!-- Rows with renewable flag are highlighted in red -->
            <list decoration-danger="is_renewable == True">
                <field name="employee_id"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <field name="from_date"/>
                <field name="to_date"/>
                <field name="acting_job_id"/>
                <field name="is_renewable" invisible="1"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ==================== Form View ==================== -->
    <record id="employee_acting_allowance_view_form" model="ir.ui.view">
        <field name="name">employee.acting.allowance.view.form</field>
        <field name="model">employee.acting.allowance</field>
        <field name="arch" type="xml">
            <form string="Employee Acting Allowance">
                <header>
                    <!-- Buttons based on role and workflow state -->
                    <button name="action_send_for_hr_approval"
                            string="HR Approval" type="object"
                            invisible="state not in ['draft', 'department_head']"
                            class="btn-primary"
                            groups="kaz_acting_allowance.group_department_head"/>

                    <button name="action_send_for_ceo_approval"
                            string="CEO Approval" type="object"
                            invisible="state not in ['hr']"
                            class="btn-primary"
                            groups="kaz_acting_allowance.group_hr"/>

                    <button name="action_approve" string="Approve" type="object"
                            invisible="state not in ['draft', 'department_head', 'hr', 'ceo']"
                            class="btn-primary"
                            groups="kaz_acting_allowance.group_ceo"/>

                    <!-- Rejection buttons -->
                    <button name="action_reject_department_head" string="Reject"
                            type="object"
                            invisible="state not in ['department_head']"
                            groups="kaz_acting_allowance.group_department_head"
                            class="btn-secondary"/>

                    <button name="action_reject_hr" string="Reject"
                            type="object"
                            invisible="state not in ['hr']"
                            groups="kaz_acting_allowance.group_hr"
                            class="btn-secondary"/>

                    <button name="action_reject_ceo" string="Reject"
                            type="object"
                            invisible="state not in ['ceo']"
                            groups="kaz_acting_allowance.group_ceo"
                            class="btn-secondary"/>

                    <!-- Cancel, Reset -->
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ['draft']"
                            groups="kaz_acting_allowance.group_department_head"
                            class="btn-secondary"/>

                    <button name="action_reset" string="Reset to Draft" type="object"
                            invisible="state not in ['canceled']"
                            groups="kaz_acting_allowance.group_department_head"
                            class="btn-secondary"/>

                    <!-- Request Renewal based on is_renewable -->
                    <button name="action_request_renewal_head" string="Request for renewal"
                            type="object"
                            invisible="not is_renewable or state != 'approved'"
                            groups="kaz_acting_allowance.group_department_head,!kaz_acting_allowance.group_hr,!kaz_acting_allowance.group_ceo"
                            class="btn-primary"/>
                    <button name="action_request_renewal_hr" string="Request for renewal"
                            type="object"
                            invisible="not is_renewable or state != 'approved'"
                            groups="kaz_acting_allowance.group_hr,!kaz_acting_allowance.group_ceo"
                            class="btn-primary"/>
                    <button name="action_request_renewal_ceo" string="Request for renewal"
                            type="object"
                            invisible="not is_renewable or state != 'approved'"
                            groups="kaz_acting_allowance.group_ceo"
                            class="btn-primary"/>

                    <!-- Finalization -->
                    <button name="action_complete" string="Finalise" type="object"
                            invisible="state not in ['approved']"
                            groups="kaz_acting_allowance.group_ceo"
                            class="btn-secondary"/>

                    <!-- Statusbar tracking workflow state -->
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,hr,ceo,approved,completed,rejected,canceled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <!-- Employee shown differently based on user group -->
                            <field name="employee_id"
                                   groups="kaz_acting_allowance.group_department_head"
                                   readonly="state != 'draft'"/>
                            <field name="employee_id"
                                   groups="base.group_user,!kaz_acting_allowance.group_department_head"
                                   readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="job_id" options="{'no_open': True}"/>
                            <field name="is_renewable" invisible="1"/>
                            <field name="grade_id" options="{'no_open': True}"/>
                            <field name="department_id" options="{'no_open': True}"/>
                        </group>
                        <group>
                            <field name="acting_job_id"
                                   readonly="state != 'draft'"
                                   options="{'no_open': True}"/>
                            <field name="from_date" readonly="state != 'draft'"/>

                            <!-- To date editing based on roles -->
                            <field name="to_date"
                                   groups="kaz_acting_allowance.group_department_head,!kaz_acting_allowance.group_hr,!kaz_acting_allowance.group_ceo"
                                    readonly="state not in ['draft', 'department_head']"/>
                            <field name="to_date"
                                   groups="kaz_acting_allowance.group_hr,!kaz_acting_allowance.group_ceo"
                                   readonly="state not in ['draft','department_head','hr', 'ceo']"/>
                            <field name="to_date"
                                   groups="kaz_acting_allowance.group_ceo"
                                    readonly="state not in ['draft','department_head', 'ceo']"/>

                            <field name="instructions" readonly="state != 'draft'"/>
                            <field name="company_id" invisible="1"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="hr_responsible_id" required="1"
                                   readonly="state != 'draft'"/>
                            <field name="acting_allowance_percent" invisible="1"/>

                            <!-- Allowance amount display -->
                            <label for="acting_allowance_amount"/>
                            <div class="o_row mw-50" name="acting_allowance_amount">
                                <field name="acting_allowance_amount"
                                       class="oe_inline o_hr_narrow_field"
                                       nolabel="1"/>
                                <div class="mb-3">/ month</div>
                            </div>
                        </group>
                    </group>
                </sheet>

                <!-- Chatter for thread, activities -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ==================== Action Window ==================== -->
    <record id="action_acting_allowance" model="ir.actions.act_window">
        <field name="name">Employee Acting Allowance</field>
        <field name="res_model">employee.acting.allowance</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_no content_create">
                No Acting Allowance Requests.
            </p>
        </field>
    </record>

    <!-- ==================== Menu Item ==================== -->
    <menuitem name="Employee Acting Allowance"
              id="menu_employee_acting_allowance"
              action="action_acting_allowance"
              parent="ent_ohrms_loan.menu_hr_housing_advance"
              sequence="20"/>
</odoo>
