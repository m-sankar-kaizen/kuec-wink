<?xml version="1.0" encoding="utf-8"?>
<!--
    View Extension: Manual Currency Rate Fields in Purchase Order Form

    Purpose:
    - This XML view extends the standard `purchase.order` form view.
    - It adds support for manually applying a currency exchange rate at the purchase order level.
    - Useful for scenarios where a fixed or negotiated FX rate must be honored.

    Fields Added:
    1. `purchase_manual_currency_rate_active`: A checkbox to toggle manual currency rate entry.
    2. `purchase_manual_currency_rate`: The manually entered rate used for currency conversion.

    Behavior:
    - Both fields are inserted after the `partner_ref` field.
    - They are read-only when the purchase order is confirmed, done, or cancelled.
    - The rate field is only visible and required when the toggle is checked.
-->
<odoo>
    <!-- View modification record -->
    <record id="view_purchase_form_exchange_rate_field_add_inherit" model="ir.ui.view">
        <field name="name">view.purchase.form.exchange.rate.field.add.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <field name="currency_id" position="replace">
                <label for="currency_id" groups="base.group_multi_currency"/>
                <div name="journal_div" class="d-flex"
                     groups="base.group_multi_currency">
                    <div name="in_and_refresh_button_div" groups="base.group_multi_currency"
                         class="d-flex flex-column mx-3 text-center" style="width: 6ch;">
                        <field name="expected_currency_rate" invisible="1"/>
                        <div class="d-flex flex-column justify-content-center flex-grow-1"
                             invisible="state != 'draft' or purchase_manual_currency_rate == expected_currency_rate">
                            <button type="object" name="refresh_currency_rate" icon="fa-refresh"
                                    title="Refresh currency rate to the invoice date" class="btn btn-link p-0"/>
                        </div>
                    </div>
                    <div name="currency_div" groups="base.group_multi_currency" class="w-100">
                        <div class="d-flex gap-1">
                            <field name="currency_id" readonly="state != 'draft'" class="oe_inline"
                                   options="{'no_create': True}"
                                   context="{'search_default_active': 1, 'search_default_inactive': 1}"/>
                            <widget name="pick_currency_date" update_field="purchase_manual_currency_rate"
                                    invisible="state != 'draft' or currency_id == company_currency_id"/>
                        </div>
                        <div name="currency_conversion_div" class="d-flex gap-1 text-muted"
                             invisible="currency_id == company_currency_id">
                            <span>1</span>
                            <field name="company_currency_id" readonly="True" options="{'no_open': True}"
                                   class="w-auto"/>
                            <span>=</span>
                            <field name="purchase_manual_currency_rate" digits="[12,6]" readonly="state != 'draft'"/>
                            <field name="currency_id" readonly="True" options="{'no_open': True}" class="w-auto"/>
                        </div>
                    </div>
                </div>
            </field>
        </field>
    </record>
</odoo>
