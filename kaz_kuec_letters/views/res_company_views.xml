<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_company_form" model="ir.ui.view">
        <field name="name">res company</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="kaz_employee_reports.tab_in_res_company"/>
        <field name="arch" type="xml">
            <field name="employee_arabic_job_position" position="after">
                <field name="hr_email_address" invisible="company_code != 'KUEC'"/>
                <field name="public_relation_manager_id" invisible="company_code != 'KUEC'"/>
                <field name="public_relation_manager_arabic_name" invisible="company_code != 'KUEC'"/>
                <field name="public_relation_manager_arabic_job_position" invisible="company_code != 'KUEC'"/>
            </field>
        </field>
    </record>
</odoo>