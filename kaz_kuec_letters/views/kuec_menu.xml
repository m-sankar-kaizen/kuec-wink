    <menuitem id="kuec_letter_menu"
              name="KUEC Letters"
              parent="hr.menu_hr_root">
        <menuitem id="employment_letter_menu"
              name="Employment Letter"
              action="kaz_kuec_letters.action_kuec_employment_letters"/>
        <menuitem id="salary_transfer_letter_menu"
              name="Salary Transfer Letter"
              action="kaz_kuec_letters.action_kuec_salary_transfer_letters"/>
        <menuitem id="health_insurance_letter_menu"
              name="Health Insurance Letter"
              action="kaz_kuec_letters.action_kuec_health_insurance"/>
        <menuitem id="visa_request_letter_menu"
              name="Visa Request Letter"
              action="kaz_kuec_letters.action_kuec_visa_request"/>
        <menuitem id="golden_visa_letter_menu"
              name="Golden Visa Letter"
