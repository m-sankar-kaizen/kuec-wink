        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new visa request
            </p>
        </field>
    </record>

    <record id="action_kuec_health_insurance" model="ir.actions.act_window">
        <field name="name">KUEC Health Insurance</field>
        <field name="res_model">kuec.health.insurance</field>
