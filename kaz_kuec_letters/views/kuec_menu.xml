<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="action_kuec_golden_visa_letter" model="ir.actions.act_window">
        <field name="name">KUEC Golden Visa Letter</field>
        <field name="res_model">kuec.golden.visa.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Golden Visa Request
            </p>
        </field>
    </record>

