<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="kuec_health_insurance_list_view" model="ir.ui.view">
        <field name="name">kuec health insurance list</field>
        <field name="model">kuec.health.insurance</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence"/>
                <field name="employee_id"/>
                <field name="emp_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="kuec_health_insurance_form_view" model="ir.ui.view">
        <field name="name">kuec health insurance form</field>
        <field name="model">kuec.health.insurance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Submit" name="action_submit"
                            invisible="state != 'draft'" type="object"
                            class="oe_highlight"/>
                    <button string="Reset to Draft" name="action_reset"
                            invisible="state != 'submitted'" type="object"
                            class="btn btn_secondary"/>
                    <button string="Print" name="action_print"
                            invisible="state != 'submitted'" type="object"
                            class="oe_highlight"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,requested,approved,rejected,canceled"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="sequence"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="employee_id"
                                   readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   />
<!--                            <field name="employee_id"-->
<!--                                   groups="base.group_user,!kaz_employee_reports.group_hr_person,!kaz_employee_reports.hr_manager"-->
<!--                                   readonly="1"/>-->
                            <field name="date"
                                   readonly="1"/>
                            <field name="emp_id"/>
                        </group>
                        <group>
                            <field name="insurance_card_number"/>
                            <field name="insurance_provider_name"/>
                            <field name="policy_validity_date"/>
                            <field name="policy_number"/>
                            <field name="coverage_level_local_international"
                                   string="Local/International"/>
                            <field name="coverage_level_individual_family"
                                   string="Individual/Family"/>
                            <field name="all_children_ids" invisible="1"/>
                            <field name="spouse"
                                   invisible="coverage_level_individual_family != 'family'"/>
                            <field name="children_ids" widget="many2many_tags"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   invisible="coverage_level_individual_family != 'family'"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="justification"
                              string="Justification">
                            <field name="justification" placeholder="Add a justification..."/>
                        </page>
                        <page name="hr_signature"
                              string="Hr Signature and Stamp">
                            <field name="hr_signature" widget="image"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

</odoo>