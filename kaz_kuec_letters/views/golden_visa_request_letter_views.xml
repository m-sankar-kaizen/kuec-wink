<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="kuec_golden_visa_request_tree_view" model="ir.ui.view">
        <field name="name">kuec.golden.visa.request.list</field>
        <field name="model">kuec.golden.visa.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="employee_id"/>
                <field name="sequence"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="kuec_golden_visa_request_form_view" model="ir.ui.view">
        <field name="name">kuec.golden.visa.request.form</field>
        <field name="model">kuec.golden.visa.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button string="Submit" name="action_submit"
                            invisible="state != 'draft'" type="object"
                            class="oe_highlight"/>
                    <button string="Reset to Draft" name="action_reset"
                            invisible="state != 'submitted'" type="object"
                            class="btn btn_secondary"/>
                    <button string="Print" name="action_print"
                            invisible="state != 'submitted'" type="object"
                            class="oe_highlight"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="sequence"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="date" readonly="1"/>

                            <field name="employee_id"
                                   groups="kaz_employee_reports.group_letter_manager"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                   readonly="state != 'draft'"/>
                            <!-- Name field: read-only for regular users -->
                            <field name="employee_id"
                                   groups="base.group_user,!kaz_employee_reports.group_letter_manager"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                   readonly="1"/>
                        </group>
                        <group>
                            <field name="emp_id"/>
                            <field name="position_id"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="department_id"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="company_id"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="justification"
                              string="Justification">
                            <field name="justification" placeholder="Add a justification..."/>
                        </page>
                    </notebook>
                </sheet>
            <chatter/>
            </form>
        </field>
    </record>
</odoo>