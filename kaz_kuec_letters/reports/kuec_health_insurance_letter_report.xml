<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <template id="health_insurance_letter_report">
        <t t-call="web.report_layout">
            <t t-set="body_classname" t-value="'main_page'"/>
            <t t-foreach="docs" t-as="o">
                <t t-call="kaz_kuec_report_base.external_layout">
                    <t t-set="show_page" t-value="False"/>
                    <div class="page main_page page-div-14px">
                        <div class="px-2">
                            <h1 class="text-center english-text">Health Insurance Letter</h1>
                            <br/>
                            <table class="table english-text">

                                <tbody>
                                    <tr>
                                        <th scope="row">
                                            <span class="ms-1">Date:</span>
                                        </th>

                                        <td>

                                            <span t-field="o.date"/>

                                        </td>
                                        <th scope="row">
                                            <span class="ms-1">Request No:</span>
                                        </th>
                                        <td>

                                            <span t-field="o.sequence"/>
                                        </td>

                                    </tr>
                                    <tr>
                                        <th scope="row">
                                            <span class="ms-1">Employee Name:</span>
                                        </th>

                                        <td>

                                            <span t-field="o.employee_id.name"/>

                                        </td>
                                        <th scope="row">
                                            <span class="ms-1">Employee ID:</span>
                                        </th>
                                        <td>

                                            <span t-field="o.emp_id"/>
                                        </td>

                                    </tr>
                                    <tr>
                                        <th scope="row">
                                            <span class="ms-1">Position:</span>
                                        </th>

                                        <td>

                                            <span t-field="o.position_id"/>

                                        </td>
                                        <th scope="row">
                                            <span class="ms-1">Department:</span>
                                        </th>
                                        <td>

                                            <span t-field="o.department_id"/>
                                        </td>

                                    </tr>
                                    <tr>
                                        <th scope="row">
                                            <span class="ms-1">Email:</span>
                                        </th>

                                        <td>

                                            <span t-field="o.email"/>

                                        </td>
                                        <th scope="row">
                                            <span class="ms-1">Mobile:</span>
                                        </th>
                                        <td>

                                            <span t-field="o.mobile"/>
                                        </td>

                                    </tr>
                                </tbody>
                            </table>
                            <div class="mt-3">
                                <h3 class="padding-3">Insurance Details</h3>
                                <table class="table mt-3">
                                    <tbody>
                                        <tr>
                                            <th>

                                                <span class="ms-1">Insurance Card Number:</span>
                                            </th>

                                            <td>

                                                <span t-field="o.insurance_card_number"/>

                                            </td>

                                        </tr>
                                        <tr>
                                            <th>
                                                <span class="ms-1">Insurance Provider Name</span>
                                            </th>

                                            <td>

                                                <span t-field="o.insurance_provider_name"/>

                                            </td>


                                        </tr>
                                        <tr>
                                            <th scope="row">
                                                <span class="ms-1">Policy Validity Date :</span>
                                            </th>

                                            <td>

                                                <span t-field="o.policy_validity_date"/>

                                            </td>

                                        </tr>
                                        <tr>
                                            <th scope="row">
                                                <span class="ms-1">Policy Number :</span>
                                            </th>

                                            <td>

                                                <span t-field="o.policy_number"/>

                                            </td>

                                        </tr>
                                        <tr>
                                            <th scope="row">
                                                <span class="ms-1">Local/International :</span>
                                            </th>

                                            <td>

                                                <span t-field="o.coverage_level_local_international"/>

                                            </td>

                                        </tr>
                                        <tr>
                                            <th scope="row">
                                                <span class="ms-1">Individual/Family :</span>
                                            </th>

                                            <td>

                                                <span t-field="o.coverage_level_individual_family"/>

                                            </td>

                                        </tr>
                                    </tbody>

                                </table>
                            </div>

                            <div class="mt-3 text-center" t-if="o.hr_signature">
                                <h3>HR Signature &amp; Stamp
                                </h3>
                                <img t-att-src="image_data_uri(o.hr_signature)"
                                     style="height:150px; width:200px; text-align:center; "/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>


    <record id="action_report_kuec_health_insurance_letter_report" model="ir.actions.report">
        <field name="name">Health Insurance Letter</field>
        <field name="model">kuec.health.insurance</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">kaz_kuec_letters.health_insurance_letter_report</field>
        <field name="report_file">kaz_kuec_letters.health_insurance_letter_report</field>
        <field name="print_report_name">'KUEC Health Insurance Letter - %s - %s' % (object.sequence, object.date)</field>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="kaz_kuec_report_base.paperformat_kuec_letters"/>
    </record>
</odoo>