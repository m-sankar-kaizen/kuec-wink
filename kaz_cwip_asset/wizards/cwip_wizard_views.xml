<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="cwip_wizard_form" model="ir.ui.view">
            <field name="name">cwip.wizard.form</field>
            <field name="model">cwip.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="type" string="Type"/>
                        </group>
                    </group>
                    <group invisible="type != 'cwip_to_fixed_asset'"
                           string="Transfer CWIP to Fixed Asset">
                        <group>
                            <field name="asset_name"
                                   required="type == 'cwip_to_fixed_asset'"/>

                            <field name="asset_model_id"
                                   required="type == 'cwip_to_fixed_asset'"
                                   context="{
                                        'default_state': 'model'}"/>
                            <field name="cwip_journal_id"
                                   required="type == 'cwip_to_fixed_asset'"
                                    context="{
                                        'default_type': 'general'}"/>
                        </group>


                    </group>
                    <footer>
                        <button string="Confirm" name="confirm" type="object" class="oe_highlight" data-hotkey="q"/>
                        <button string="Cancel" class="btn btn-secondary" special="cancel" data-hotkey="x"/>
                    </footer>
                </form>
            </field>
        </record>


    </data>

</odoo>