<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_attendance_form" model="ir.ui.view">
        <field name="name">log.attendance.form</field>
        <field name="model">log.attendance</field>
        <field name="arch" type="xml">
            <form string="Attendance Log" edit="false">
                <sheet>
                    <group>
                        <field name="punch_id"/>
                        <field name="employee_id"/>
                        <field name="department_id"/>
                        <field name="punch_type"/>
                        <field name="punch_time"/>
                        <field name="is_biometric" widget="boolean_toggle"/>
                        <field name="company_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree view -->
    <record id="view_attendance_tree" model="ir.ui.view">
        <field name="name">log.attendance.list</field>
        <field name="model">log.attendance</field>
        <field name="arch" type="xml">
            <list string="Attendance Log" editable="bottom">
                <field name="punch_id" readonly="0"/>
                <field name="employee_id"/>
                <field name="emp_code"/>
                <field name="department_id"/>
                <field name="device_location"/>
                <field name="punch_type"/>
                <field name="punch_time"/>
                <field name="is_biometric" widget="boolean_toggle"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_search" model="ir.ui.view">
        <field name="name">log.attendance.search</field>
        <field name="model">log.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="employee_id"/>
                <field name="punch_type"/>
                <field name="punch_time"/>
                <separator/>
                <filter name="today" string="Today" domain="[
                    ('punch_time', '&lt;', (datetime.datetime.combine(context_today() + relativedelta(days=1), datetime.time(0,0,0)).to_utc())),
                    ('punch_time', '&gt;', (datetime.datetime.combine(context_today(), datetime.time(0,0,0)).to_utc())),
                    ]"/>
                <separator/>
                <filter string="Last 7 Days" name="week"
                        domain="[('punch_time','&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="Last 30 Days" name="month"
                        domain="[('punch_time','&gt;=', (context_today() - datetime.timedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <group expand="1" string="Group By">
                    <filter string="Date" name="group_by_date" context="{'group_by': 'punch_time'}"/>
                    <filter string="Department" name="group_by_department" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_attendance" model="ir.actions.act_window">
        <field name="name">Attendance Log</field>
        <field name="res_model">log.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_today':1, 'create': False, 'delete': False, 'edit': False}</field>
    </record>

    <menuitem id="menu_attendance"
              name="Attendance Integration"
              groups="hr_attendance.group_hr_attendance_own_reader"
              parent="hr_attendance.menu_hr_attendance_root"/>

    <menuitem id="menu_attendance_list"
              name="Attendance Log"
              parent="menu_attendance"
              groups="hr_attendance.group_hr_attendance_own_reader"
              action="action_attendance"
              sequence="10"/>

</odoo>
