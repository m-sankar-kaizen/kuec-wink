<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="idc_account_mapping_company_configration" model="ir.ui.view">
        <field name="name">res.company.form.inherit.attendance.api</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='general_info']" position="after">
                <page name="integration" string="Integration">
                    <group col="4" colspan="2">
                        <field name="attendance_token"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
