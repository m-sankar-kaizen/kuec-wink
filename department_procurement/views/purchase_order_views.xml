<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_order_view_form" model="ir.ui.view">
        <field name="name">purchase.order.form.view.form</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='products']/field[@name='order_line']/list/field[@name='product_id']" position="after">
                <field name="related_department_procurement_plan_items_id"
                       options="{'no_create': True}"
                       domain="[('company_id', '=', company_id),('status', '=', 'submitted'), ('master_plan_status', '=', 'active')]"/>
            </xpath>
        </field>
    </record>
</odoo>