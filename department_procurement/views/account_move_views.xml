<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="related_department_procurement_plan_items_id"
                       column_invisible="parent.move_type not in ('in_invoice', 'in_refund', 'in_receipt')"/>
            </xpath>
        </field>
    </record>
</odoo>