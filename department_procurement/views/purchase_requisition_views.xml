<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="material_purchase_requisition_form_view" model="ir.ui.view">
        <field name="name">material.purchase.requisition.view.form</field>
        <field name="model">material.purchase.requisition</field>
        <field name="inherit_id" ref="material_purchase_requisitions.material_purchase_requisition_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_title')]" position="before">
                <field name="warning_field" nolabel="1" readonly="1"/>
                <field name="company_code" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='requisition_line_ids']//list/field[@name='product_id']" position="before">
                <field name="company_code" column_invisible="1"/>
                <field name="in_master_plan"
                       required="parent.company_code == 'KUEC'"
                       column_invisible="parent.company_code != 'KUEC'"/>
                <field name="related_department_procurement_plan_items_id"
                       required="in_master_plan == 'yes' and parent.company_code == 'KUEC'"
                       column_invisible="parent.company_code != 'KUEC'"
                       invisible="in_master_plan == 'no'"
                       options="{'no_create': True}"
                       domain="[('company_id', '=', company_id),('status', '=', 'submitted'), ('master_plan_status', '=', 'active')]"/>
            </xpath>
        </field>
    </record>
</odoo>