<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================
         Tree View: HR Loan Requests
         Purpose: Shows all loan requests in list format.
    ============================================ -->
    <record id="hr_loan_tree_view" model="ir.ui.view">
        <field name="name">hr.loan.list</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <list string="Loan Requests">
                <field name="name"/>
                <field name="employee_id" options="{'no_create': True, 'no_create_edit': True}"/>
                <field name="loan_amount"/>
                <field name="date"/>
                <field name="fully_paid"/>
                <field name="state"/>
                <field name="balance_amount"/>
            </list>
        </field>
    </record>

    <!-- ============================================
         Form View: HR Loan Request
         Purpose: Capture and manage a housing loan request
         Contains:
         - Conditional buttons based on state and user group
         - Tabs for installment tracking and refusal notes
         - Attachment field for documentation
    ============================================ -->
    <record id="hr_loan_form_view" model="ir.ui.view">
        <field name="name">hr.loan.form</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <form string="Loan Request">
                <header>
                    <!-- Compute installments button: visible until approval/refusal -->
                    <button name="compute_installment"
                            type="object"
                            string="Compute Installment"
                            class="oe_highlight"
                            invisible="state in ['approve', 'refuse']"/>


                    <!-- Submit button: shown only in draft -->
                    <button name="action_submit" type="object" string="Submit" invisible="state != 'draft'"
                            class="oe_highlight"/>

                    <!-- Approve button: visible to HR team -->
                    <button name="action_approve" type="object" string="Hr Approve"
                            invisible="state != 'waiting_approval_1'"
                            class="oe_highlight" groups="ent_ohrms_loan.group_loan_branch_manager"/>

                    <!-- Refuse button: visible to HR team -->
                    <button name="action_refuse" type="object" string="Refuse"
                            invisible="state not in ['draft', 'waiting_approval_1']"
                            class="oe_highlight" groups="ent_ohrms_loan.group_loan_branch_manager"/>

                    <!-- statusbar showing current loan state -->
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <!-- General info -->
                    <group col="4">
                        <!-- Employee info, conditional read-only -->
                        <field name="employee_id" groups="hr.group_hr_user" readonly="state != 'draft'"
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="employee_id" groups="base.group_user,!hr.group_hr_user" readonly="1"
                               options="{'no_open': True}"/>

                        <field name="date" readonly="1"/>
                        <field name="department_id" options="{'no_open': True}"/>
                        <field name="job_position" options="{'no_open': True}"/>
                        <field name="hire_date"/>
                        <field name="over_under"/>
                        <field name="employee_contract" options="{'no_open': True}"/>
                        <field name="contract_start"/>
                        <field name="contract_end"/>
                        <field name="grade_id" options="{'no_open': True}"/>

                        <!-- Hidden fields -->
                        <field name="is_housing_advance" invisible="1"/>
                        <field name="fully_paid" invisible="1"/>

                        <!-- Loan-specific fields -->
                        <field name="loan_amount" readonly="state != 'draft'"/>
                        <field name="installment" readonly="state != 'draft'"/>
                        <field name="payment_date" readonly="state != 'draft'"/>

                        <!-- Company and currency -->
                        <field name="company_id" readonly="state != 'draft'"
                               options="{'no_create': True, 'no_open': True}"
                               groups="base.group_multi_company"/>
                        <field name="currency_id" options="{'no_create': True, 'no_open': True}"
                               groups="base.group_multi_company"
                               readonly="state != 'draft'"/>

                        <!-- Required loan attachment -->
                        <field name="attachment" filename="file_name" required="1"
                               readonly="state != 'draft'"/>
                        <field name="file_name" invisible="1"/>
                    </group>

                    <!-- Tabs: Installments + Refusal -->
                    <notebook>
                        <page string="Installments">
                            <field name="loan_lines" readonly="state != 'draft'">
                                <list string="Installments" editable="bottom">
                                    <field name="date"/>
                                    <field name="paid" readonly="1"/>
                                    <field name="amount"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right" colspan="2">
                                <field name="total_amount" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="total_paid_amount" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                                <field name="balance_amount" class="oe_subtotal_footer_separator" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </page>

                        <page string="Refusal Reason" invisible="not refuse_reason_ids">
                            <field name="refuse_reason_ids" readonly="1">
                                <list>
                                    <field name="reason"/>
                                    <field name="refused_by_user_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter for notes and messages -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ============================================
         Search View: HR Loan
         Purpose: Provide search filters and groupings
    ============================================ -->
    <record id="view_loan_request_search_form" model="ir.ui.view">
        <field name="name">hr.loan.search.form</field>
        <field name="model">hr.loan</field>
        <field name="arch" type="xml">
            <search string="Loan">
                <filter string="My Requests" name="myrequest" domain="[('employee_id.user_id.id', '=', uid)]"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <filter string="Employee" name="employee_id" context="{'group_by':'employee_id'}"/>
                <filter string="Department" name="department_id" context="{'group_by':'department_id'}"/>
                <filter string="Status" name="status" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>

    <!-- ============================================
         Menu: Housing Advance
         Purpose: Adds "Housing Advance" menu under HR
    ============================================ -->
    <menuitem name="Employee Benefits"
              id="menu_hr_housing_advance"
              parent="hr.menu_hr_root"
              sequence="20"/>

    <record id="action_hr_loan_request" model="ir.actions.act_window">
        <field name="name">Housing Advance</field>
        <field name="res_model">hr.loan</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_myrequest': 1}</field>
        <field name="search_view_id" ref="view_loan_request_search_form"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">Click to create a new Housing Advance request.</p>
            <p>Use this menu to create Housing Advance requests.</p>
        </field>
    </record>

    <menuitem name="Housing Advance"
              id="menu_housing_advance"
              parent="menu_hr_housing_advance"
              action="action_hr_loan_request"
              sequence="1"
              groups="ent_ohrms_loan.hr_loan_user"/>

    <!-- ============================================
         Shortcut Action: View Loan From Employee Form
         Purpose: Displays all loan requests from employee profile
    ============================================ -->
    <record id="act_hr_employee_loan_request" model="ir.actions.act_window">
        <field name="name">Housing advance</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.loan</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_myloan': 1}</field>
        <field name="domain">[('employee_id', '=', active_id)]</field>
        <field name="view_id" eval="hr_loan_tree_view"/>
    </record>

</odoo>
