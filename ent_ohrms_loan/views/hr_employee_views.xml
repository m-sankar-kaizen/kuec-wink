<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- ============================================
         Inherited View: Add Loan Stat Button on Employee Form
    ============================================ -->
    <record id="view_employee_form_loan_inherit" model="ir.ui.view">
        <field name="name">hr.employee.loan.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="%(act_hr_employee_loan_request)d"
                        type="action"
                        class="oe_stat_button"
                        icon="fa-calendar"
                        groups="ent_ohrms_loan.hr_loan_user">
                    <field name="loan_count" widget="statinfo" string="Housing advance"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>