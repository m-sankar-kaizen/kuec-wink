<?xml version="1.0" ?>
<odoo>
    <!-- ===============================================================
         Sequence Definition for Housing Advance (Loan Request)
         Model: ir.sequence
         Purpose:
           - Automatically generate unique, readable loan reference numbers.
           - Used in hr.loan model via `name` field to ensure traceability.
    ================================================================ -->
    <record id="ir_seq_hr_loan" model="ir.sequence">
        <field name="name">Housing Advance</field>
        <field name="code">hr.loan.seq</field>
        <field name="prefix">ANK-HA/</field>
        <field name="padding">3</field>
        <field name="number_increment">1</field>
        <field name="number_next_actual">1</field>
        <field name="implementation">standard</field>
    </record>

</odoo>
