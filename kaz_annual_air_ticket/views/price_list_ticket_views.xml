<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- =========================== -->
    <!-- Form View: Ticket Price List -->
    <!-- =========================== -->
    <record model="ir.ui.view" id="price_list_ticket_form_view">
        <field name="name">price_list_ticket_form_view</field>
        <field name="model">price.list.ticket</field>
        <field name="arch" type="xml">
            <form>
                <!-- Header Buttons for Workflow States -->
                <header>
                    <button string="Confirm" class="oe_highlight" type="object" name="action_confirm"
                            invisible="state != 'draft'"/>
                    <button string="Cancel" class="oe_highlight" type="object" name="action_cancel"
                            invisible="state != 'confirm'"/>
                    <button string="Mark As Draft" type="object" name="action_draft"
                            invisible="state not in ['confirm', 'cancel']"/>
                    <field name="state" widget="statusbar" optional="{'clickable': 1}"/>
                </header>

                <sheet>
                    <!-- Document Title -->
                    <div class="oe_title">
                        <h1>
                            <field name="name" nolabel="1" readonly="1"/>
                        </h1>
                    </div>

                    <!-- Main Form Groups -->
                    <group>
                        <!-- Date Range for Ticket Validity -->
                        <group string="Details">
                            <field name="start_date" readonly="state == 'confirm'"/>
                            <field name="end_date" readonly="state == 'confirm'"/>
                        </group>

                        <!-- Related Ticket Type -->
                        <group string="Accompanies">
                            <field name="ticket_type_id" readonly="state == 'confirm'"/>
                        </group>
                    </group>

                    <!-- Notebook Page for Price List Lines -->
                    <notebook>
                        <page string="Price List Lines" name="price_list_lines">
                            <field name="ticket_lines_ids" readonly="state == 'confirm'">
                                <list editable="bottom">
                                    <field name="id_no"/>
                                    <field name="destination_id"/>
                                    <field name="code"/>
                                    <field name="adults"/>
                                    <field name="children"/>
                                    <field name="infant"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter Support -->
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ========================== -->
    <!-- Tree View: Ticket Price List -->
    <!-- ========================== -->
    <record model="ir.ui.view" id="price_list_ticket_list_view">
        <field name="name">price_list_list_view</field>
        <field name="model">price.list.ticket</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="ticket_type_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <!-- ============================ -->
    <!-- Action: Price List Ticket Menu -->
    <!-- ============================ -->
    <record model="ir.actions.act_window" id="price_list_ticket_action">
        <field name="name">Price List Ticket</field>
        <field name="res_model">price.list.ticket</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
