<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Partner Category Form View -->
    <record id="view_partner_category_form" model="ir.ui.view">
        <field name="name">partner.category.form</field>
        <field name="model">partner.category</field>
        <field name="arch" type="xml">
            <form string="Partner Category">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" groups="base.group_multi_company" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Partner Category List View -->
    <record id="view_partner_category_list" model="ir.ui.view">
        <field name="name">partner.category.list</field>
        <field name="model">partner.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_partner_category" model="ir.actions.act_window">
        <field name="name">Partner Categories</field>
        <field name="res_model">partner.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_partner_category_items" name="Categories"
              parent="kaz_contact_approval.menu_contact_checklist_root"
              action="action_partner_category"
              sequence="3"/>

    <menuitem id="menu_purchase_vendor_root" name="Vendors"
              parent="purchase.menu_purchase_config"
              sequence="10"/>

    <menuitem id="menu_purchase_partner_category_items" name="Categories"
              parent="menu_purchase_vendor_root"
              action="action_partner_category"
              sequence="1"/>
</odoo>
