<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_partner_checklist_conf_list" model="ir.ui.view">
        <field name="name">partner.checklist.conf.list</field>
        <field name="model">partner.checklist.conf</field>
        <field name="arch" type="xml">
            <list edit="1" create="1" editable="bottom">
                <field name="name" width="500px;"/>
                <field name="for_customer" widget="boolean_toggle"/>
                <field name="for_vendor" widget="boolean_toggle"/>
                <field name="company_id" groups="base.group_multi_company" readonly="1" optional="hidden"/>
            </list>
        </field>
    </record>

    <record id="action_partner_checklist_conf" model="ir.actions.act_window">
        <field name="name">Partner Checklist</field>
        <field name="res_model">partner.checklist.conf</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_partner_checklist" name="Partner Checklist"
              parent="kaz_contact_approval.menu_contact_checklist_root"
              action="action_partner_checklist_conf"
              sequence="2"/>
</odoo>