<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Form View -->
    <record id="view_srn_report_template_form" model="ir.ui.view">
        <field name="name">srn.report.template.form</field>
        <field name="model">srn.report.template</field>
        <field name="arch" type="xml">
            <form string="SRN Report Template">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id" readonly="1"/>
                        <field name="company_code" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Template Lines">
                            <field name="srn_report_template_line_ids">
                                <list string="SRN Template Line" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="answer_selection_ids" widget="many2many_tags" required="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_srn_report_template_list" model="ir.ui.view">
        <field name="name">srn.report.template.list</field>
        <field name="model">srn.report.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="action_srn_report_template" model="ir.actions.act_window">
        <field name="name">SRN Report Templates</field>
        <field name="res_model">srn.report.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your SRN Report Templates here.
            </p>
        </field>
    </record>

    <menuitem id="menu_srn_management_root" name="SRN Management"
              parent="purchase.menu_purchase_config"
              sequence="10"/>

    <!-- Menu Item under an existing parent menu (adjust parent as needed) -->
    <menuitem id="menu_srn_report_template_root"
              name="SRN Report Templates"
              parent="menu_srn_management_root"
              action="action_srn_report_template"
              sequence="10"/>

</odoo>
