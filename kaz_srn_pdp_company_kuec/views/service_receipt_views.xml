<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="service_receipt_view_form" model="ir.ui.view">
        <field name="name">service.receipt.view.form.inherit.kaz.srn.pdp.company.kuec</field>
        <field name="model">service.receipt</field>
        <field name="inherit_id" ref="skit_srn_receipt.service_receipt_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form//sheet//group/group" position="inside">
                <field name="company_id" readonly="1" groups="base.group_multi_company"/>
                <field name="company_code" invisible="1"/>
            </xpath>

<!--            <page name="signature" position="attributes">-->
<!--                <attribute name="invisible">company_code in ['KUEC']</attribute>-->
<!--            </page>-->

            <button name="service_completion_report" position="attributes">
                <attribute name="invisible" add="company_code in ['KUEC']" separator="or"/>
            </button>

        </field>
    </record>
</odoo>
