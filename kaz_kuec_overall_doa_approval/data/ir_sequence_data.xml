<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="seq_write_off_request" model="ir.sequence">
        <field name="name">Write Off Request</field>
        <field name="code">write.off.request</field>
        <field name="prefix">WOFFR/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_asset_depreciation_request" model="ir.sequence">
        <field name="name">Account Asset Depreciation Request</field>
        <field name="code">account.asset.depreciation</field>
        <field name="prefix">ADEP/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_settlement_request" model="ir.sequence">
        <field name="name">Settlement Request</field>
        <field name="code">settlement.request</field>
        <field name="prefix">SETTLE/%(year)s/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>