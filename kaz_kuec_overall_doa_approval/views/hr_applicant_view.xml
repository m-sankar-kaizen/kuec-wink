<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_applicant_view_form" model="ir.ui.view">
        <field name="name">hr.applicant.form</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <form position="attributes">
                <attribute name="js_class">readonly_form_view</attribute>
            </form>

            <button name="archive_applicant" position="attributes">
                <attribute name="invisible" add="company_code in ['KUEC'] and kuec_approval_state != 'draft'"
                           separator="or"/>
            </button>

            <button name="create_employee_from_applicant" position="before">

                <field name="company_code" invisible="1"/>
                <field name="is_readonly" invisible="1"/>
                <button name="submit_for_approval"
                        invisible="not is_approval_stage or kuec_approval_state != 'draft' or company_code not in ['KUEC']"
                        groups="hr.group_hr_user"
                        class="btn btn-primary" string="Submit for Approval" type="object"/>
                <button name="action_lock" groups="kaz_procurement_doa_kuec.group_kuec_head_department" class="btn" string="Lock"
                        invisible="is_readonly or kuec_approval_state == 'draft' or company_code not in ['KUEC']"
                        type="object"/>
                <button name="action_unlock" groups="kaz_procurement_doa_kuec.group_kuec_head_department" class="btn" string="Unlock"
                        invisible="not is_readonly or kuec_approval_state == 'draft' or company_code not in ['KUEC']"
                        type="object"/>

                <button name="action_hod_approval"
                        invisible="kuec_approval_state != 'department_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_head_department"
                        class="btn btn-primary" string="HOD Approve" type="object"/>
                <button name="action_hod_reject"
                        invisible="kuec_approval_state != 'department_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_head_department"
                        class="btn btn-danger" string="Reject" type="object"/>
                <button name="action_hod_rfc"
                        invisible="kuec_approval_state != 'department_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_head_department"
                        class="btn" string="Return for Correction" type="object"/>

                <button name="action_ccoe_approval"
                        invisible="kuec_approval_state != 'ccoe_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_ccoe"
                        class="btn btn-primary" string="CCOE Approve" type="object"/>
                <button name="action_reject_request"
                        invisible="kuec_approval_state != 'ccoe_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_ccoe"
                        class="btn btn-danger" string="Reject" type="object"/>
                <button name="action_rfc_request"
                        invisible="kuec_approval_state != 'ccoe_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_ccoe"
                        class="btn" string="Return for Correction" type="object"/>

                <button name="action_final_approval"
                        invisible="kuec_approval_state != 'ceo_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_ceo"
                        class="btn btn-primary" string="CEO Approve" type="object"/>
                <button name="action_reject_request"
                        invisible="kuec_approval_state != 'ceo_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_ceo"
                        class="btn btn-danger" string="Reject" type="object"/>
                <button name="action_rfc_request"
                        invisible="kuec_approval_state != 'ceo_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_ceo"
                        class="btn" string="Return for Correction" type="object"/>

                <button name="action_board_approval"
                        invisible="kuec_approval_state != 'board_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_board"
                        class="btn btn-primary" string="Board Approve" type="object"/>
                <button name="action_reject_request"
                        invisible="kuec_approval_state != 'board_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_board"
                        class="btn btn-danger" string="Reject" type="object"/>
                <button name="action_rfc_request"
                        invisible="kuec_approval_state != 'board_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_board"
                        class="btn" string="Return for Correction" type="object"/>

                <field name="kuec_approval_state"
                       invisible="company_code != 'KUEC'"
                       widget="statusbar" statusbar_visible="draft,approved"/>

            </button>

            <page name="application_details" position="after">
                <page name="applicant_approval" string="Signed Approval History"
                      invisible="not applicant_approval_ids or company_code not in ['KUEC']">
                    <field name="applicant_approval_ids">
                        <list editable="bottom" create="0" edit="0" delete="0">
                            <field name="current_display_name" column_invisible="1"/>
                            <field name="sequence"/>
                            <field name="parent_state_at_request" optional="show"/>
                            <field name="request_type"/>
                            <field name="create_uid" string="Signed By"/>
                            <field name="create_date" string="Signed At" optional="hide"/>
                            <field name="signature" widget="signature"
                                   options="{'full_name': 'current_display_name','size': [150, 50]}"/>
                            <field name="reason"/>
                            <field name="company_id" optional="hide"/>
                        </list>
                    </field>
                </page>
                <page name="kuec_board_attachment" string="KUEC Board/Shareholder Approval Attachment"
                      invisible="hide_board_approval_attachment or company_code not in ['KUEC']">
                    <field name="hide_board_approval_attachment" invisible="1"/>
                    <group>
                        <group>
                            <field name="kuec_board_attachment" readonly="kuec_approval_state != 'board_approval'"
                                   widget="binary"/>
                            <field name="kuec_shareholder_attachment"
                                   readonly="kuec_approval_state != 'board_approval'"
                                   widget="binary"/>
                        </group>
                    </group>
                </page>
            </page>

        </field>
    </record>

    <record id="hr_applicant_view_form_inherit_staffing_plan" model="ir.ui.view">
        <field name="name">hr.applicant.form</field>
        <field name="model">hr.applicant</field>
        <field name="inherit_id" ref="kaz_kuec_recruitment_staffing_plan.hr_applicant_view_form"/>
        <field name="arch" type="xml">
            <field name="approved_hiring_request_id" position="attributes">
                <attribute name="required">is_approval_stage and company_code in ['KUEC']</attribute>
            </field>
        </field>
    </record>
</odoo>