<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_internship_reward_form" model="ir.ui.view">
        <field name="name">hr.internship.reward.form.inherit.kaz.kuec.overall.doa.approval</field>
        <field name="model">hr.internship.reward</field>
        <field name="inherit_id" ref="hr_internship.view_hr_internship_reward_form"/>
        <field name="arch" type="xml">
            <button name="action_approve" position="attributes">
                <attribute name="groups">kaz_procurement_doa_kuec.group_kuec_ceo</attribute>
            </button>
            <button name="action_reject" position="attributes">
                <attribute name="groups">kaz_procurement_doa_kuec.group_kuec_ceo</attribute>
            </button>
            <button name="action_reject" position="before">
                <button name="action_rfc_request" string="Return for Correction" type="object" invisible="state != 'pending_approval'"/>
            </button>
            <group name="payment_detail" position="after">
                <notebook>
                    <page name="reward_approval" string="Signed Approval History"
                          invisible="not reward_approval_ids">
                        <field name="reward_approval_ids">
                            <list editable="bottom" create="0" edit="0" delete="0">
                                <field name="current_display_name" column_invisible="1"/>
                                <field name="sequence"/>
                                <field name="parent_state_at_request" optional="show"/>
                                <field name="request_type"/>
                                <field name="create_uid" string="Signed By"/>
                                <field name="create_date" string="Signed At" optional="hide"/>
                                <field name="signature" widget="signature"
                                       options="{'full_name': 'current_display_name','size': [150, 50]}"/>
                                <field name="reason"/>
                                <field name="company_id" optional="hide"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </group>
        </field>
    </record>
</odoo>
