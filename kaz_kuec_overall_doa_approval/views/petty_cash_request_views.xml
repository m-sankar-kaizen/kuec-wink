<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_petty_approval_form" model="ir.ui.view">
        <field name="name">petty.cash.request.form.inherit.kaz.kuec.overall.doa.approval</field>
        <field name="model">petty.cash.request</field>
        <field name="inherit_id" ref="expense_funding.view_petty_approval_form"/>
        <field name="arch" type="xml">

            <field name="state" position="before">
                <field name="kuec_approval_state" widget='statusbar' statusbar_visible="draft,approved"/>
            </field>

            <button name="petty_cash_settlement" position="replace">
                <button name="submit_for_approval"
                        type="object"
                        string="Submit for Reconcile" class="btn-primary"
                        invisible="state != 'complete' or not in_settlement"
                        groups="account.group_account_user"/>
            </button>

            <div name="button_box" position="inside">
                <button name="action_open_settlements" class="oe_stat_button" icon="fa-list" type="object"
                        invisible="not settlement_request_ids">
                    <div class="o_stat_info">
                        <field name="settlement_request_ids" invisible="1"/>
                        <span class="o_stat_text">Settlement Requests</span>
                    </div>
                </button>
            </div>

            <button name="action_reject" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>

            <button name="action_approve" position="attributes">
                <attribute name="invisible" add="kuec_approval_state != 'approved'" separator="or"/>
            </button>

            <button name="action_approve" position="after">

                <button name="submit_again"
                        string="Submit Again" type="object" class="oe_highlight"
                        invisible="kuec_approval_state != 'draft'"/>

                <button name="action_head_fin_approval"
                        string="Head of Finance &amp; Procurement Approve" type="object" class="oe_highlight"
                        groups="kaz_procurement_doa_kuec.group_kuec_head_fin_procurement"
                        invisible="kuec_approval_state != 'finance_procurement_approval'"/>
                <button name="action_reject_request"
                        invisible="kuec_approval_state != 'finance_procurement_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_head_fin_procurement"
                        class="btn btn-danger" string="Reject" type="object"/>
                <button name="action_rfc_request"
                        invisible="kuec_approval_state != 'finance_procurement_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_head_fin_procurement"
                        class="btn" string="Return for Correction" type="object"/>

                <button name="action_ccoe_approval"
                        string="CCOE Approve" type="object" class="oe_highlight"
                        groups="kaz_procurement_doa_kuec.group_kuec_ccoe"
                        invisible="kuec_approval_state != 'ccoe_approval'"/>
                <button name="action_reject_request"
                        invisible="kuec_approval_state != 'ccoe_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_ccoe"
                        class="btn btn-danger" string="Reject" type="object"/>
                <button name="action_rfc_request"
                        invisible="kuec_approval_state != 'ccoe_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_ccoe"
                        class="btn" string="Return for Correction" type="object"/>

                <button name="action_ceo_approval"
                        string="CEO Approve" type="object" class="oe_highlight"
                        groups="kaz_procurement_doa_kuec.group_kuec_ceo"
                        invisible="kuec_approval_state != 'ceo_approval'"/>
                <button name="action_reject_request"
                        invisible="kuec_approval_state != 'ceo_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_ceo"
                        class="btn btn-danger" string="Reject" type="object"/>
                <button name="action_rfc_request"
                        invisible="kuec_approval_state != 'ceo_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_ceo"
                        class="btn" string="Return for Correction" type="object"/>
            </button>

            <xpath expr="//page[last()]" position="after">
                <page name="petty_cash_approval" string="Signed Approval History"
                      invisible="not petty_cash_approval_ids">
                    <field name="petty_cash_approval_ids">
                        <list editable="bottom" create="0" edit="0" delete="0">
                            <field name="current_display_name" column_invisible="1"/>
                            <field name="sequence"/>
                            <field name="parent_state_at_request" optional="show"/>
                            <field name="request_type"/>
                            <field name="create_uid" string="Signed By"/>
                            <field name="create_date" string="Signed At" optional="hide"/>
                            <field name="signature" widget="signature"
                                   options="{'full_name': 'current_display_name','size': [150, 50]}"/>
                            <field name="reason"/>
                            <field name="company_id" optional="hide"/>
                        </list>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>