<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_recruitment_stage_form_inherit_referral" model="ir.ui.view">
        <field name="name">hr.recruitment.stage.form.inherit.kaz.kuec.overall.doa.approval</field>
        <field name="model">hr.recruitment.stage</field>
        <field name="inherit_id" ref="hr_recruitment.hr_recruitment_stage_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hired_stage']" position="after">
                <field name="is_approval_stage" invisible="company_code != 'KUEC'"/>
            </xpath>
        </field>
    </record>
</odoo>