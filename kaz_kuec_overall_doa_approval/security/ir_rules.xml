<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="register_form_comp_rule" model="ir.rule">
        <field name="name">Resignation multi-company</field>
        <field name="model_id" ref="model_register_form"/>
        <field name="domain_force">[('emp_company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_kuec_hod_see_register_form" model="ir.rule">
        <field name="name">KUEC: HOD Resignation</field>
        <field name="model_id" ref="model_register_form"/>
        <field name="groups" eval="[Command.link(ref('kaz_procurement_doa_kuec.group_kuec_head_department'))]"/>
        <field name="domain_force">
            ['|', '|',
            ('name.user_id','=',user.id),
            ('employee_hod_id.user_id','=',user.id),
            ('employee_department_id.manager_id.user_id','=',user.id)
            ]
        </field>
    </record>

    <record id="rule_kuec_finance_and_above_see_all_register_form" model="ir.rule">
        <field name="name">KUEC: Finance/CCOE/CEO/Board can see all Resignation</field>
        <field name="model_id" ref="model_register_form"/>
        <field name="groups" eval="[
            Command.link(ref('kaz_procurement_doa_kuec.group_kuec_head_fin_procurement')),
            Command.link(ref('kaz_procurement_doa_kuec.group_kuec_ccoe')),
            Command.link(ref('kaz_procurement_doa_kuec.group_kuec_ceo')),
            Command.link(ref('kaz_procurement_doa_kuec.group_kuec_board'))
        ]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="group_kuec_employee_user_rule" model="ir.rule">
        <field name="name">Resignation User Rule</field>
        <field name="model_id" ref="model_register_form"/>
        <field name="groups"
           eval="[Command.link(ref('base.group_user'))]"/>
        <field name="domain_force">[('name.user_id', '=', user.id)]</field>
    </record>

    <record id="purchase_own_document_rule" model="ir.rule">
        <field name="name">Purchase Own Document Rule</field>
        <field name="model_id" ref="purchase.model_purchase_order"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
         <field name="groups"
                eval="[
                    Command.link(ref('kaz_kuec_overall_doa_approval.group_purchase_own_doc')),
                ]"
            />
    </record>

</odoo>