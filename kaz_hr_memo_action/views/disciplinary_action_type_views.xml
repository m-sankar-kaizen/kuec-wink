<odoo>
    <record id="view_hr_disciplinary_action_type_tree" model="ir.ui.view">
        <field name="name">hr.disciplinary.action.type.tree</field>
        <field name="model">hr.disciplinary.action.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="action_category_id"
                       options="{'no_open': True, 'no_create': True, 'no_create_edit':True}"/>
                <field name="description"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_hr_disciplinary_action_category_tree" model="ir.ui.view">
        <field name="name">hr.disciplinary.action.category.tree</field>
        <field name="model">hr.disciplinary.action.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="active" invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_hr_disciplinary_action_type" model="ir.actions.act_window">
        <field name="name">Disciplinary Action Types</field>
        <field name="res_model">hr.disciplinary.action.type</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p>Create a new one!</p>
        </field>
    </record>

    <record id="action_hr_disciplinary_action_category" model="ir.actions.act_window">
        <field name="name">Disciplinary Action Categories</field>
        <field name="res_model">hr.disciplinary.action.category</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p>Create a new one!</p>
        </field>
    </record>

    <menuitem id="menu_hr_disciplinary_action_type"
              name="Disciplinary Types"
              sequence="10"
              parent="hr.menu_human_resources_configuration"
              action="action_hr_disciplinary_action_type"/>

    <menuitem id="menu_hr_disciplinary_action_category"
              name="Disciplinary Category"
              sequence="11"
              parent="hr.menu_human_resources_configuration"
              action="action_hr_disciplinary_action_category"/>
</odoo>
