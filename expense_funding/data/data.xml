<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_petty_cash_request" model="ir.sequence">
        <field name="name">Petty Cash Request</field>
        <field name="code">petty.cash.request</field>
        <field name="prefix">PETTY/%(range_year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_credit_card_request" model="ir.sequence">
        <field name="name">Credit Card Request</field>
        <field name="code">credit.card.request</field>
        <field name="prefix">CRR/%(range_year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>