<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="housing_adv_settlement_structure_type"
            model="hr.payroll.structure.type">
        <field name="name">Housing Advance Closure</field>
        <field name="country_id" eval="False"/>
    </record>
    <record id="housing_adv_settlement_structure" model="hr.payroll.structure">
        <field name="name">Housing Advance Settlement Structure</field>
        <field name="rule_ids" eval="[]"/>
        <field name="type_id" ref="kaz_kuec_housing_loan_closing.housing_adv_settlement_structure_type"/>
    </record>
    <record id="housing_adv_settlement" model="hr.salary.rule">
        <field name="code">HOUSSET</field>
        <field name="name">Housing Advance Settlement</field>
        <field name="category_id" ref="hr_payroll.DED"/>
        <field name="condition_select">none</field>
        <field name="amount_select">code</field>
        <field name="amount_python_compute">result = -(payslip.housing_loan_closing_id.balance_amount)</field>
        <field name="appears_on_payslip" eval="False"/>
        <field name="sequence" eval="20"/>
        <field name="struct_id" ref="kaz_kuec_housing_loan_closing.housing_adv_settlement_structure"/>
    </record>
</odoo>