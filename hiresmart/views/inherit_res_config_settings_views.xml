<odoo>
    <data>

<!-- [Start] For adding configuration fields inside 'Recruitment' settings page ################################################################### -->
        <record id="res_config_settings_view_form_inherit_ocr_api_keys" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.hr.recruitment.ocr.api</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="priority" eval="76"/>
            <field name="arch" type="xml">
                <xpath expr="//app[@name='hr_recruitment']/block[@name='recruitment_in_app_purchases']" position="after">
                    <block title="OCR [Resume] and JD Generator" name="api_config_block">
                        <setting string="API Configuration" name="api_configuration" help="Select the AI provider and configure the API key to enable automatic resume parsing and job description/summary generation.">
                            <div class="content-group">
                                <div class="mt16">
                                    <label for="ai_provider" string="AI Provider *"/>
                                    <field name="ai_provider"  style="margin-left: 10px"/>
                                </div>
                                <div class="mt3">
                                    <label for="selected_api_key" string="API Key *"/>
                                    <field name="selected_api_key"  style="margin-left: 30px"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </xpath>
            </field>
        </record>
<!-- [End] For adding configuration fields inside 'Recruitment' settings page ################################################################### -->

    </data>
</odoo>