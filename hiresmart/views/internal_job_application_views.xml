<odoo>
    <data>

<!-- [Start] Form view #############################################################################################################-->
        <record id="view_internal_application_form" model="ir.ui.view">
            <field name="name">internal.job.application.form</field>
            <field name="model">internal.job.application</field>
            <field name="arch" type="xml">
                <form string="Internal Job Switch Request Application">
                <!-- [Start] Header section ############################################################################ -->
                    <header>
                        <button name="action_internal_job_application_approve" string="Approve"
                            type="object"
                            groups="hiresmart.group_recruitment_hr"
                            invisible="ijp_stage == 'approved'"
                        />
                        <button name="action_internal_job_application_reject" string="Reject"
                            type="object"
                            groups="hiresmart.group_recruitment_hr"
                            invisible="ijp_stage == 'rejected'"
                        />
                        <field name="ijp_stage" widget="statusbar" statusbar_visible="new,approved,rejected"/>
                    </header>
                <!-- [End] Header section ############################################################################ -->

                <!-- [Start] Body section ############################################################################ -->
                    <sheet>
                        <group>
                            <field name="job_id" readonly="0"/>
                            <field name="recruiter_id" readonly="0"/>
                        </group>

                        <group>
                            <separator string="Employee Details"/>
                            <group>
                                <field name="employee_id"/>
                                <field name="department_id"/>
                                <field name="job_position"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                                <field name="manager_id"/>
                                <field name="coach_id"/>
                            </group>
                            <group>
                                <field name="work_email"/>
                                <field name="work_phone"/>
                                <field name="address_id"/>
                                <field name="location"/>
                                <field name="working_hours"/>
                                <field name="timezone"/>
                            </group>
                        </group>
                        <group groups="hiresmart.group_recruitment_hr"
                            invisible="ijp_stage == 'rejected'">
                            <separator string="Rejection"/>
                            <field name="rejection_reason_ijp"/>
                        </group>
                        <group invisible="ijp_stage != 'rejected'">
                            <separator string="Rejection"/>
                            <field name="rejection_reason_ijp"/>
                        </group>
                    </sheet>
                    <chatter/>
                <!-- [End] Body section ############################################################################ -->
                </form>
            </field>
        </record>
<!-- [End] Form view #############################################################################################################-->


<!-- [Start] List view ########################################################################################################### -->
        <record id="view_internal_application_list" model="ir.ui.view">
            <field name="name">internal.job.application.list</field>
            <field name="model">internal.job.application</field>
            <field name="arch" type="xml">
                <list string="Internal Job Switch Request Application" expand="1">
                    <field name="employee_id"/>
                    <field name="work_email"/>
                    <field name="work_phone"/>
                    <field name="department_id"/>
                    <field name="job_position"/>
                </list>
            </field>
        </record>
<!-- [End] List view ########################################################################################################### -->


<!-- [Start] Action record ##################################################################################################### -->
        <record id="action_internal_applications_by_job" model="ir.actions.act_window">
            <field name="name">Internal Job Switch Request Applications</field>
            <field name="res_model">internal.job.application</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'group_by': 'ijp_stage'}</field>
        </record>
<!-- [End] Action record ##################################################################################################### -->

    </data>
</odoo>