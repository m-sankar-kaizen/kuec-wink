<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Inherit Employee Form View -->
    <record id="view_employee_form_secondment_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.secondment.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_secondments" type="object"
                        class="oe_stat_button" icon="fa-exchange"
                        invisible="secondment_count == 0">
                    <field name="secondment_count" widget="statinfo" string="Secondments"/>
                </button>
            </xpath>
            
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="has_active_secondment" invisible="1"/>
                <field name="active_secondment_id" 
                       invisible="has_active_secondment == False"
                       readonly="1"/>
            </xpath>
        </field>
    </record>
    
</odoo>
