<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Form View -->
    <record id="view_hr_employee_secondment_form" model="ir.ui.view">
        <field name="name">hr.employee.secondment.form</field>
        <field name="model">hr.employee.secondment</field>
        <field name="arch" type="xml">
            <form string="Employee Secondment">
                <header>
                    <button name="action_submit" string="Submit" type="object" 
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" 
                            class="oe_highlight"
                            invisible="state != 'submitted'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_reject" string="Reject" type="object" 
                            groups="hr.group_hr_manager"
                            invisible="state != 'submitted'"/>
                    <button name="action_activate" string="Activate" type="object" 
                            class="oe_highlight"
                            invisible="state != 'approved'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_extend" string="Extend" type="object" 
                            class="btn-primary"
                            invisible="state != 'active'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_complete" string="Complete" type="object" 
                            class="oe_highlight"
                            invisible="state != 'active'"
                            groups="hr.group_hr_manager"/>
                    <button name="action_cancel" string="Cancel"
                            invisible="state != 'draft'"
                            type="object"/>
                    <button name="action_set_to_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"
                            groups="hr.group_hr_manager"/>
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,submitted,approved,active,completed"/>
                </header>
                
                <sheet>
                    <widget name="web_ribbon"
                            title="Paid" color="text-bg-success" invisible="not is_paid"/>
                    <field name="is_paid" invisible="1"/>
                    <field name="payslip_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_payslip" type="object"
                                string="View Payslip"
                                invisible="not payslip_id"
                                class="oe_stat_button" icon="fa-edit">
                        </button>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_history" type="object" 
                                class="oe_stat_button" icon="fa-history">
                            <field name="history_count" widget="statinfo" string="History"/>
                        </button>
                        <button name="action_view_employee" type="object" 
                                class="oe_stat_button" icon="fa-user">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">View</span>
                                <span class="o_stat_text">Employee</span>
                            </div>
                        </button>
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Employee Information">
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="current_grade_id"/>
                            <field name="base_salary" widget="monetary"/>
                        </group>
                        
                        <group string="Secondment Details">
                            <field name="secondment_job_id"/>
                            <field name="secondment_department_id"/>
                            <field name="secondment_kuec_grade_id"/>
                            <field name="secondment_base_salary" widget="monetary"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Secondment Period">
                            <field name="date_start"/>
                            <field name="date_end"/>
                            <field name="duration_months" readonly="1"/>
                            <field name="applied_max_duration" readonly="1"/>
                        </group>
                        
                        <group string="Extension">
                            <field name="is_extended" readonly="1"/>
                            <field name="extension_date_end"/>
<!--                            <field name="extension_date_end" readonly="1"/>-->
                            <field name="total_duration_months" readonly="1"/>
                            <field name="effective_end_date" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group string="Allowance Configuration">
                            <field name="maintains_original_duties"/>
                            <field name="allowance_eligible" readonly="1" 
                                   widget="boolean_toggle"/>
                            <field name="applied_allowance_threshold" readonly="1"/>
                            <field name="applied_allowance_percentage" readonly="1" widget="percentage"/>
                        </group>
                        
                        <group string="Allowance Calculation">
                            <field name="allowance_amount" readonly="1" widget="monetary"/>
                            <field name="total_allowance" readonly="1" widget="monetary"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Duties &amp; Responsibilities">
                            <field name="duties" widget="html"/>
                        </page>
                        
                        <page string="Notes">
                            <field name="notes" placeholder="Additional notes or comments..."/>
                        </page>
                        
                        <page string="Rejection Details">
                            <group>
                                <field name="rejection_reason" nolabel="1" placeholder="Enter rejection reason..."/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                
                <chatter>
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </chatter>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="view_hr_employee_secondment_tree" model="ir.ui.view">
        <field name="name">hr.employee.secondment.tree</field>
        <field name="model">hr.employee.secondment</field>
        <field name="arch" type="xml">
            <list string="Employee Secondments"
                  decoration-info="state=='draft'"
                  decoration-warning="state=='submitted'"
                  decoration-success="state=='active'"
                  decoration-muted="state in ['completed','cancelled']"
                  decoration-danger="state=='rejected'">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="secondment_job_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="effective_end_date"/>
                <field name="duration_months"/>
                <field name="allowance_eligible" widget="boolean_toggle"/>
                <field name="allowance_amount" widget="monetary" optional="hide"/>
                <field name="total_allowance" widget="monetary" sum="Total Allowance"/>
                <field name="state" widget="badge" 
                       decoration-info="state=='draft'"
                       decoration-warning="state=='submitted'"
                       decoration-success="state in ['approved','active']"
                       decoration-muted="state in ['completed','cancelled']"
                       decoration-danger="state=='rejected'"/>
            </list>
        </field>
    </record>
    
    <!-- Kanban View -->
    <record id="view_hr_employee_secondment_kanban" model="ir.ui.view">
        <field name="name">hr.employee.secondment.kanban</field>
        <field name="model">hr.employee.secondment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="secondment_job_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="effective_end_date"/>
                <field name="state"/>
                <field name="allowance_eligible"/>
                <field name="total_allowance"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div class="o_kanban_tags_section">
                                    <field name="employee_id"/>
                                </div>
                                <ul>
                                    <li><strong>Position:</strong> <field name="secondment_job_id"/></li>
                                    <li><strong>Period:</strong> <field name="date_start"/> - <field name="effective_end_date"/></li>
                                    <li t-if="record.allowance_eligible.raw_value">
                                        <strong>Allowance:</strong> <field name="total_allowance" widget="monetary"/>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="view_hr_employee_secondment_search" model="ir.ui.view">
        <field name="name">hr.employee.secondment.search</field>
        <field name="model">hr.employee.secondment</field>
        <field name="arch" type="xml">
            <search string="Search Secondments">
                <field name="name" string="Reference"/>
                <field name="employee_id"/>
                <field name="department_id"/>
                <field name="secondment_job_id"/>
                <field name="secondment_department_id"/>
                
                <filter string="My Secondments" name="my_secondments"
                        domain="[('employee_id.user_id', '=', uid)]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Submitted" name="submitted" domain="[('state', '=', 'submitted')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <separator/>
                <filter string="To Approve" name="to_approve" 
                        domain="[('state', '=', 'submitted')]"
                        groups="hr.group_hr_manager"/>
                <filter string="Allowance Eligible" name="allowance_eligible"
                        domain="[('allowance_eligible', '=', True)]"/>
                <filter string="Extended" name="extended"
                        domain="[('is_extended', '=', True)]"/>
                <separator/>
                <filter string="Ending This Month" name="ending_this_month"
                        domain="[('effective_end_date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d')),
                                 ('effective_end_date', '&lt;=', ((context_today().replace(day=1) + relativedelta(months=1)) - relativedelta(days=1)).strftime('%Y-%m-%d')),
                                 ('state', '=', 'active')]"/>
                <filter string="Ending Next Month" name="ending_next_month"
                        domain="[('effective_end_date', '&gt;=', ((context_today().replace(day=1)) + relativedelta(months=1)).strftime('%Y-%m-%d')),
                                 ('effective_end_date', '&lt;=', ((context_today().replace(day=1) + relativedelta(months=2)) - relativedelta(days=1)).strftime('%Y-%m-%d')),
                                 ('state', '=', 'active')]"/>
                
                <group expand="0" string="Group By">
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Current Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Secondment Department" name="group_secondment_dept" context="{'group_by': 'secondment_department_id'}"/>
                    <filter string="Secondment Position" name="group_position" context="{'group_by': 'secondment_job_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Start Date" name="group_start_date" context="{'group_by': 'date_start'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_hr_employee_secondment" model="ir.actions.act_window">
        <field name="name">Secondments</field>
        <field name="res_model">hr.employee.secondment</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{}</field>
        <field name="search_view_id" ref="view_hr_employee_secondment_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Secondment Request
            </p>
            <p>
                Manage temporary assignments of employees to higher-grade or vacant positions.
                Track secondment periods, allowances, and performance reviews.
            </p>
        </field>
    </record>
    
</odoo>
