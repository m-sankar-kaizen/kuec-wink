<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_payslip_form_inherit_view" model="ir.ui.view">
        <field name="name">hr.payslip.inherit.form.inherit.kuec.grades</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='account_info']//field[@name='company_id']" position="after">
                <field name="secondment_amount" readonly="1"/>
                <field name="secondment_ids" readonly="1" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>