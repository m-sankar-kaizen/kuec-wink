<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!--
    Tree View for Model: visa.request

    Purpose:
    Displays a list view of all visa requests showing basic fields such as:
    - ref: The autogenerated reference number.
    - name: The applicant's name (typically the employee).

    Usage:
    Used in the main menu action to give a quick overview of visa request records.
    -->
    <record id="visa_request_tree_view" model="ir.ui.view">
        <field name="name">visa request list</field>
        <field name="model">visa.request</field>
        <field name="arch" type="xml">
            <list>
                <field name="ref"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!--
    Form View for Model: visa.request

    Purpose:
    Presents a full editable interface for submitting, tracking, and managing visa request forms
    through multiple approval stages (HR team → HR manager → Final Approval).

    Header:
    Contains workflow buttons that control the state transition of the record.
    Buttons appear conditionally based on state and user group.

    Sheet:
    Organized into logical sections:
    - General request data
    - Marital details and family information
    - Personal identity and demographic details
    - Additional details such as passport, nationality, education, and attachments

    Chatter:
    Includes messaging and activity tracking to enable audit trail and collaboration.
    -->
    <record id="visa_request_form_view" model="ir.ui.view">
        <field name="name">visa request form</field>
        <field name="model">visa.request</field>
        <field name="arch" type="xml">
            <form>
                <!-- ==== Workflow Buttons ==== -->
                <header>
                    <!-- Send to HR Team: Visible only in 'draft' state -->
                    <button name="action_send_for_hr_approval" type="object" string="Send To HR Team"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>

                    <!-- Send to HR Manager: Visible in 'hr_approve' state and only for HR team group -->
                    <button name="action_send_for_hr_manager_approval" type="object" string="Send To HR Manager"
                            invisible="state != 'hr_approve'"
                            groups="kaz_employee_reports.group_hr_team_visa_request"
                            class="oe_highlight"/>

                    <!-- Approve: Final approval, only visible in 'hr_manager' state for HR manager group -->
                    <button name="action_approve" type="object" string="Approve"
                            invisible="state != 'hr_manager'"
                            class="oe_highlight"
                            groups="kaz_employee_reports.group_hr_manager_visa_request"/>

                    <!-- Cancel: Can only cancel in draft state -->
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state != 'draft'"/>

                    <!-- Reject: HR team or manager can reject depending on current state -->
                    <button name="action_reject" type="object" string="Reject"
                            groups="kaz_employee_reports.group_hr_team_visa_request"
                            invisible="state != 'hr_approve'"/>
                    <button name="action_reject" type="object" string="Reject"
                            groups="kaz_employee_reports.group_hr_manager_visa_request"
                            invisible="state != 'hr_manager'"/>

                    <!-- Visual status indicator (statusbar widget) -->
                    <field name="state" widget="statusbar" nolabel="1"/>
                </header>

                <!-- ==== Main Form Body ==== -->
                <sheet>
                    <!-- Title Section -->
                    <div class="oe_title">
                        <h1>
                            <field name="ref"/>
                        </h1>
                    </div>

                    <!-- === General Request Info === -->
                    <group>
                        <group>
                            <!-- Creation date (readonly) -->
                            <field name="date" readonly="1"/>

                            <!-- Employee name (editable for HR, readonly for user) -->
                            <field name="name"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   readonly="state != 'draft'"/>
                            <field name="name"
                                   groups="base.group_user,!kaz_employee_reports.group_hr_team_visa_request,!kaz_employee_reports.group_hr_manager_visa_request"
                                   readonly="1"/>

                            <!-- Employee ID and Company -->
                            <field name="emp_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <!-- Request Details -->
                            <field name="type_of_request" required="1" readonly="state != 'draft'"/>
                            <field name="type_of_action" required="1" readonly="state != 'draft'"/>
                            <field name="marital_status"/>

                            <!-- Spouse & Children: Shown only when applicable -->
                            <field name="spouse_complete_name"
                                   invisible="marital_status not in ['married', 'cohabitant']"/>
                            <field name="spouse_employee_id"
                                   invisible="marital_status not in ['married', 'cohabitant']"/>
                            <field name="children" invisible="marital_status in ['single', False]"/>
                        </group>
                    </group>

                    <!-- === Personal Identity Section === -->
                    <group string="personal information">
                        <group>
                            <field name="full_name" required="1" readonly="state != 'draft'"/>
                            <field name="father_name" required="1" readonly="state != 'draft'"/>
                            <field name="mother_name" required="1" readonly="state != 'draft'"/>
                            <field name="position" required="1" readonly="state != 'draft'"/>
                            <field name="religion" required="1" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="sect" required="1" readonly="state != 'draft'"/>
                            <field name="country_num" required="1" readonly="state != 'draft'"/>
                            <field name="uae_num" required="1" readonly="state != 'draft'"/>
                            <field name="personal_email" required="1" readonly="state != 'draft'"/>
                            <field name="po_box" required="1" readonly="state != 'draft'"/>
                        </group>
                    </group>

                    <!-- === Additional Identity & Education Info === -->
                    <group string="additional information">
                        <group>
                            <field name="nationality" required="1" readonly="state != 'draft'"/>
                            <field name="passport_num" required="1" readonly="state != 'draft'"/>
                            <field name="passport_country" required="1"
                                   readonly="state != 'draft'"/>
                            <field name="passport_expired_date" required="1"
                                   readonly="state != 'draft'"/>
                            <field name="major" required="1" readonly="state != 'draft'"/>
                            <field name="check" required="1" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="country_live_in" required="1" readonly="state != 'draft'"/>
                            <field name="country_of_birth" required="1"
                                   readonly="state != 'draft'"/>
                            <field name="place_of_birth" required="1" readonly="state != 'draft'"/>
                            <field name="education_qualify" required="1"
                                   readonly="state != 'draft'"/>
                            <field name="comment" required="1" readonly="state != 'draft'"/>
                            <field name="attach" required="1" readonly="state != 'draft'"/>
                        </group>
                    </group>
                </sheet>

                <!-- === Chatter (mail.thread) === -->
                <chatter/>
            </form>
        </field>
    </record>

    <!--
    Window Action: action_ank_visa_request

    Purpose:
    Defines an action that opens the visa.request list/form view for users.

    Entry Point:
    Triggered via the menu item below.
    -->
    <record id="action_ank_visa_request" model="ir.actions.act_window">
        <field name="name">Visa Request</field>
        <field name="res_model">visa.request</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new visa request
            </p>
        </field>
    </record>

    <!--
    Menuitem: visa_request_menu

    Purpose:
    Adds a menu entry under HR Housing Advance section to access Visa Request form.

    Navigation:
    ent_ohrms_loan > Housing Advance > Visa Request
    -->
    <menuitem id="visa_request_menu" name="Visa Request"
              parent="ent_ohrms_loan.menu_hr_housing_advance"
              action="action_ank_visa_request"/>
</odoo>
