<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!--
    Tree View Definition: salary_letter_tree_view
    Model: salary.letter

    Purpose:
        - Displays a list of salary letters with minimal fields
        - Useful for HR to quickly access letter records

    Fields:
        - date: Date of request/letter
        - name: Employee
        - address_type: Type of address (e.g., personal, entity)
    -->
    <record id="salary_letter_tree_view" model="ir.ui.view">
        <field name="name">salary letter list</field>
        <field name="model">salary.letter</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="name"/>
                <field name="address_type"/>
            </list>
        </field>
    </record>

    <!--
    Form View Definition: salary_letter_form_view
    Model: salary.letter

    Purpose:
        - Capture all necessary details for generating a salary letter
        - Controls readonly behavior and visibility based on user group & address_type

    Key Features:
        - `address_type` controls visibility of `letter_id` field
        - `name` field editable only for users in 'letter_manager' group
        - Readonly fields enforced for users outside the manager group
        - Includes monetary widgets and salary-related fields
    -->
    <record id="salary_letter_form_view" model="ir.ui.view">
        <field name="name">salary letter form</field>
        <field name="model">salary.letter</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>

                            <!-- General Information -->
                            <field name="date" readonly="1"/>
                            <field name="address_type"/>

                            <!-- Entity-related letter template (visible only when address_type is 'entity') -->
                            <field name="letter_id"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                   invisible="address_type != 'entity'" required="address_type == 'entity'"/>

                            <!-- Employee field (editable only by manager group) -->
                            <field name="name"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                   groups="kaz_employee_reports.group_letter_manager"/>

                            <!-- Readonly for non-managers -->
                            <field name="name"
                                   groups="base.group_user,!kaz_employee_reports.group_letter_manager"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"
                                   readonly="1"/>

                            <!-- Employee Details -->
                            <field name="employee_no"/>
                            <field name="job_title"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="join_date"/>
                            <field name="nationality"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>
                            <field name="id_no"/>

                            <!-- Hidden Currency used for gross salary -->
                            <field name="currency_id" invisible="1"/>

                            <!-- Salary Details -->
                            <field name="total_deduction"/>
                            <field name="gross_salary" widget="monetary" force_save="1"/>

                            <!-- Company reference -->
                            <field name="company_id"
                                   options="{'no_create': True, 'no_create_edit': True, 'no_open': True}"/>

                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!--
    Action Definition: action_ank_salary_letters
    Purpose:
        - Adds the Salary Letter window action
        - Allows access to both list and form views
    -->
    <record id="action_ank_salary_letters" model="ir.actions.act_window">
        <field name="name">Salary Letter</field>
        <field name="res_model">salary.letter</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new salary Letter
            </p>
        </field>
    </record>

    <!--
    Menu Item: salary_letter_menu
    Purpose:
        - Adds Salary Letter option under the Ank Letters menu
    -->
    <menuitem id="salary_letter_menu"
              name="Salary Letter"
              parent="kaz_employee_reports.ankbot_letter_menu"
              action="action_ank_salary_letters"/>

</odoo>
