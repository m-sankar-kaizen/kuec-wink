                                <div class="col-5">
                                    <strong>Gross Salary :</strong>
                                    <span t-field="o.gross_salary"/>
                                </div>
                                <div class="col-5" style="text-align : right;">
                                    <span t-field="o.gross_salary"/>
                                    <strong>: إجمالي الراتب</strong>
                                </div>
                                <div class="col-1"/>
                            </div>

                            <div class="row mt-1" t-if="o.sudo().name.kaz_employee_type == 'local'">
                                <div class="col-1"/>
                                <div class="col-5">
                                    <strong>Deductions :</strong>
                                    <span t-field="o.total_deduction"/>
                                </div>
                                <div class="col-5" style="text-align : right;">
                                    <span t-field="o.total_deduction"/>
                                    <strong>: الاستقطاعات</strong>
                                </div>
                                <div class="col-1"/>
                            </div>

                            <div class="row mt-1" t-if="o.sudo().name.kaz_employee_type == 'local'">
                                <div class="col-1"/>
                                <div class="col-5">
                                    <strong>Net Monthly Salary: :</strong>
                                    <t t-esc="o.gross_salary - o.total_deduction"/>
                                </div>
                                <div class="col-5" style="text-align : right;">
                                    <t t-esc="o.gross_salary - o.total_deduction"/>
                                    <strong>: الراتب الشهري الصافي</strong>
                                </div>
                                <div class="col-1"/>
                            </div>

                            <div class="row mt-1" t-if="o.sudo().name.kaz_employee_type == 'expat'">
                                <div class="col-1"/>
                                <div class="col-5">
                                    <strong>Total Monthly Salary:</strong>
                                    <span t-field="o.gross_salary"/>
                                </div>
                                <div class="col-5" style="text-align: right; direction: rtl;">
                                    <strong>إجمالي الراتب الشهري :</strong>
                                    <span t-field="o.gross_salary"/>
                                </div>
                                <div class="col-1"/>
                            </div>
                            <div class="row mt-2">
                                <div class="col-2"/>
                                <div class="col-4">
                                    <strong>
                                        Yours sincerely,
                                    </strong>
                                </div>
                                <div class="col-4" style="text-align : right;">
                                    ,وتقبلوا فائق الاحترام والتقدير
                                </div>
                                <div class="col-2"/>
                            </div>
                            <div class="row mt-2">
                                <div class="text-center">
                                    <div>
                                        <img t-if="o.sudo().company_id.signature" style="max-width: 150px;"
                                             t-att-src="image_data_uri(o.sudo().company_id.signature)" alt="Signature"/>
                                    </div>
                                    <div class="mt-1">
                                        <strong>
                                            <t t-esc="o.sudo().company_id.employee_arabic_name"/>
                                            <br/>
                                            <t t-esc="o.sudo().company_id.employee_id.name"/>
                                            <br/>
                                            <t t-esc="o.sudo().company_id.employee_arabic_job_position"/>
                                            <br/>
                                            <t t-esc="o.sudo().company_id.job_id.name"/>
                                            <br/>
                                        </strong>
                                    </div>
                                    <div class="mt-1">
                                        <img t-if="o.company_id.stamp" style="max-width: 150px;"
                                             t-att-src="image_data_uri(o.sudo().company_id.stamp)" alt="Stamp"/>
                                    </div>
                                </div>
                            </div>
                            <div class="row mt-2">
                                <div class="col-1"/>
                                <div class="col-5" style="font-size: 12px;">
                                    <ul>
                                        <li>This letter is valid for 30 days from the date of issuance.</li>
                                        <li>This Letter has been issued upon the employee’s request without any
                                            obligation to<t t-esc="o.sudo().company_id.company_name"/>.
                                        </li>
                                        <li>Any modification or alteration will invalidate this letter.</li>
                                    </ul>
                                </div>
                                <div class="col-5 mr-2" style="font-size: 12px;">
                                    <ul style="direction:rtl;">
                                        <li style="direction:rtl;">
                                            <span style="text-align: right; margin-bottom: 0px;">
                                                هذه الرسالة صالحة لمدة 30 يوما من تاريخ الإصدار
                                            </span>
                                        </li>
                                        <li style="direction:rtl;">
                                            <span style="text-align: right; margin-bottom: 0px;">
                                                أصدرت هذه الرسالة بناء على طلب الموظف دون أن تتحمل
                                                <t t-esc="o.sudo().company_id.company_name_arabic"/>
                                                أية مسؤولية تجاه الغير
                                            </span>
                                        </li>
                                        <li style="direction:rtl;">
                                            <span style="text-align : right; margin-bottom: 0px;">
                                                أي تعديل أو تغيير في هذه الرسالة تعتبرها لاغية
                                            </span>
                                        </li>
                                    </ul>
                                </div>
                                <div class="col-1"/>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!--     Salary Certificate-->
    <!--
        Report Action: Salary Certificate (UAE Expat)
        This action defines a QWeb PDF report for the `salary.letter` model,
        which generates a formal salary certificate, typically requested for visa, banking, or housing purposes.

        - `report_name` and `report_file` reference the QWeb template defined above
        - The generated file will be named: "Salary Certificate - <employee_name>.pdf"
    -->
    <record id="action_report_salary_letter_uae_xpat_report" model="ir.actions.report">
        <field name="name">Salary Letter</field>
        <field name="model">salary.letter</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">kaz_employee_reports.salary_letter_uae_xpat_report</field>
        <field name="report_file">kaz_employee_reports.salary_letter_uae_xpat_report</field>
        <field name="print_report_name">'Salary Letter - %s - %s' % (object.name.name, object.date)</field>
        <field name="binding_model_id" ref="model_salary_letter"/>
        <field name="binding_type">report</field>
    </record>

    <!--    Detailed Salary Certificate-->

    <!--
       Report Action: Detailed Salary Certificate
       This action defines a QWeb PDF report for the `salary.letter` model,
       which generates a formal salary certificate, typically requested for visa, banking, or housing purposes.

