<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="category_material_purchase_requisition" model="ir.module.category">
        <field name="name">ANK/KUEC Material Purchase Requisition</field>
        <field name="description">Access rights for Material Purchase Requisition workflow</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_purchase_requisition_admin" model="res.groups">
        <field name="name">Admin (KUEC)</field>
        <field name="category_id" ref="category_material_purchase_requisition"/>
        <field name="implied_ids"
               eval="[
                    Command.link(ref('material_purchase_requisitions.group_purchase_requisition_manager')),
               ]"/>
    </record>

    <function model="res.groups" name="write">
        <value eval="[
        ref('material_purchase_requisitions.group_purchase_requisition_user')
    ]"/>
        <value eval="{
        'category_id': ref('kaz_procurement_doa_kuec.category_material_purchase_requisition'),
        'name': 'User: Own Documents Only',
    }"/>
    </function>

    <!-- Assign category to Material Purchase Requisition Manager -->
    <function model="res.groups" name="write">
        <value eval="[
        ref('material_purchase_requisitions.group_purchase_requisition_manager')
    ]"/>
        <value eval="{
        'category_id': ref('kaz_procurement_doa_kuec.category_material_purchase_requisition'),
        'name': 'Manager: All Documents',
    }"/>
    </function>

    <!-- Assign category to Material Purchase Requisition Department Manager -->
    <function model="res.groups" name="write">
        <value eval="[
        ref('material_purchase_requisitions.group_purchase_requisition_department')
    ]"/>
        <value eval="{
        'category_id': ref('kaz_procurement_doa_kuec.category_material_purchase_requisition'),
        'name': 'Department Head: Own &amp; Team Documents',
        'implied_ids': [Command.link(ref('material_purchase_requisitions.group_purchase_requisition_user'))]
    }"/>
    </function>

    <function model="ir.rule" name="write">
        <value eval="[
        ref('material_purchase_requisitions.purchase_requisition_own_rule')
    ]"/>
        <value eval="{
        'groups': [
            Command.clear(),
            Command.link(ref('material_purchase_requisitions.group_purchase_requisition_user'))
        ]
    }"/>
    </function>

    <function model="ir.rule" name="write">
        <value eval="[
        ref('material_purchase_requisitions.purchase_requisition_line_employee_rule')
    ]"/>
        <value eval="{
        'groups': [
            Command.clear(),
            Command.link(ref('material_purchase_requisitions.group_purchase_requisition_user'))
        ]
    }"/>
    </function>

    <function model="ir.rule" name="write">
        <value eval="[
        ref('material_purchase_requisitions.purchase_requisition_all_rule')
    ]"/>
        <value eval="{
        'groups': [
            Command.clear(),
            Command.link(ref('material_purchase_requisitions.group_purchase_requisition_manager')),
            Command.link(ref('kaz_procurement_doa_kuec.group_purchase_requisition_admin')),
        ]
    }"/>
    </function>

    <function model="ir.rule" name="write">
        <value eval="[
        ref('material_purchase_requisitions.purchase_requisition_line_all_rule')
    ]"/>
        <value eval="{
        'groups': [
            Command.clear(),
            Command.link(ref('material_purchase_requisitions.group_purchase_requisition_manager')),
            Command.link(ref('kaz_procurement_doa_kuec.group_purchase_requisition_admin')),
        ]
    }"/>
    </function>

    <record id="purchase_requisition_dept_rule" model="ir.rule">
        <field name="name">Employee Material Purchase Requisition - Department</field>
        <field name="model_id" ref="model_material_purchase_requisition"/>
        <field name="domain_force">[
            '|',
            ('employee_id.user_id', '=', user.id),
            ('employee_hod_id.user_id', '=', user.id),
            ]
        </field>
        <field name="groups" eval="[
            Command.link(ref('material_purchase_requisitions.group_purchase_requisition_department')),
        ]"/>
    </record>

    <record id="purchase_requisition_line_dept_rule" model="ir.rule">
        <field name="name">Employee Material Purchase Requisition Line - Department</field>
        <field name="model_id" ref="model_material_purchase_requisition_line"/>
        <field name="domain_force">[
            '|',
            ('requisition_id.employee_id.user_id', '=', user.id),
            ('requisition_id.employee_hod_id.user_id', '=', user.id),
            ]
        </field>
        <field name="groups" eval="[
            Command.link(ref('material_purchase_requisitions.group_purchase_requisition_department')),
        ]"/>
    </record>
</odoo>