<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="purchase_contract_agreement_form" model="ir.ui.view">
        <field name="name">purchase.contract.agreement.form</field>
        <field name="model">purchase.contract.agreement</field>
        <field name="inherit_id" ref="kaz_vendor_management.purchase_contract_agreement_form"/>
        <field name="arch" type="xml">

            <field name="state" position="before">
                <field name="kuec_approval_state" widget="statusbar" statusbar_visible="draft,approved"/>
            </field>

            <form position="attributes">
                <attribute name="js_class">readonly_form_view</attribute>
            </form>

            <button name="action_approve" position="attributes">
                <attribute name="invisible" add="kuec_approval_state != 'approved'" separator="or"/>
            </button>
            <button name="action_reject" position="attributes">
                <attribute name="invisible" add="kuec_approval_state != 'approved'" separator="or"/>
            </button>

            <button name="submit_to_approve" position="after">
                <field name="company_code" invisible="1"/>
                <field name="is_readonly" invisible="1"/>
                <button name="action_unlock_record" icon="fa-unlock" string="Unlock" type="object"
                        groups="kaz_procurement_doa_kuec.group_kuec_head_department,kaz_procurement_doa_kuec.group_kuec_ceo,kaz_procurement_doa_kuec.group_kuec_board"
                        invisible="not is_readonly or kuec_approval_state != 'board_approval' or company_code not in ['KUEC']"/>
                <button name="action_lock_record" icon="fa-lock" string="Lock" type="object"
                        invisible="is_readonly or kuec_approval_state != 'board_approval' or company_code not in ['KUEC']"/>

                <button name="action_hod_approval"
                        invisible="kuec_approval_state != 'department_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_head_department"
                        class="btn btn-primary" string="HOD Approve" type="object"/>
                <button name="action_hod_reject"
                        invisible="kuec_approval_state != 'department_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_head_department"
                        class="btn btn-danger" string="Reject" type="object"/>
                <button name="action_hod_rfc"
                        invisible="kuec_approval_state != 'department_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_head_department"
                        class="btn" string="Return for Correction" type="object"/>

                <button name="action_head_fin_approval"
                        invisible="kuec_approval_state != 'finance_procurement_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_head_fin_procurement"
                        class="btn btn-primary" string="Head of Finance &amp; Procurement Approve" type="object"/>
                <button name="action_reject_request"
                        invisible="kuec_approval_state != 'finance_procurement_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_head_fin_procurement"
                        class="btn btn-danger" string="Reject" type="object"/>
                <button name="action_rfc_request"
                        invisible="kuec_approval_state != 'finance_procurement_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_head_fin_procurement"
                        class="btn" string="Return for Correction" type="object"/>

                <button name="action_ccoe_approval"
                        invisible="kuec_approval_state != 'ccoe_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_ccoe"
                        class="btn btn-primary" string="CCOE Approve" type="object"/>
                <button name="action_reject_request"
                        invisible="kuec_approval_state != 'ccoe_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_ccoe"
                        class="btn btn-danger" string="Reject" type="object"/>
                <button name="action_rfc_request"
                        invisible="kuec_approval_state != 'ccoe_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_ccoe"
                        class="btn" string="Return for Correction" type="object"/>

                <button name="action_ceo_approval"
                        string="CEO Approve" type="object" class="oe_highlight"
                        groups="kaz_procurement_doa_kuec.group_kuec_ceo"
                        invisible="kuec_approval_state != 'ceo_approval'"/>
                <button name="action_reject_request"
                        invisible="kuec_approval_state != 'ceo_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_ceo"
                        class="btn btn-danger" string="Reject" type="object"/>
                <button name="action_rfc_request"
                        invisible="kuec_approval_state != 'ceo_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_ceo"
                        class="btn" string="Return for Correction" type="object"/>

                <button name="action_board_approval"
                        invisible="kuec_approval_state != 'board_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_board"
                        class="btn btn-primary" string="Board Approve" type="object"/>
                <button name="action_reject_request"
                        invisible="kuec_approval_state != 'board_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_board"
                        class="btn btn-danger" string="Reject" type="object"/>
                <button name="action_rfc_request"
                        invisible="kuec_approval_state != 'board_approval'"
                        groups="kaz_procurement_doa_kuec.group_kuec_board"
                        class="btn" string="Return for Correction" type="object"/>
            </button>

            <page name="contract_attachment" position="after">
                <page name="purchase_contract_approval" string="Signed Approval History"
                      invisible="not purchase_contract_approval_ids or company_code not in ['KUEC']">
                    <field name="purchase_contract_approval_ids">
                        <list editable="bottom" create="0" edit="0" delete="0">
                            <field name="current_display_name" column_invisible="1"/>
                            <field name="sequence"/>
                            <field name="parent_state_at_request" optional="show"/>
                            <field name="request_type"/>
                            <field name="create_uid" string="Signed By"/>
                            <field name="create_date" string="Signed At" optional="hide"/>
                            <field name="signature" widget="signature"
                                   options="{'full_name': 'current_display_name','size': [150, 50]}"/>
                            <field name="reason"/>
                            <field name="company_id" optional="hide"/>
                        </list>
                    </field>
                </page>
                <page name="kuec_board_attachment" string="KUEC Board Approval Attachment"
                      invisible="hide_board_approval_attachment">
                    <field name="hide_board_approval_attachment" invisible="1"/>
                    <group>
                        <group>
                            <field name="kuec_board_attachment"
                                   readonly="kuec_approval_state != 'board_approval'"
                                   widget="binary"/>
                        </group>
                    </group>
                </page>
            </page>

        </field>
    </record>

</odoo>