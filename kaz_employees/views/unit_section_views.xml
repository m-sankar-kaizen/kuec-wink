<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- ============================================================================
         Tree View Definition: employee.unit
         Purpose   : Allows direct editing of Employee Units in list view mode.
         Model     : employee.unit
         Editable  : bottom (inline creation and editing enabled at the bottom)
         Field(s)  : name – Name of the employee unit
    ============================================================================== -->
    <record id="employee_unit_view_tree" model="ir.ui.view">
        <field name="name">employee.unit.view.list</field>
        <field name="model">employee.unit</field>
        <field name="arch" type="xml">
            <list string="Employee Unit" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- ============================================================================
         Tree View Definition: employee.section
         Purpose   : Allows direct editing of Employee Sections in list view mode.
         Model     : employee.section
         Editable  : bottom (inline creation and editing enabled at the bottom)
         Field(s)  : name – Name of the employee section
    ============================================================================== -->
    <record id="employee_section_view_tree" model="ir.ui.view">
        <field name="name">employee.section.view.list</field>
        <field name="model">employee.section</field>
        <field name="arch" type="xml">
            <list string="Employee Section" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- ============================================================================
         Action Window: Employee Unit
         Purpose   : Enables user access to the Employee Unit list view
         View Mode : list only (no form view needed for simple entries)
    ============================================================================== -->
    <record id="action_employee_unit" model="ir.actions.act_window">
        <field name="name">Employee Unit</field>
        <field name="res_model">employee.unit</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ============================================================================
         Action Window: Employee Section
         Purpose   : Enables user access to the Employee Section list view
         View Mode : list only (no form view needed for simple entries)
    ============================================================================== -->
    <record id="action_employee_section" model="ir.actions.act_window">
        <field name="name">Employee Section</field>
        <field name="res_model">employee.section</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ============================================================================
         Menu Item: Employee Unit
         Parent Menu : HR Settings (menu_human_resources_configuration)
         Purpose     : Makes Employee Units accessible through the HR config menu
         Action      : Opens the list view of employee.unit model
    ============================================================================== -->
    <menuitem id="employee_unit_menu"
              name="Employee Unit"
              parent="hr.menu_human_resources_configuration"
              action="action_employee_unit"/>

    <!-- ============================================================================
         Menu Item: Employee Section
         Parent Menu : HR Settings (menu_human_resources_configuration)
         Purpose     : Makes Employee Sections accessible through the HR config menu
         Action      : Opens the list view of employee.section model
    ============================================================================== -->
    <menuitem id="employee_section_menu"
              name="Employee Section"
              parent="hr.menu_human_resources_configuration"
              action="action_employee_section"/>

</odoo>
