<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="0">
        <!--
        Email Template: Grade Review Notification

        This email template is used to notify the responsible user when a grade review is required
        (e.g. when grades are older than 3 years). It is sent programmatically (e.g. from a cron or server action).

        Key Fields:
        - name: Internal name for the email template.
        - model_id: The model this email template is tied to (here, `hr.grade`).
        - partner_to: Dynamically targets the partner (recipient) using the `responsible_user_id`.
        - subject: Email subject line.
        - description: Describes the purpose of this email template.
        - body_html: HTML content of the email. Uses QWeb templating (e.g., `t-if`, `t-esc`, `ctx.get(...)`).
    -->
    <record id="email_template_grade_review" model="mail.template">
        <field name="name">Grade: Review</field>
        <field name="model_id" ref="kaz_employees.model_hr_grade"/>
        <field name="partner_to">{{ object.responsible_user_id.partner_id.id }}</field>
        <field name="subject">Grades to Renew</field>
        <field name="description">Notify responsible users about grades past 3 years</field>
        <field name="body_html" type="html">
<div style="margin: 0px; padding: 0px;">
    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Dear
        <t t-if="object.responsible_user_id.partner_id.name">
            <t t-esc="object.responsible_user_id.partner_id.name"/>,
        </t>
        <br/>
        Hope you are doing well.<br/><br/>
        Here are the grades to review
        <strong t-out="object.name"/>.
        <br/>

        <t t-if="ctx.get('link')">
            Click on the button to go to the record:
            <br/>
            <br/>
            <br/>
            <div style="display: flex; justify-content: center;">
                <a t-att-href="ctx.get('link')"
                        type="button"
                        class="btn btn-primary"
                        style="background: #3a93af; font-size: 12px; color: #FFFFFF; display: block; padding: 8px 12px 11px; text-decoration: none !important; font-weight: 400;">
                    Go to Record
                </a>
            </div>
        </t>
    </p>
</div>
        </field>
    </record>
</odoo>